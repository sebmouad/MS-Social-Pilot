{
  "name": "ms-social-pilot",
  "version": "1.0.0",
  "private": true,
  "description": "Schedule and publish Facebook Page and Group posts via the Graph API.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --port ${DEV_PORT:-3000}",
    "dev:worker": "node --env-file-if-exists=.env --import tsx --watch scripts/worker.ts",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "deploy": "scripts/deploy/deploy.sh",
    "deploy:rollback": "scripts/deploy/deploy.sh --rollback",
    "deploy:status": "scripts/deploy/deploy.sh --status",
    "worker": "node --env-file-if-exists=.env --import tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "db:demo": "node --env-file-if-exists=.env --import tsx prisma/demo.ts",
    "postinstall": "prisma generate",
    "screenshots": "playwright test screenshots.spec.ts --project=chromium"
  },
  "prisma": {
    "schema": "rebuild/prisma/legacy-schema.prisma",
    "seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "next": "15.5.23",
    "next-intl": "^3.26.3",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.0.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "jsdom": "^26.1.0",
    "playwright": "1.64.0",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20.11"
  }
}
