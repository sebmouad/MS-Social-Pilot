+.ui-state__icon { width: 48px; height: 48px; border-radius: 14px; background: var(--mod-soft, var(--accent-soft)); color: var(--mod, var(--accent)); }
+.ui-state--error { border-color: color-mix(in srgb, var(--danger) 35%, var(--line)); }
+
+/* Tables: sentence-case headers on a tinted bar, comfortable rows, quiet dividers. */
