+
+/* ======================================================================
+ * Design pass 2026-10-21 (round 4): one calmer, richer card system.
+ * Hierarchy: canvas < card (hairline + soft lift) < raised/hover. Module color
+ * appears as a solid icon chip and a thin accent, never as a wash. Tokens only.
+ * ====================================================================== */
+:root { --radius-lg: 16px; --radius-md: 12px; --card-lift: 0 1px 2px rgb(20 24 40 / 5%), 0 10px 28px -14px rgb(20 24 40 / 16%); --card-lift-hover: 0 1px 2px rgb(20 24 40 / 6%), 0 16px 34px -14px rgb(20 24 40 / 24%); }
+:root[data-mode="dark"] { --card-lift: 0 1px 0 rgb(255 255 255 / 4%) inset, 0 10px 28px -14px rgb(0 0 0 / 60%); --card-lift-hover: 0 1px 0 rgb(255 255 255 / 6%) inset, 0 16px 34px -14px rgb(0 0 0 / 70%); }
+@media (prefers-color-scheme: dark) { :root[data-mode="system"] { --card-lift: 0 1px 0 rgb(255 255 255 / 4%) inset, 0 10px 28px -14px rgb(0 0 0 / 60%); --card-lift-hover: 0 1px 0 rgb(255 255 255 / 6%) inset, 0 16px 34px -14px rgb(0 0 0 / 70%); } }
+:root[data-theme] { --shadow-raised: var(--card-lift); }
+
+/* Type scale: 12 / 13 / 14 body, 16 card title, 29 page title. Tighter display tracking. */
+body { font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
+.shell-content { padding: 28px 36px 56px; max-width: 1480px; }
+.ui-page-header { margin-bottom: 26px; }
+.ui-page-header h1, .ui-page-header h2 { font-size: clamp(22px, 2.6vw, 29px); font-weight: 780; letter-spacing: -.028em; }
+.ui-page-header p { margin-top: 5px; font-size: 14px; color: var(--ink-soft); }
+.ui-page-header__chip { width: 48px; height: 48px; border-radius: 14px; background: var(--mod, var(--accent)); color: #fff; box-shadow: 0 6px 14px -6px color-mix(in srgb, var(--mod, var(--accent)) 70%, transparent); }
+:root[data-mode="dark"] .ui-page-header__chip { color: var(--canvas); }
+:root[data-theme="clean"] .ui-page-header__chip { background: var(--mod-soft, var(--surface-muted)); color: var(--mod, var(--ink)); box-shadow: none; }
+
+/* Top bar: quiet breadcrumb on the canvas; the page title lives in the page, not twice. */
+.shell-topbar { min-height: 60px; background: color-mix(in srgb, var(--canvas) 92%, var(--surface)); border-bottom: 1px solid var(--line-subtle); padding-inline: 36px; }
+.shell-topbar__user { display: none; }
+.shell-topbar__crumb { font-size: 13px; }
+.shell-topbar__crumb strong { color: var(--mod-ink, var(--ink)); font-weight: 700; }
+.shell-topbar__crumb strong::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--mod, var(--accent)); vertical-align: 1px; }
+.shell-mode-toggle { width: 38px; height: 38px; border-radius: 12px; box-shadow: var(--shadow-raised); }
+
+/* Context sidebar: calmer labels, softer links, a clearly raised primary action. */
+.shell-context-sidebar { padding: 22px 16px 14px; gap: 18px; }
+.shell-wordmark { font-size: 20px; font-weight: 800; letter-spacing: -.04em; }
+.shell-workspace-label, .shell-subnav__label, .ui-filter-panel__head h2 { font-size: 11px; letter-spacing: .06em; font-weight: 700; color: var(--ink-faint); }
+.shell-workspace-name, .shell-workspace-select { border-radius: 10px; background: var(--surface); box-shadow: var(--shadow-raised); }
+.shell-create { min-height: 42px; border-radius: 11px; font-size: 14px; box-shadow: 0 8px 18px -8px color-mix(in srgb, var(--accent) 80%, transparent), 0 1px 2px rgb(0 0 0 / 14%); }
+.shell-subnav { gap: 2px; }
+.shell-subnav__link { min-height: 38px; padding: 5px 10px 5px 6px; border-radius: 10px; font-size: 13.5px; }
+.shell-subnav__glyph { width: 28px; height: 28px; border-radius: 9px; background: color-mix(in srgb, var(--mod) 10%, transparent); }
+.shell-subnav__link.is-active { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--mod) 22%, transparent); }
+.shell-sidebar-filter, .shell-sidebar-tools:not(:empty) { border-top-color: var(--line-subtle); }
+.shell-context-footer { border-top-color: var(--line-subtle); }
+.shell-nav__link { font-size: 11.5px; }
+.shell-brand { border-radius: 14px; }
+
+/* Cards and panels, wherever a screen declares one. */
+.panel { border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--card-lift); padding: 22px 24px; }
+.panel h2, .panel h3 { letter-spacing: -.018em; }
+.panel h2 { font-size: 16px; font-weight: 740; }
+[class*="_card__"] { box-shadow: var(--card-lift) !important; border-top-width: 3px; }
+[class*="_card__"]:hover { box-shadow: var(--card-lift-hover) !important; }
+
+/* Metric tiles: larger figure, module-tinted chip, room to breathe. */
+.ui-metric { padding: 18px 20px; gap: 8px; border-radius: var(--radius-lg); box-shadow: var(--card-lift); }
+.ui-metric__label { font-size: 12.5px; font-weight: 650; color: var(--ink-soft); letter-spacing: 0; }
+.ui-metric__value { font-size: clamp(26px, 3vw, 34px); font-weight: 780; letter-spacing: -.035em; margin-top: 2px; }
+.ui-metric__chip { width: 38px; height: 38px; border-radius: 12px; }
+
+/* A tile inside a panel sits flat on a tinted surface instead of stacking a second lifted card. */
