+
+/* Controls: one radius, one focus treatment, a tactile primary button. */
+.ui-button { border-radius: 10px; font-size: 13.5px; }
+.ui-button--primary { box-shadow: 0 1px 2px rgb(0 0 0 / 16%), inset 0 1px 0 rgb(255 255 255 / 14%); }
+.ui-button--secondary { box-shadow: 0 1px 2px rgb(20 24 40 / 6%); }
+.ui-input, .ui-select__trigger, .ui-filter select, .shell-sidebar-filter select, .shell-sidebar-filter input:not([type=checkbox]) { border-radius: 10px; border-color: var(--line-strong); }
+.ui-input:hover:not(:disabled):not([aria-invalid=true]) { border-color: var(--control-border); }
+.ui-chip, .ui-badge { font-weight: 650; }
+.ui-tabs__tab { font-size: 14px; }
+.ui-dialog { border-radius: 20px; }
+.ui-segmented { border-radius: 12px; }
+.ui-segmented__option { border-radius: 9px; }
+
+/* Inbox: the select-all bar is a second row; head, bar and list stack, and only the list scrolls. */
+section[class*="_listPane__"] { display: flex; flex-direction: column; grid-template-rows: none; }
+section[class*="_listPane__"] > ul[class*="_list__"] { flex: 1 1 auto; min-height: 0; }
+section[class*="_listPane__"] > div[class*="_bulk__"], section[class*="_listPane__"] > div[class*="_listHead__"] { flex: 0 0 auto; }
+
+@media (max-width: 1023px) { .shell-content { padding: 24px 24px 56px; } .shell-topbar { padding-inline: 20px; } }
+@media (max-width: 760px) { .shell-content { padding: 20px 16px 40px; } .panel { padding: 16px; } .ui-page-header__chip { width: 42px; height: 42px; } }
