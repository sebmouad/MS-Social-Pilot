// MS Social Pilot — Prisma schema, introspected from the database that prisma/migrations builds.
// It must describe every table: a schema that omits tables makes `prisma db push` or `migrate dev` drop them.
// CI applies the migrations to an empty database and fails when this file and that database differ. After adding
// a migration, run `npx prisma db pull` against a migrated database and commit the result with it.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                               String                  @id
  email                            String                  @unique
  name                             String
  passwordHash                     String
  locale                           Locale                  @default(en)
  lastActiveWorkspaceId            String?
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt
  isInstanceOwner                  Boolean                 @default(false)
  theme                            String                  @default("facebook")
  knownDevices                     String[]                @default([])
  disabledAt                       DateTime?
  totpEnabledAt                    DateTime?
  totpLastStep                     Int?
  totpPendingSecret                String?
  totpSecret                       String?
  pinnedMetrics                    String[]                @default([])
  emailVerifiedAt                  DateTime?
  planId                           String?
  extraChannels                    Int                     @default(0)
  ai_generations                   ai_generations[] @ignore
  api_tokens                       api_tokens[] @ignore
  app_settings                     AppSetting[]
  autopilot_policies               autopilot_policies[] @ignore
  calendar_feeds                   calendar_feeds[] @ignore
  chart_notes                      chart_notes[] @ignore
  client_invitations               client_invitations[] @ignore
  email_tokens                     email_tokens[] @ignore
  inbox_notes                      inbox_notes[] @ignore
  invitations                      invitations[] @ignore
  mcpApiKeys                       McpApiKey[]
  mcp_oauth_codes                  mcp_oauth_codes[] @ignore
  memberships                      Membership[]
  metric_alert_rules               metric_alert_rules[] @ignore
  notification_mutes               notification_mutes[] @ignore
  notification_settings            notification_settings[] @ignore
  notifications                    Notification[]
  passkeys                         Passkey[]
  person_mcp_keys                  person_mcp_keys[] @ignore
  post_export_runs                 post_export_runs[] @ignore
  post_exports                     post_exports[] @ignore
  post_notes                       post_notes[] @ignore
  post_versions                    post_versions[] @ignore
  posts                            Post[]
  posts_posts_reviewedByIdTousers  Post[]                  @relation("posts_reviewedByIdTousers")
  posts_posts_submittedByIdTousers Post[]                  @relation("posts_submittedByIdTousers")
  recoveryCodes                    RecoveryCode[]
  root_activities                  root_activities[] @ignore
  saved_views                      SavedView[]
  sessions                         Session[]
  task_checklist_items             task_checklist_items[] @ignore
  task_comments                    task_comments[] @ignore
  trusted_devices                  trusted_devices[] @ignore
  plans                            plans?                  @relation(fields: [planId], references: [id]) @ignore
  writing_agent_runs               WritingAgentRun[]
  writing_agents                   WritingAgent[]

  @@map("users")
}

model Session {
  id         String   @id
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  country    String?
  ip         String?
  lastSeenAt DateTime @default(now())
  userAgent  String?
  challenge  String?
  pending    String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Passkey {
  id           String    @id
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model RecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model AppSetting {
  key         String   @id
  value       Json
  encrypted   Boolean  @default(false)
  updatedAt   DateTime
  updatedById String?
  users       User?    @relation(fields: [updatedById], references: [id])

  @@map("app_settings")
}

model Workspace {
  id                               String                             @id
  name                             String
  slug                             String                             @unique
  timezone                         String                             @default("UTC")
  defaultLocale                    Locale                             @default(en)
  requiresApproval                 Boolean                            @default(false)
  logoUrl                          String?
  accentColor                      String?
  utmSource                        String?
  utmMedium                        String?
  utmCampaignTemplate              String?
  shortenerEnabled                 Boolean                            @default(false)
  aiEnabled                        Boolean                            @default(true)
  aiTone                           String?
  aiBrandVoice                     String?
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  reportFooter                     String?
  reportSubtitle                   String?
  reportTitle                      String?
  weekStartsOn                     Int                                @default(1)
  spamGapMinutes                   Int                                @default(20)
  bestTimeMode                     String                             @default("suggest")
  bestTimesRunAt                   DateTime?
  audienceCalendars                String[]                           @default([])
  audienceCountries                String[]                           @default([])
  audienceLanguages                String[]                           @default([])
  audienceTimezone                 String?
  undoSendSeconds                  Int                                @default(30)
  mixAutoFill                      Boolean                            @default(false)
  businessDays                     Int[]                              @default([])
  businessEnd                      Int                                @default(18)
  businessStart                    Int                                @default(9)
  disabledModules                  String[]                           @default([])
  suspendedAt                      DateTime?
  watchNegativeComments            Boolean                            @default(false)
  trendKeywords                    String[]                           @default([])
  developerFeatures                Boolean                            @default(false)
  clientAccess                     String[]                           @default(["analytics"])
  aiAvoidWords                     String?
  clientApprovalAfterTeam          Boolean                            @default(false)
  tasksAreaEnabled                 Boolean                            @default(false)
  scheduleMode                     String?
  activity_logs                    activity_logs[] @ignore
  adAccounts                       AdAccount[]
  ads_management_operations        ads_management_operations[] @ignore
  ai_agents                        ai_agents[] @ignore
  ai_generations                   ai_generations[] @ignore
  ai_videos                        ai_videos[] @ignore
  analytics_rollup_daily           analytics_rollup_daily[] @ignore
  analytics_rollup_runs            analytics_rollup_runs[] @ignore
  analytics_rollup_weekly          analytics_rollup_weekly[] @ignore
  api_tokens                       api_tokens[] @ignore
  autopilot_policies               autopilot_policies? @ignore
  bio_pages                        bio_pages? @ignore
  calendar_feeds                   calendar_feeds[] @ignore
  caption_tests                    caption_tests[] @ignore
  chart_notes                      chart_notes[] @ignore
  chat_channels                    ChatChannel[]
  chat_deliveries                  ChatDelivery[]
  content_mix_rules                content_mix_rules[] @ignore
  custom_fields                    custom_fields[] @ignore
  email_logs                       email_logs[] @ignore
  facebook_media_deletions         facebook_media_deletions[] @ignore
  facebook_media_resolutions       facebook_media_resolutions[] @ignore
  facebook_media_steps             facebook_media_steps[] @ignore
  facebook_native_journal          facebook_native_journal[] @ignore
  facebook_native_schedule_changes facebook_native_schedule_changes[] @ignore
  facebook_native_status_proofs    facebook_native_status_proofs[] @ignore
  facebook_sync_cursors            facebook_sync_cursors[] @ignore
  feed_sources                     feed_sources[] @ignore
  inboxDeletions                   InboxDeletion[]
  inbox_notes                      inbox_notes[] @ignore
  instagramAccounts                InstagramAccount[]
  invitations                      invitations[] @ignore
  key_dates                        key_dates[] @ignore
  labels                           labels[] @ignore
  mcpApiKeys                       McpApiKey[]
  mcp_oauth_codes                  mcp_oauth_codes[] @ignore
  media                            media[] @ignore
  memberships                      Membership[]
  metric_alert_firings             metric_alert_firings[] @ignore
  metric_alert_rules               metric_alert_rules[] @ignore
  moderation_actions               moderation_actions[] @ignore
  moderation_rules                 moderation_rules[] @ignore
  notification_settings            notification_settings[] @ignore
  notifications                    Notification[]
  page_goals                       page_goals[] @ignore
  page_groups                      page_groups[] @ignore
  postDeletions                    PostDeletion[]
  post_export_runs                 post_export_runs[] @ignore
  post_exports                     post_exports[] @ignore
  post_language_variants           post_language_variants[] @ignore
  post_templates                   post_templates[] @ignore
  posts                            Post[]
  publicationAttempts              PublicationAttempt[]
  queue_slots                      queue_slots[] @ignore
  reportRuns                       ReportRun[]
  report_schedules                 report_schedules[] @ignore
  report_templates                 report_templates[] @ignore
  saved_replies                    saved_replies[] @ignore
  saved_views                      SavedView[]
  seasonal_modes                   seasonal_modes[] @ignore
  share_links                      share_links[] @ignore
  short_links                      short_links[] @ignore
  snippets                         snippets[] @ignore
  socialAccounts                   SocialAccount[]
  targets                          Target[]
  task_checklist_items             task_checklist_items[] @ignore
  task_comments                    task_comments[] @ignore
  tasks                            tasks[] @ignore
  webhook_endpoints                webhook_endpoints[] @ignore
  wordpress_recipe_plans           WordpressRecipePlan[]
  wordpress_recipe_sources         WordpressRecipeSource?
  dataPurge                        WorkspaceDataPurge?
  exports                          WorkspaceExport[]
  workspace_watermarks             WorkspaceWatermark?
  writing_agent_runs               WritingAgentRun[]
  writing_agents                   WritingAgent[]

  @@map("workspaces")
}

model WorkspaceDataPurge {
  workspaceId   String    @id
  status        String    @default("requested")
  requestedById String
  apiKeyId      String?
  mediaRoot     String
  counts        Json?
  error         String?
  requestedAt   DateTime  @default(now())
  dbDeletedAt   DateTime?
  completedAt   DateTime?
  updatedAt     DateTime  @default(now()) @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@map("workspace_data_purges")
}

model McpApiKey {
  id            String    @id
  workspaceId   String
  createdById   String
  name          String
  tokenHash     String    @unique
  tokenPrefix   String
  readFeatures  String[]  @default([])
  writeFeatures String[]  @default([])
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  resourceScope Json?
  createdBy     User      @relation(fields: [createdById], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([expiresAt])
  @@map("mcp_api_keys")
}

model Membership {
  id                 String               @id
  userId             String
  workspaceId        String
  role               WorkspaceRole        @default(contributor)
  createdAt          DateTime             @default(now())
  allPages           Boolean              @default(true)
  disabledModules    String[]             @default([])
  member_page_access member_page_access[] @ignore
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model SocialAccount {
  id                  String             @id
  workspaceId         String
  provider            String             @default("facebook")
  providerUserId      String
  name                String
  pictureUrl          String?
  accessToken         String
  tokenExpiresAt      DateTime?
  scopes              String             @default("")
  invalidatedAt       DateTime?
  invalidReason       String?
  lastSyncedAt        DateTime?
  expiryWarningSentAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  meta                Json?
  refreshToken        String?
  profileUrl          String?
  adAccounts          AdAccount[]
  instagram_accounts  InstagramAccount[]
  notifications       Notification[]
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets             Target[]

  @@unique([workspaceId, provider, providerUserId])
  @@index([workspaceId])
  @@map("social_accounts")
}

model Target {
  id                      String                    @id
  workspaceId             String
  socialAccountId         String?
  type                    TargetType
  providerId              String
  name                    String
  pictureUrl              String?
  category                String?
  accessToken             String?
  enabled                 Boolean                   @default(true)
  canPublish              Boolean                   @default(true)
  publishBlocker          String?
  lastSyncedAt            DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  fanCount                Int?
  followersCount          Int?
  profileSyncedAt         DateTime?
  talkingAboutCount       Int?
  reviewsBackfilled       Boolean                   @default(false)
  publishBlockerCode      String?
  firstReadAt             DateTime?
  queueEmptyNotifiedAt    DateTime?
  queueFilledAt           DateTime?
  brandVoice              String?
  utmCampaign             String?
  utmMedium               String?
  utmSource               String?
  audienceCalendars       String[]                  @default([])
  audienceCountries       String[]                  @default([])
  audienceLanguages       String[]                  @default([])
  audienceTimezone        String?
  watermark               Json?
  negativeAlertAt         DateTime?
  locale                  String?
  analytics_rollup_daily  analytics_rollup_daily[] @ignore
  analytics_rollup_weekly analytics_rollup_weekly[] @ignore
  channel_profiles        channel_profiles? @ignore
  chart_notes             chart_notes[] @ignore
  content_mix_rules       content_mix_rules[] @ignore
  conversations           Conversation[]
  external_posts          external_posts[] @ignore
  facebook_sync_cursors   facebook_sync_cursors[] @ignore
  instagram_accounts      InstagramAccount[]
  member_page_access      member_page_access[] @ignore
  metric_alert_rules      metric_alert_rules[] @ignore
  metric_availability     metric_availability[] @ignore
  notification_mutes      notification_mutes[] @ignore
  notifications           Notification[]
  page_goals              page_goals[] @ignore
  page_group_targets      page_group_targets[] @ignore
  insights                PageInsight[]
  page_reviews            page_reviews[] @ignore
  page_videos             page_videos[] @ignore
  postTargets             PostTarget[]
  queue_slots             queue_slots[] @ignore
  reportRuns              ReportRun[]
  short_links             short_links[] @ignore
  socialAccount           SocialAccount?            @relation(fields: [socialAccountId], references: [id])
  workspace               Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  wordpress_recipe_plans  WordpressRecipePlan[]

  @@unique([workspaceId, providerId])
  @@index([socialAccountId])
  @@map("targets")
}

/// Stored Page metrics captured by the legacy analytics sync.
model PageInsight {
  id        String   @id
  targetId  String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime @default(now())
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric, period, endTime])
  @@index([targetId, metric, endTime])
  @@index([targetId, endTime, metric], map: "page_insights_target_time_metric")
  @@map("page_insights")
}

/// Read-only compatibility mapping to existing Instagram account snapshots.
model InstagramAccount {
  id                String             @id
  workspaceId       String
  socialAccountId   String?
  targetId          String?
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?
  followersCount    Int?
  followsCount      Int?
  mediaCount        Int?
  enabled           Boolean            @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  social_accounts   SocialAccount?     @relation(fields: [socialAccountId], references: [id])
  targets           Target?            @relation(fields: [targetId], references: [id])
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  insights          InstagramInsight[]
  media             InstagramMedia[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

/// Stored Instagram account metrics captured by the existing Meta sync.
model InstagramInsight {
  id        String           @id
  accountId String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime         @default(now())
  account   InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metric, period, endTime])
  @@index([accountId, metric, endTime])
  @@map("instagram_insights")
}

/// Stored post-level Instagram metrics and media metadata.
model InstagramMedia {
  id               String           @id
  accountId        String
  remoteId         String
  caption          String?
  mediaType        String?
  mediaProductType String?
  mediaUrl         String?
  permalink        String?
  thumbnailUrl     String?
  timestamp        DateTime
  likeCount        Int?
  commentsCount    Int?
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime         @default(now())
  account          InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, remoteId])
  @@index([accountId, timestamp])
  @@map("instagram_media")
}

model Post {
  id                               String                   @id
  workspaceId                      String
  authorId                         String
  message                          String                   @default("")
  link                             String?
  linkPreview                      Json?
  media                            Json                     @default("[]")
  status                           PostStatus               @default(draft)
  publishMode                      PublishMode              @default(worker)
  scheduledAt                      DateTime?
  timezone                         String                   @default("UTC")
  publishedAt                      DateTime?
  approvalStatus                   ApprovalStatus           @default(not_required)
  submittedById                    String?
  submittedAt                      DateTime?
  reviewedById                     String?
  reviewedAt                       DateTime?
  reviewNote                       String?
  variants                         Json                     @default("[]")
  recycleEnabled                   Boolean                  @default(false)
  recycleEveryDays                 Int?
  recycleLimit                     Int?
  recycleCount                     Int                      @default(0)
  recycleNextAt                    DateTime?
  originPostId                     String?
  sourceFeedItemId                 String?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime
  mediaKeys                        String[]                 @default([])
  firstComment                     String?
  firstCommentDelayMinutes         Int                      @default(0)
  /// Existing legacy column; opaque module format identity, not interpreted by the shared core.
  format                           String                   @default("post")
  captionLabel                     String?
  captionTestId                    String?
  teamApprovedById                 String?
  teamApprovedAt                   DateTime?
  place                            String?
  textBackground                   String?
  notifications                    Notification[]
  post_field_values                post_field_values[] @ignore
  post_labels                      post_labels[] @ignore
  post_language_variants           post_language_variants[] @ignore
  post_notes                       post_notes[] @ignore
  targets                          PostTarget[]
  post_versions                    post_versions[] @ignore
  author                           User                     @relation(fields: [authorId], references: [id])
  caption_tests                    caption_tests?           @relation(fields: [captionTestId], references: [id]) @ignore
  users_posts_reviewedByIdTousers  User?                    @relation("posts_reviewedByIdTousers", fields: [reviewedById], references: [id])
  feed_items                       feed_items?              @relation(fields: [sourceFeedItemId], references: [id]) @ignore
  users_posts_submittedByIdTousers User?                    @relation("posts_submittedByIdTousers", fields: [submittedById], references: [id])
  workspace                        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  review_decisions                 review_decisions[] @ignore
  short_links                      short_links[] @ignore

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([authorId])
  @@index([captionTestId])
  @@index([mediaKeys], type: Gin)
  @@index([message(ops: raw("gin_trgm_ops"))], map: "posts_message_trgm_idx", type: Gin)
  @@index([originPostId])
  @@index([recycleEnabled, recycleNextAt])
  @@index([scheduledAt])
  @@index([sourceFeedItemId])
  @@index([workspaceId, approvalStatus])
  @@index([workspaceId, createdAt, id], map: "posts_workspace_created_order")
  @@index([workspaceId, scheduledAt, createdAt, id], map: "posts_workspace_schedule_order")
  @@index([workspaceId, status, scheduledAt, createdAt, id], map: "posts_workspace_status_schedule_order")
  @@map("posts")
}

model PostTarget {
  id                 String           @id
  postId             String
  targetId           String
  status             PostTargetStatus @default(pending)
  remotePostId       String?
  remoteUrl          String?
  nativeScheduledFor DateTime?
  attempts           Int              @default(0)
  nextAttemptAt      DateTime?
  lockedAt           DateTime?
  lockedBy           String?
  errorCode          String?
  errorMessage       String?
  publishedAt        DateTime?
  insights           Json?
  insightsSyncedAt   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  firstCommentId     String?
  firstCommentAt     DateTime?
  firstCommentError  String?
  remoteMissingAt    DateTime?
  removedAt          DateTime?
  messageOverride    String?
  skipMedia          Boolean          @default(false)
  /// Opaque module format identity; null means existing legacy intent.
  formatId           String?
  /// Where this destination's schedule waits: 'application' or 'remote'. Null follows the post-level choice (posts.publishMode).
  scheduleMode       String?
  comments           PostComment[]
  post               Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  target             Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([postId, targetId])
  @@index([targetId])
  @@index([status, insightsSyncedAt])
  @@index([status, nextAttemptAt])
  @@map("post_targets")
}

/// Inbox records mapped to the existing legacy tables; provider writes are performed by the server action layer.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model PostComment {
  id                   String     @id
  postTargetId         String
  remoteId             String
  parentRemoteId       String?
  message              String
  fromName             String?
  fromId               String?
  likeCount            Int        @default(0)
  replyCount           Int        @default(0)
  isHidden             Boolean    @default(false)
  createdTime          DateTime
  fetchedAt            DateTime   @default(now())
  resolvedAt           DateTime?
  firstSeenAt          DateTime   @default(now())
  sentById             String?
  sentiment            String?
  assigneeId           String?
  sentimentAttemptedAt DateTime?
  sentimentProvenance  Json?
  inboxMetadata        Json?
  postTarget           PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@unique([postTargetId, remoteId])
  @@index([postTargetId, createdTime])
  @@index([fromName(ops: raw("gin_trgm_ops"))], map: "post_comments_author_trgm_idx", type: Gin)
  @@index([message(ops: raw("gin_trgm_ops"))], map: "post_comments_message_trgm_idx", type: Gin)
  @@map("post_comments")
}

model Conversation {
  id            String                @id
  targetId      String
  remoteId      String
  snippet       String?
  unreadCount   Int                   @default(0)
  messageCount  Int                   @default(0)
  participants  Json?
  updatedTime   DateTime
  fetchedAt     DateTime              @default(now())
  resolvedAt    DateTime?
  assigneeId    String?
  inboxMetadata Json?
  messages      ConversationMessage[]
  target        Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, updatedTime])
  @@index([snippet(ops: raw("gin_trgm_ops"))], map: "conversations_snippet_trgm_idx", type: Gin)
  @@map("conversations")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ConversationMessage {
  id             String       @id
  conversationId String
  remoteId       String
  fromName       String?
  fromId         String?
  message        String?
  createdTime    DateTime
  firstSeenAt    DateTime     @default(now())
  sentById       String?
  inboxMetadata  Json?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, remoteId])
  @@index([conversationId, createdTime])
  @@index([fromName(ops: raw("gin_trgm_ops"))], map: "conversation_messages_author_trgm_idx", type: Gin)
  @@index([message(ops: raw("gin_trgm_ops"))], map: "conversation_messages_message_trgm_idx", type: Gin)
  @@map("conversation_messages")
}

model AdAccount {
  id                        String                      @id
  workspaceId               String
  socialAccountId           String?
  actId                     String
  name                      String
  currency                  String?
  accountStatus             Int?
  enabled                   Boolean                     @default(true)
  lastSyncedAt              DateTime?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  socialAccount             SocialAccount?              @relation(fields: [socialAccountId], references: [id])
  workspace                 Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  insights                  AdInsight[]
  ads_management_operations ads_management_operations[] @ignore
  ads_objects               ads_objects[] @ignore

  @@unique([workspaceId, actId])
  @@index([workspaceId])
  @@map("ad_accounts")
}

/// Stored daily delivery metrics for an ad account, campaign, ad set or ad.
model AdInsight {
  id          String    @id
  adAccountId String
  level       String
  objectId    String
  objectName  String?
