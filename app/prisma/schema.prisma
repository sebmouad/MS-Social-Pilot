// MS Social Pilot — Primary Prisma Schema
// Maps PostgreSQL tables managed by prisma/migrations/.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  editor
  contributor
  viewer
  client
}

enum TargetType {
  page
  group
  instagram
  bluesky
  mastodon
  linkedin
  threads
  x
  pinterest
  telegram
  youtube
  tiktok
}

enum PostStatus {
  draft
  pending_approval
  rejected
  scheduled
  publishing
  published
  partially_failed
  failed
  cancelled
}

enum PostTargetStatus {
  pending
  processing
  published
  scheduled_remote
  failed
  cancelled
  skipped
}

model User {
  id           String       @id
  email        String       @unique
  name         String
  passwordHash String
  disabledAt   DateTime?
  isInstanceOwner Boolean @default(false)
  totpSecret String?
  totpPendingSecret String?
  totpEnabledAt DateTime?
  totpLastStep Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passkeys     Passkey[]
  recoveryCodes RecoveryCode[]
  memberships  Membership[]
  posts        Post[]
  sessions     Session[]
  mcpApiKeys   McpApiKey[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  pending   String?
  challenge String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Passkey {
  id           String   @id
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String[]
  name         String
  lastUsedAt   DateTime?
  createdAt    DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passkeys")
}

model RecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
}

model AppSetting {
  key       String   @id
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime

  @@map("app_settings")
}

model Workspace {
  reportRuns ReportRun[]
  id             String          @id
  name           String
  slug           String          @unique
  timezone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    Membership[]
  targets        Target[]
  posts          Post[]
  socialAccounts SocialAccount[]
  adAccounts     AdAccount[]
  instagramAccounts InstagramAccount[]
  mcpApiKeys     McpApiKey[]
  dataPurge      WorkspaceDataPurge?
  exports WorkspaceExport[]

  inboxDeletions InboxDeletion[]
  postDeletions  PostDeletion[]
  publicationAttempts PublicationAttempt[]

  @@map("workspaces")
}

model WorkspaceDataPurge {
  workspaceId   String   @id
  status        String   @default("requested")
  requestedById String
  apiKeyId      String?
  mediaRoot     String
  counts        Json?
  error         String?
  requestedAt   DateTime @default(now())
  dbDeletedAt   DateTime?
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status, updatedAt])
  @@map("workspace_data_purges")
}

model McpApiKey {
  id          String    @id
  workspaceId String
  createdById String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  readFeatures String[] @default([])
  writeFeatures String[] @default([])
  resourceScope Json?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([expiresAt])
  @@map("mcp_api_keys")
}

model Membership {
  id          String        @id
  userId      String
  workspaceId String
  role        WorkspaceRole
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model SocialAccount {
  id             String      @id
  workspaceId    String
  provider       String
  providerUserId String
  name           String
  pictureUrl     String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String @default("")
  invalidatedAt  DateTime?
  invalidReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id])
  targets        Target[]
  adAccounts     AdAccount[]

  @@unique([workspaceId, provider, providerUserId])
  @@index([workspaceId])
  @@map("social_accounts")
}

model Target {
  reportRuns ReportRun[]
  id              String         @id
  workspaceId     String
  socialAccountId String?
  type            TargetType
  providerId      String
  name            String
  pictureUrl      String?
  accessToken     String?
  enabled         Boolean
  canPublish      Boolean
  followersCount Int?
  profileSyncedAt DateTime?
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  postTargets     PostTarget[]
  insights        PageInsight[]
  conversations   Conversation[]

  @@unique([workspaceId, providerId])
  @@index([socialAccountId])
  @@map("targets")
}

/// Stored Page metrics captured by the legacy analytics sync.
model PageInsight {
  id        String   @id
  targetId  String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime
  target    Target   @relation(fields: [targetId], references: [id])

  @@unique([targetId, metric, period, endTime])
  @@index([targetId, metric, endTime])
  @@map("page_insights")
}

/// Read-only compatibility mapping to existing Instagram account snapshots.
model InstagramAccount {
  id                String   @id
  workspaceId       String
  socialAccountId   String?
  targetId          String?
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?
  followersCount    Int?
  followsCount      Int?
  mediaCount        Int?
  enabled           Boolean
  lastSyncedAt      DateTime?
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  insights          InstagramInsight[]
  media             InstagramMedia[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

/// Stored Instagram account metrics captured by the existing Meta sync.
model InstagramInsight {
  id        String   @id
  accountId String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime
  account   InstagramAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, metric, period, endTime])
  @@index([accountId, metric, endTime])
  @@map("instagram_insights")
}

/// Stored post-level Instagram metrics and media metadata.
model InstagramMedia {
  id               String   @id
  accountId        String
  remoteId         String
  caption          String?
  mediaType        String?
  mediaProductType String?
  mediaUrl         String?
  permalink        String?
  thumbnailUrl     String?
  timestamp        DateTime
  likeCount        Int?
  commentsCount    Int?
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime
  account          InstagramAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, remoteId])
  @@index([accountId, timestamp])
  @@map("instagram_media")
}

model Post {
  id          String       @id
  workspaceId String
  authorId    String
  message     String
  firstComment String?
  firstCommentDelayMinutes Int @default(0)
  /// Existing legacy column; opaque module format identity, not interpreted by the shared core.
  format      String       @default("post")
  link        String?
  media       Json         @default("[]")
  status      PostStatus
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])
  targets     PostTarget[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@map("posts")
}

model PostTarget {
  id           String           @id
  postId       String
  targetId     String
  status       PostTargetStatus
  /// Opaque module format identity; null means existing legacy intent.
  formatId String?
  /// Where this destination's schedule waits: 'application' or 'remote'. Null follows the post-level choice (posts.publishMode).
  scheduleMode String?
  remotePostId String?
  remoteUrl    String?
  firstCommentId String?
  firstCommentAt DateTime?
  firstCommentError String?
  publishedAt  DateTime?
  updatedAt    DateTime         @updatedAt
  post         Post             @relation(fields: [postId], references: [id])
  target       Target           @relation(fields: [targetId], references: [id])
  comments     PostComment[]

  @@unique([postId, targetId])
  @@index([targetId])
  @@map("post_targets")
}

/// Inbox records mapped to the existing legacy tables; provider writes are performed by the server action layer.
model PostComment {
  id             String   @id
  postTargetId   String
  remoteId       String
  parentRemoteId String?
  message        String
  fromName       String?
  fromId         String?
  likeCount      Int      @default(0)
  replyCount     Int      @default(0)
  isHidden       Boolean  @default(false)
  createdTime    DateTime
  fetchedAt      DateTime @default(now())
  firstSeenAt    DateTime @default(now())
  resolvedAt     DateTime?
  assigneeId     String?
  sentById       String?
  sentimentAttemptedAt DateTime?
  sentimentProvenance Json?
  sentiment      String?
  postTarget     PostTarget @relation(fields: [postTargetId], references: [id])

  @@unique([postTargetId, remoteId])
  @@index([postTargetId, createdTime])
  @@map("post_comments")
}

model Conversation {
  id           String   @id
  targetId     String
  remoteId     String
  snippet      String?
  unreadCount  Int      @default(0)
  messageCount Int      @default(0)
  participants Json?
  updatedTime  DateTime
  fetchedAt    DateTime @default(now())
  resolvedAt   DateTime?
  assigneeId   String?
  target       Target   @relation(fields: [targetId], references: [id])
  messages     ConversationMessage[]

  @@unique([targetId, remoteId])
  @@index([targetId, updatedTime])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id
  conversationId String
  remoteId       String
  fromName       String?
  fromId         String?
  message        String?
  createdTime    DateTime
  firstSeenAt    DateTime @default(now())
  sentById       String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, remoteId])
  @@index([conversationId, createdTime])
  @@map("conversation_messages")
}

model AdAccount {
  id              String         @id
  workspaceId     String
  socialAccountId String?
  actId           String
  name            String
  currency        String?
  accountStatus   Int?
  enabled         Boolean
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  insights        AdInsight[]

  @@unique([workspaceId, actId])
  @@index([workspaceId])
  @@map("ad_accounts")
}

/// Stored daily delivery metrics for an ad account, campaign, ad set or ad.
model AdInsight {
  id          String   @id
  adAccountId String
  level       String
  objectId    String
  objectName  String?
  date        DateTime
  spend       Float
  impressions Int
  clicks      Int
  reach       Int
  cpc         Float?
  cpm         Float?
  cpp         Float?
  ctr         Float?
  frequency   Float?
  actions     Json?
  fields      Json?
  fetchedAt   DateTime
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id])

  @@unique([adAccountId, level, objectId, date])
  @@index([adAccountId, date])
  @@map("ad_insights")
}

/// Atomic cross-process lock for one scheduled rebuild job.
model JobLease {
  name           String   @id
  owner          String
  token          String
  leaseExpiresAt DateTime
  updatedAt      DateTime @default(now())

  @@index([leaseExpiresAt])
  @@map("job_leases")
}

/// Append-only operational history for Root job health and incident review.
model SyncRun {
  id         String    @id
  job        String
  owner      String
  startedAt  DateTime
  finishedAt DateTime?
  outcome    String
  attempts   Int       @default(0)
  summary    String?
  error      String?

  @@index([job, startedAt])
  @@index([finishedAt])
  @@map("sync_runs")
}

/// Durable Inbox deletion recovery and content-free tombstones.
model InboxDeletion {
  id                  String    @id
  workspaceId         String
  targetId            String
  provider            String
  remoteId            String
  localItemId         String
  localAliases        String[]  @default([])
  suppressedRemoteIds String[]  @default([])
  actorId             String
  state               String
  reason              String?
  createdAt           DateTime  @default(now()) @db.Timestamp(3)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamp(3)
  remoteConfirmedAt   DateTime? @db.Timestamp(3)
  completedAt         DateTime? @db.Timestamp(3)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, targetId, remoteId])
  @@index([workspaceId, targetId, updatedAt])
  @@map("inbox_deletions")
}

/// Durable, content-free recovery journal and tombstones for remote post deletion.
model PostDeletion {
  id                 String    @id
  workspaceId        String
  targetId           String
  provider           String
  remoteId           String
  actorId            String
  localPostIds       String[]  @default([])
  localPostTargetIds String[]  @default([])
  state              String
  reason             String?
  createdAt          DateTime  @default(now()) @db.Timestamp(3)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamp(3)
  remoteConfirmedAt  DateTime? @db.Timestamp(3)
  completedAt        DateTime? @db.Timestamp(3)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetId, updatedAt])
  @@index([localPostIds], type: Gin)
  @@map("post_deletions")
}

/// Durable, content-free provider publication attempt and receipt journal.
model PublicationAttempt {
  id           String    @id @default(uuid())
  workspaceId  String
  postId       String
  postTargetId String
  targetId     String
  provider     String
  actorId      String
  state        String
  reason       String?
  remotePostId String?
  remoteUrl    String?
  receiptAt    DateTime? @db.Timestamp(3)
  projectedAt  DateTime? @db.Timestamp(3)
  attestedAt   DateTime? @db.Timestamp(3)
  attestedBy   String?
  createdAt    DateTime  @default(now()) @db.Timestamp(3)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamp(3)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetId, updatedAt])
  @@index([workspaceId, postId, postTargetId])
  @@map("publication_attempts")
}


/// Durable report outcomes; content receipts are retained only for manual downloads.
model ReportRun {
  id String @id
  workspaceId String
  scheduleId String?
  targetId String
  kind String
  idempotencyKey String @unique
  claimToken String
  requestHash String? @db.Char(64)
  periodStart String
  periodEnd String
  status String
  leaseUntil DateTime @db.Timestamptz(6)
  startedAt DateTime @default(now()) @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  rowCount Int?
  truncated Boolean @default(false)
  failureReason String?
  deliveries Json @default("[]")
  requestedById String?
  output Json?
  outputExpiresAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  target Target @relation(fields:[targetId], references:[id], onDelete:Cascade)
  @@index([workspaceId,startedAt(sort:Desc),id], map:"report_runs_workspace_history")
  @@index([workspaceId,targetId,startedAt(sort:Desc),id], map:"report_runs_channel_history")
  @@map("report_runs")
}

/// Personal Posts/Calendar saved views. Table created by the shared migration
/// 20261019090000_saved_views (no rebuild DDL needed). Accessed through
/// src/modules/publishing/server/saved-views.ts with workspace+user binding.
model SavedView {
  id          String   @id
  workspaceId String
  userId      String
  name        String
  screen      String
  query       String
  createdAt   DateTime @default(now())
  @@index([workspaceId, userId, screen])
  @@map("saved_views")
}

model WorkspaceExport {
  id String @id
  workspaceId String
  requestedById String
  apiKeyId String?
  status String @default("requested")
  mediaRoot String
  leaseToken String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime
  error String?
  bytes Int?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "workspace_exports_due")
  @@index([workspaceId, createdAt], map: "workspace_exports_workspace")
  @@map("workspace_exports")
}

// Deletion outbox: no FK so file cleanup survives erasure and a worker restart.
model ExportFileCleanup {
  id String @id
  workspaceId String
  mediaRoot String
  nextAttemptAt DateTime @default(now())

  @@index([workspaceId], map: "export_file_cleanups_workspace")
  @@map("export_file_cleanups")
}

/// WordPress / CMS recipe & content source configured per workspace.
model WordpressRecipeSource {
  id          String   @id
  workspaceId String   @unique
  name        String
  siteUrl     String
  enabled     Boolean  @default(false)
  allTargets  Boolean  @default(true)
  targetIds   Json     @default("[]")
  config      Json     @default("{}")
  lastRunAt   DateTime?
  lastError   String?
  lastSummary Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  plans       WordpressRecipePlan[]

  @@map("wordpress_recipe_sources")
}

/// Planned slot ledger for WordPress / CMS recipe automation.
model WordpressRecipePlan {
  id          String   @id
  workspaceId String
  sourceId    String
  targetId    String
  wpPostId    String
  slotAt      DateTime
  state       String
  postId      String?
  title       String
  permalink   String?
  reason      String?
  skipped     Json     @default("[]")
  claimedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  source      WordpressRecipeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, slotAt])
  @@index([workspaceId, sourceId, slotAt])
  @@map("wordpress_recipe_plans")
}

/// In-app and email notification ledger.
model Notification {
  id                String    @id
  workspaceId       String
  recipientId       String
  eventId           String
  kind              String
  context           Json      @default("{}")
  readAt            DateTime?
  emailStatus       String
  emailAttempts     Int       @default(0)
  emailNextAttemptAt DateTime?
  emailClaimToken   String?
  emailClaimedAt    DateTime?
  emailSentAt       DateTime?
  emailLastError    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workspaceId, eventId, recipientId], map: "notifications_event_recipient_uq")
  @@index([workspaceId, recipientId, createdAt(sort: Desc), id(sort: Desc)], map: "notifications_recipient_page_idx")
  @@map("notifications")
}

/// Outbound Slack / Discord / Telegram chat channel webhooks.
model ChatChannel {
  id          String   @id
  workspaceId String
  name        String
  kind        String
  secret      String
  events      String[] @default([])
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@map("chat_channels")
}

/// Durable delivery queue for outbound chat notifications.
model ChatDelivery {
  id           String    @id
  workspaceId  String
  channelId    String
  eventId      String
  event        String
  operatorOnly Boolean   @default(false)
  source       Json?
  status       String    @default("pending")
  claimToken   String?
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@unique([workspaceId, channelId, eventId, event])
  @@index([status, createdAt], map: "chat_deliveries_pending")
  @@map("chat_deliveries")
}

/// Custom AI writing personas per workspace.
model WritingAgent {
  id           String   @id
  workspaceId  String
  name         String
  instructions String
  voice        String
  createdById  String
  updatedAt    DateTime @default(now())

  @@unique([id, workspaceId])
  @@index([workspaceId, id])
  @@map("writing_agents")
}

/// Execution log for custom AI writing agents.
model WritingAgentRun {
  id          String    @id
  workspaceId String
  agentId     String?
  createdById String
  kind        String
  status      String
  errorCode   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workspaceId, createdAt(sort: Desc), id])
  @@map("writing_agent_runs")
}

/// Workspace watermark image configuration.
model WorkspaceWatermark {
  workspaceId String   @id
  mediaId     String
  position    String
  opacity     Int
  scale       Int
  updatedById String
  updatedAt   DateTime @default(now())

  @@map("workspace_watermarks")
}

