+  return writingAgents({ userId: viewer.userId, workspaceId: viewer.workspaceId, permissionCeiling: viewer.permissions, apiKeyId: viewer.apiKeyId }, name === 'list_writing_agents' ? { action: 'list', ...args } : args);
