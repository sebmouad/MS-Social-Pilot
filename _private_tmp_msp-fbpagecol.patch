+import { describe, expect, it, vi } from 'vitest';
+import { FACEBOOK_PAGE_METRIC_DEFAULTS, type FacebookConfig } from '../src/platforms/facebook/config';
+import { createFacebookDataCollector } from '../src/platforms/facebook/data-collection';
+import { configuredFacebookPageInsightMetrics } from '../src/platforms/facebook/page-insights';
+
+const settings = vi.hoisted(() => ({ read: vi.fn() }));
+vi.mock('../src/server/config/store', () => ({ runtimeConfig: settings.read }));
+
+const since = new Date('2026-10-01T00:00:00Z');
+const until = new Date('2026-10-02T00:00:00Z');
+const base: FacebookConfig = {
+  graphBaseUrl: 'https://graph.example.test', oauthBaseUrl: 'https://facebook.example.test',
+  graphVersion: 'v26.0', requestTimeoutMs: 1000, maxPages: 2, pageSize: 25,
+  pageInsightMetrics: [], adInsightFields: [], maxImageUploadBytes: 1024,
+  allowedImageMimeTypes: ['image/jpeg'], appSecretProofEnabled: false,
+};
+
+async function collect(saved: unknown, rejected?: string) {
+  const requested: string[] = [];
+  const fetcher = vi.fn(async (input: RequestInfo | URL) => {
+    const url = new URL(String(input));
+    expect(url.pathname).toBe('/v26.0/page/insights');
+    expect(url.searchParams.get('period')).toBe('day');
+    const metric = url.searchParams.get('metric')!;
+    requested.push(metric);
+    return new Response(JSON.stringify(metric === rejected
+      ? { error: { message: 'private provider detail' } }
+      : { data: [{ name: metric, period: 'day', values: [{ value: 0, end_time: until.toISOString() }] }] }),
+    { status: metric === rejected ? 400 : 200 });
+  });
+  settings.read.mockImplementation(async (key: string) => {
+    expect(key).toBe('meta.pageInsightMetrics');
+    return saved;
+  });
+  const pageInsightMetrics = await configuredFacebookPageInsightMetrics();
+  const result = await createFacebookDataCollector({ ...base, pageInsightMetrics },
+    { periods: ['day'], content: [] }, fetcher).getPageInsightObservations('synthetic-token', 'page', since, until);
+  return { requested, result, fetcher };
+}
+
+describe('Page collection of merged Root metric selections', () => {
+  it('collects shipped defaults missing from a legacy saved list and retains additions once', async () => {
+    const saved = ['page_follows', 'custom_metric', 'page_follows'];
+    const { requested, result } = await collect(saved);
+    expect(requested).toEqual(['page_follows', 'custom_metric', ...FACEBOOK_PAGE_METRIC_DEFAULTS.filter(metric => metric !== 'page_follows')]);
+    expect(result.map(row => row.metric)).toEqual(requested);
+    expect(result.every(row => row.numeric === 0 && row.endTime.getTime() === until.getTime())).toBe(true);
+    expect(saved).toEqual(['page_follows', 'custom_metric', 'page_follows']);
+  });
+
+  it('honors exclusions for defaults and explicit additions without restoring them in collection', async () => {
+    const saved = { metrics: ['custom_metric', 'page_video_views'], excludedMetrics: ['page_video_views', 'custom_metric', 'future_metric'] };
+    const { requested, result } = await collect(saved);
+    expect(requested).toEqual(FACEBOOK_PAGE_METRIC_DEFAULTS.filter(metric => metric !== 'page_video_views'));
+    expect(result.map(row => row.metric)).toEqual(requested);
+    expect(saved.excludedMetrics).toEqual(['page_video_views', 'custom_metric', 'future_metric']);
+  });
+
+  it('makes no requests when every default is explicitly excluded', async () => {
+    const { requested, result, fetcher } = await collect({ metrics: [], excludedMetrics: FACEBOOK_PAGE_METRIC_DEFAULTS });
+    expect(requested).toEqual([]);
+    expect(result).toEqual([]);
+    expect(fetcher).not.toHaveBeenCalled();
+  });
+
+  it('retains successful new defaults when one metric is rejected', async () => {
+    const { requested, result } = await collect(['page_follows'], 'page_video_views');
+    expect(requested).toEqual(FACEBOOK_PAGE_METRIC_DEFAULTS);
+    expect(result.map(row => row.metric)).toEqual(FACEBOOK_PAGE_METRIC_DEFAULTS.filter(metric => metric !== 'page_video_views'));
+    expect(result.failedMetrics).toEqual([{ metric: 'page_video_views::day', message: 'Configured insight collection failed.' }]);
+  });
+
+  it('refuses malformed exclusions instead of collecting silently', async () => {
+    settings.read.mockResolvedValue({ metrics: [], excludedMetrics: ['bad metric'] });
+    await expect(configuredFacebookPageInsightMetrics()).rejects.toThrow();
+  });
+
+  it('propagates unavailable Root settings instead of replacing deliberate choices', async () => {
+    settings.read.mockRejectedValue(new Error('Settings unavailable'));
+    await expect(configuredFacebookPageInsightMetrics()).rejects.toThrow('Settings unavailable');
+  });
+});
