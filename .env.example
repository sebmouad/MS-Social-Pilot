# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
#
# Almost everything below can also be set at runtime on Settings -> Configuration,
# and a value set there wins over the one here. This file is the bootstrap and
# the fallback: enough to start the app, and what it falls back to when an
# override is cleared.
#
# Three things can only live here, because they cannot live in the database:
#
#   DATABASE_URL    reads the settings table
#   ENCRYPTION_KEY  protects the secrets stored inside it
#   SESSION_SECRET  cannot be rotated from inside a session
#
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Where the app is reachable. Must match the Facebook OAuth redirect host
# exactly (scheme included) — Facebook rejects mismatched redirect URIs.
APP_URL="http://localhost:3000"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_pilot?schema=public"

# Signs session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Encrypts access tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Rotating this key makes every stored token unreadable — accounts must be
# reconnected. See docs/DEPLOYMENT.md.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Facebook app credentials (developers.facebook.com → your app → Settings)
# ---------------------------------------------------------------------------

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Graph API version to pin. Bumping this is a deliberate act: Meta ships
# breaking changes between versions and each is supported for ~2 years.
FACEBOOK_GRAPH_VERSION="v21.0"

# Permissions requested during login. pages_* covers Pages; the group scopes
# are only useful if your app has Groups API access (see docs/META_APP_SETUP.md).
FACEBOOK_SCOPES="pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,read_insights,business_management"

# Base URL for the Graph API. Only set this to point at a stub or a recording
# proxy (the test suite does); leave it unset in production.
# FACEBOOK_GRAPH_BASE_URL="https://graph.facebook.com"

# Set to "true" to additionally request publish_to_groups / groups_access_member_info
# and to surface Groups in the UI. Off by default because Meta restricted the
# Groups API in April 2024 — read the docs before enabling.
FACEBOOK_ENABLE_GROUPS="false"

# Analytics-only permissions, each reviewed separately by Meta. Requesting one
# the app has not been approved for makes the whole consent dialog fail, so
# they are off until your app review is through.
#
#   MESSAGING  -> pages_messaging, pages_manage_metadata (the Page inbox tab)
#   INSTAGRAM  -> instagram_basic, instagram_manage_insights
#   ADS        -> ads_read (read-only; ads_management is never requested)
#
# The Instagram and Ads worker jobs only run when their flag is on.
FACEBOOK_ENABLE_MESSAGING="false"
FACEBOOK_ENABLE_INSTAGRAM="false"
FACEBOOK_ENABLE_ADS="false"

# ---------------------------------------------------------------------------
# Scheduler worker
# ---------------------------------------------------------------------------

# How often the worker looks for due posts, in seconds.
SCHEDULER_POLL_SECONDS="30"

# Intervals for the worker's other jobs.
RSS_POLL_MINUTES="15"
EVERGREEN_CHECK_MINUTES="60"
ANALYTICS_REFRESH_HOURS="6"

# How often the full Page insights catalogue is captured.
PAGE_INSIGHTS_HOURS="12"

# Comments, ratings, inbox threads, videos and posts published outside the app.
EDGE_SYNC_HOURS="4"

# Only used when the matching FACEBOOK_ENABLE_* flag above is on.
INSTAGRAM_SYNC_HOURS="12"
ADS_SYNC_HOURS="12"

TOKEN_EXPIRY_CHECK_HOURS="24"

# How many destinations are published to concurrently.
SCHEDULER_CONCURRENCY="4"

# Give up after this many attempts on a retryable failure.
SCHEDULER_MAX_ATTEMPTS="5"

# Shared secret for POST /api/cron/tick, the serverless alternative to running
# the long-lived worker. Leave blank to disable that endpoint.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Directory for uploaded files (created on demand).
MEDIA_DIR="./media"
MAX_UPLOAD_MB="25"

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# Leave blank in development: the app runs normally and logs each message as
# "skipped" rather than failing.
RESEND_API_KEY=""
EMAIL_FROM="MS Social Pilot <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# AI captions (Claude)
# ---------------------------------------------------------------------------

# Without a key the composer hides the AI tools entirely.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# Per workspace, per hour. Stops a stuck client loop running up a bill.
AI_RATE_LIMIT_PER_HOUR="100"

# ---------------------------------------------------------------------------
# Link shortener
# ---------------------------------------------------------------------------

# Bare host, e.g. "go.yourdomain.com", pointed at this app. Blank puts short
# links under APP_URL/l/<slug>, which works but is less tidy in a post.
SHORTENER_DOMAIN=""

# ---------------------------------------------------------------------------
# Interface language
# ---------------------------------------------------------------------------

# Fallback when a visitor has no account and sends no Accept-Language: en | fr
DEFAULT_LOCALE="en"
