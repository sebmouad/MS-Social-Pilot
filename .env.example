# ---------------------------------------------------------------------------
# Infrastructure only
# ---------------------------------------------------------------------------
#
# This file holds what the app needs before it can read its own database: where
# to listen, how to reach Postgres, and the two keys that protect sessions and
# stored secrets. Everything else — the public URL, the Facebook app, email,
# AI providers, alerts, worker intervals, limits — is set by root on the
# Configuration screen (/root/config) and stored in the database.
#
# Any setting on that screen can still be given here by the variable name the
# screen shows next to it; the screen marks such a value "from the environment"
# and offers to move it into the database, after which the line can go.
#

# The port and interface the web app listens on.
#
# 80 by default, for the common deployment: Cloudflare (or any other proxy)
# terminates HTTPS and forwards to this app over plain HTTP. There is no
# certificate handling in here, so 443 is never this process's port.
#
# Port 80 is privileged. The systemd unit written by scripts/install-debian.sh
# carries the capability to bind it; otherwise grant it once, which is safer
# than running the whole app as root:
#
#   sudo setcap 'cap_net_bind_service=+ep' "$(command -v node)"
#
# Set PORT=3000 if something else on the machine already owns 80, or if you run
# the app behind a proxy on the same host.
#
# HOST binds the interface. 127.0.0.1 accepts only local connections, which is
# right when a proxy or a Cloudflare Tunnel on the same machine is the only
# thing that should reach it.
PORT="80"
HOST="0.0.0.0"

# Docker only: which host port maps to the container. The app inside the
# container always listens on 3000, so this is the one to change there.
APP_PORT="80"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_pilot?schema=public"

# Docker only: the password for the bundled Postgres. Required — the stack
# refuses to start without it. `npm run setup` generates one and puts the same
# value into DATABASE_URL above, which is what `npm run dev` on the host uses
# against that database. Keep it URL-safe (openssl rand -hex 24): it is pasted
# into a connection string. The containers build their own DATABASE_URL from
# it, so the line above does not apply inside them.
#
# Postgres reads it only when its volume is first created. Changing it later
# means `ALTER USER` as well — see docs/DEPLOYMENT.md.
POSTGRES_PASSWORD=""

# Docker only: the host port the bundled Postgres is published on. Always bound
# to 127.0.0.1, so it is never reachable from another machine.
# POSTGRES_HOST_PORT="5432"

# Signs session cookies. At least 32 characters — a production server refuses
# to start with less. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Encrypts access tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Rotating this key makes every stored token unreadable — accounts must be
# reconnected. See docs/DEPLOYMENT.md.
ENCRYPTION_KEY=""

# "true" only when a proxy in front of the app (Cloudflare, nginx, a tunnel) sets
# cf-connecting-ip / X-Forwarded-For. Unset, those headers are ignored, because
# anyone reaching the app directly can write them. See docs/DEPLOYMENT.md.
TRUST_PROXY="false"
