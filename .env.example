# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------
#
# Almost everything below can also be set at runtime on Settings -> Configuration,
# and a value set there wins over the one here. This file is the bootstrap and
# the fallback: enough to start the app, and what it falls back to when an
# override is cleared.
#
# Three things can only live here, because they cannot live in the database:
#
#   DATABASE_URL    reads the settings table
#   ENCRYPTION_KEY  protects the secrets stored inside it
#   SESSION_SECRET  cannot be rotated from inside a session
#
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Where the app is reachable, as the public sees it. Must match the Facebook
# OAuth redirect host exactly (scheme included) — Facebook rejects mismatched
# redirect URIs.
#
# Behind Cloudflare this is the https:// address on your domain, even though
# the app itself serves plain HTTP on the port below. Nothing is derived from
# the incoming request, so this is the app's only idea of where it lives.
APP_URL="https://your.domain"

# The port and interface the web app listens on.
#
# 80 by default, for the common deployment: Cloudflare (or any other proxy)
# terminates HTTPS and forwards to this app over plain HTTP. There is no
# certificate handling in here, so 443 is never this process's port.
#
# Port 80 is privileged. The systemd unit written by scripts/install-debian.sh
# carries the capability to bind it; otherwise grant it once, which is safer
# than running the whole app as root:
#
#   sudo setcap 'cap_net_bind_service=+ep' "$(command -v node)"
#
# Set PORT=3000 if something else on the machine already owns 80, or if you run
# the app behind a proxy on the same host.
#
# HOST binds the interface. 127.0.0.1 accepts only local connections, which is
# right when a proxy or a Cloudflare Tunnel on the same machine is the only
# thing that should reach it.
PORT="80"
HOST="0.0.0.0"

# Docker only: which host port maps to the container. The app inside the
# container always listens on 3000, so this is the one to change there.
APP_PORT="80"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_pilot?schema=public"

# Docker only: the password for the bundled Postgres. Required — the stack
# refuses to start without it. `npm run setup` generates one and puts the same
# value into DATABASE_URL above, which is what `npm run dev` on the host uses
# against that database. Keep it URL-safe (openssl rand -hex 24): it is pasted
# into a connection string. The containers build their own DATABASE_URL from
# it, so the line above does not apply inside them.
#
# Postgres reads it only when its volume is first created. Changing it later
# means `ALTER USER` as well — see docs/DEPLOYMENT.md.
POSTGRES_PASSWORD=""

# Docker only: the host port the bundled Postgres is published on. Always bound
# to 127.0.0.1, so it is never reachable from another machine.
# POSTGRES_HOST_PORT="5432"

# Signs session cookies. At least 32 characters — a production server refuses
# to start with less. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Encrypts access tokens at rest (AES-256-GCM).
# Must be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Rotating this key makes every stored token unreadable — accounts must be
# reconnected. See docs/DEPLOYMENT.md.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Facebook app credentials (developers.facebook.com → your app → Settings)
# ---------------------------------------------------------------------------

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Graph API version to pin. Bumping this is a deliberate act: Meta ships
# breaking changes between versions and each is supported for ~2 years.
# v26.0 is the latest. Page reviews are read on v21.0 until it expires on 21 January 2027.
FACEBOOK_GRAPH_VERSION="v26.0"

# Permissions requested during login. These are what Pages publishing and
# analytics need; the feature switches below add their own.
FACEBOOK_SCOPES="pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,read_insights,business_management"

# Base URL for the Graph API. Only set this to point at a stub or a recording
# proxy (the test suite does); leave it unset in production.
# FACEBOOK_GRAPH_BASE_URL="https://graph.facebook.com"

# Leave this off. Meta removed the Groups API from every API version on
# 22 April 2024: publish_to_groups and groups_access_member_info no longer
# exist, and no app can publish to a Group. The switch is kept so an old
# configuration does not fail to load, but it no longer requests those scopes.
FACEBOOK_ENABLE_GROUPS="false"

# Analytics-only permissions, each reviewed separately by Meta. Requesting one
# the app has not been approved for makes the whole consent dialog fail, so
# they are off until your app review is through.
#
#   MESSAGING  -> pages_messaging, pages_manage_metadata (the Page inbox tab)
#   INSTAGRAM  -> instagram_basic, instagram_manage_insights
#   ADS        -> ads_read (read-only; ads_management is never requested)
#
# The Instagram and Ads worker jobs only run when their flag is on.
FACEBOOK_ENABLE_MESSAGING="false"
FACEBOOK_ENABLE_INSTAGRAM="false"
FACEBOOK_ENABLE_ADS="false"

# ---------------------------------------------------------------------------
# Scheduler worker
# ---------------------------------------------------------------------------

# How often the worker looks for due posts, in seconds.
SCHEDULER_POLL_SECONDS="30"

# Intervals for the worker's other jobs.
RSS_POLL_MINUTES="15"
EVERGREEN_CHECK_MINUTES="60"
ANALYTICS_REFRESH_HOURS="6"

# Facebook publishes natively scheduled posts on its own and never tells us,
# so we ask. Only affects posts scheduled inside Facebook.
NATIVE_RECONCILE_MINUTES="15"

# How often the full Page insights catalogue is captured.
PAGE_INSIGHTS_HOURS="12"

# Comments, ratings, inbox threads, videos and posts published outside the app.
EDGE_SYNC_HOURS="4"

# Only used when the matching FACEBOOK_ENABLE_* flag above is on.
INSTAGRAM_SYNC_HOURS="12"
ADS_SYNC_HOURS="12"

TOKEN_EXPIRY_CHECK_HOURS="24"

# How many destinations are published to concurrently.
SCHEDULER_CONCURRENCY="4"

# How long an ordinary Graph call may take, and how long sending one photo or
# video may take. A file is not a request that answers in a moment: a timeout
# that is too short looks like a network failure and retries for ever.
GRAPH_TIMEOUT_SECONDS="60"
GRAPH_UPLOAD_TIMEOUT_SECONDS="300"

# Give up after this many attempts on a retryable failure.
SCHEDULER_MAX_ATTEMPTS="5"

# How long a destination may stay mid-publish before another worker takes it
# back, in minutes. Set it above the slowest publish you expect: reclaiming a
# large video upload that is still running can post it twice.
SCHEDULER_STALE_LOCK_MINUTES="15"

# How many rows one CSV bulk upload may schedule. Each row can scrape its link,
# so a very large file makes one request that runs for minutes.
BULK_ROW_LIMIT="500"

# Shared secret for POST /api/cron/tick, the serverless alternative to running
# the long-lived worker. Leave blank to disable that endpoint.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Directory for uploaded files (created on demand).
MEDIA_DIR="./media"
MAX_UPLOAD_MB="25"

# ---------------------------------------------------------------------------
# Email (SMTP such as Gmail, or Resend)
# ---------------------------------------------------------------------------

# Leave blank in development: the app runs normally and logs each message as
# "skipped" rather than failing. auto = SMTP when SMTP_PASSWORD is set, else Resend.
EMAIL_PROVIDER="auto"
# Gmail: smtp.gmail.com, port 465, your Gmail address, and an app password
# (Google account → Security → App passwords; needs 2-Step Verification).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""
EMAIL_FROM="MS Social Pilot <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Other social networks
# ---------------------------------------------------------------------------

# Bluesky and Mastodon need nothing here. Each of the others appears on the
# Connections screen once its developer app's keys are set. Redirect URL to
# register with each: https://<your domain>/api/networks/<network>/callback
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
THREADS_CLIENT_ID=""
THREADS_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI captions (Claude)
# ---------------------------------------------------------------------------

# Without a key the composer hides the AI tools entirely.
# AI_PROVIDER: auto (first key set: Anthropic, OpenAI, Gemini) | anthropic | openai | gemini
AI_PROVIDER="auto"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
# Blank = the first model the provider lists (fetched from the provider, never typed in).
AI_MODEL=""

# Per workspace, per hour. Stops a stuck client loop running up a bill.
AI_RATE_LIMIT_PER_HOUR="100"

# Whole installation, per calendar month, in US dollars. 0 = no budget.
AI_MONTHLY_BUDGET_USD="0"
# Extra or corrected model prices, USD per million tokens: model=input/output, comma-separated.
AI_PRICE_OVERRIDES=""

# ---------------------------------------------------------------------------
# Link shortener
# ---------------------------------------------------------------------------

# Bare host, e.g. "go.yourdomain.com", pointed at this app. Blank puts short
# links under APP_URL/l/<slug>, which works but is less tidy in a post.
SHORTENER_DOMAIN=""

# ---------------------------------------------------------------------------
# Interface language
# ---------------------------------------------------------------------------

# Fallback when a visitor has no account and sends no Accept-Language: en | fr
DEFAULT_LOCALE="en"

# Whether a stranger may create an account. Off by default: this app has to be
# reachable from the internet for Facebook to call back, so an open sign-up form
# is open to everyone who finds it. The first account is always allowed, and
# anyone holding an invitation always may.
OPEN_REGISTRATION="false"

# Failed sign-ins allowed for one address, and from one client, per window.
# Checking a password is deliberately slow, so an unlimited sign-in form is both
# a way to guess passwords and a cheap way to load the server.
LOGIN_ATTEMPTS="10"
LOGIN_WINDOW_MINUTES="15"

# "true" only when a proxy in front of the app (Cloudflare, nginx, a tunnel) sets
# cf-connecting-ip / X-Forwarded-For. Unset, those headers are ignored, because
# anyone reaching the app directly can write them. See docs/DEPLOYMENT.md.
TRUST_PROXY="false"
