+export const ASYNC_POST_EXPORT_CONFIG = [entry({ key: 'publishing.asyncExportPolicy', group: 'Publishing · Export', label: 'Background CSV exports', description: 'Expiry, worker lease and per-member queued job ceiling. CSV row/byte/batch limits use existing Publishing export controls.', kind: 'json', defaultValue: { expiryMs: 86400000, leaseMs: 300000, maxPendingPerUser: 3 }, schema: asyncExportPolicySchema, consumption: 'active' })] as const;
