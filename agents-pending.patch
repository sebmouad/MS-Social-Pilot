+'use client';
+import { useState, useTransition } from 'react';
+import { IconSparkles } from '@tabler/icons-react';
+import type { Agent } from '../server/service';
+import { AutoTextarea } from '@/components/AutoTextarea';
+import { Button } from '@/components/Button';
+import type { AgentCopy } from '../copy';
+
+type Result = { agents?: Agent[]; suggestion?: string; error?: string };
+/** Host passes a server action calling writingAgents with its authenticated actor. */
+export function AgentsScreen({ agents, copy: t, execute }: { agents: Agent[]; copy: AgentCopy; execute: (input: unknown) => Promise<Result> }) {
+ const [pending, start] = useTransition();
+ const [items, setItems] = useState(agents); const [selected, setSelected] = useState(agents[0]?.id ?? '');
+ const [name, setName] = useState(''); const [instructions, setInstructions] = useState(''); const [voice, setVoice] = useState('');
+ const [text, setText] = useState(''); const [kind, setKind] = useState('post'); const [suggestion, setSuggestion] = useState(''); const [error, setError] = useState(false);
+ function run(input: unknown, saved = false) { start(async () => { setError(false); try { const result = await execute(input); if (result.error) { setError(true); return; } if (result.suggestion) setSuggestion(result.suggestion); if (saved) { const next = await execute({ action: 'list' }); if (next.agents) { setItems(next.agents); setSelected(next.agents.find(a => a.name === name)?.id ?? ''); } } } catch { setError(true); } }); }
+ return <section data-module="publishing" aria-busy={pending}>
+  <header><h1><IconSparkles aria-hidden="true" /> {t.title}</h1><p>{t.intro}</p></header>
+  {error ? <p role="alert">{t.failed}</p> : null}
+  <div className="ui-panel"><h2>{t.empty}</h2><form onSubmit={event => { event.preventDefault(); run({ action: 'save', name, instructions, voice, confirmation: `SAVE ${name.trim()}` }, true); }}>
+   <label className="ui-field">{t.name}<input className="ui-input" value={name} onChange={e => setName(e.target.value)} required /></label>
+   <label className="ui-field">{t.instructions}<AutoTextarea className="ui-input" value={instructions} onChange={e => setInstructions(e.target.value)} required /></label>
+   <label className="ui-field">{t.voice}<AutoTextarea className="ui-input" value={voice} onChange={e => setVoice(e.target.value)} /></label>
+   <Button type="submit" disabled={pending}>{pending ? t.busy : t.save}</Button>
+  </form></div>
+  {items.length ? <div className="ui-panel"><h2>{t.draft}</h2><form onSubmit={e => { e.preventDefault(); run({ action: 'draft', id: selected, text, kind, confirmation: `DRAFT ${selected}` }); }}>
+   <label className="ui-field">{t.choose}<select className="ui-input" value={selected} onChange={e => setSelected(e.target.value)} required>{items.map(a => <option key={a.id} value={a.id}>{a.name}</option>)}</select></label>
+   <label className="ui-field">{t.material}<AutoTextarea className="ui-input" value={text} onChange={e => setText(e.target.value)} required /></label>
+   <label className="ui-field">{t.draft}<select className="ui-input" value={kind} onChange={e => setKind(e.target.value)}><option value="post">{t.post}</option><option value="reply">{t.reply}</option></select></label>
+   <Button type="submit" disabled={pending}>{pending ? t.busy : t.draft}</Button>
+  </form></div> : null}
+  <div aria-live="polite">{suggestion ? <article><h2>{t.suggestion}</h2><p>{t.review}</p><p style={{ whiteSpace: 'pre-wrap', overflowWrap: 'anywhere' }}>{suggestion}</p></article> : null}</div>
+ </section>;
+}
