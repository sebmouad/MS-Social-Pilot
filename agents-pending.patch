+import type { McpToolGroup } from '@/server/mcp/kit';
+import { writingAgents } from './server/service';
+export const AGENTS_MCP: readonly McpToolGroup[] = [{ id: 'agents', tools: [{ name: 'writing_agents', description: 'List, save, delete a workspace writing brief or draft a suggestion for review. Mutations require confirmation: SAVE <name>, DELETE <id>, DRAFT <id>.', inputSchema: { type: 'object', required: ['action'], properties: { action: { enum: ['list','save','delete','draft'] }, id: { type: 'string' }, name: { type: 'string' }, instructions: { type: 'string' }, voice: { type: 'string' }, text: { type: 'string' }, kind: { enum: ['post','reply'] }, confirmation: { type: 'string' } }, additionalProperties: false } }], features: { writing_agents: 'publishing/posts' }, writeTools: ['writing_agents'], selfLockedWrites: ['writing_agents'], scope: { workspaceTools: ['writing_agents'] }, execute: (viewer, _name, args) => writingAgents({ userId: viewer.userId, workspaceId: viewer.workspaceId, permissionCeiling: viewer.permissions }, args) }];
