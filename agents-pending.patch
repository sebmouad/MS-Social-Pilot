diff --git a/rebuild/src/modules/agents/server/service.ts b/rebuild/src/modules/agents/server/service.ts
new file mode 100644
index 00000000..3ff92a38
--- /dev/null
+++ b/rebuild/src/modules/agents/server/service.ts
@@ -0,0 +1,54 @@
+import { randomUUID } from 'node:crypto';
+import { z } from 'zod';
+import { prisma } from '@/server/data';
+import { runtimeConfig } from '@/server/config/store';
+import { OperationError } from '@/lib/operation-error';
+import { authorizeAi, type AiActor } from '@/modules/ai/server/access';
+import { runAssist, type AiDeps } from '@/modules/ai/server/ai';
+import { agentPolicySchema } from '../config';
+export type Agent = { id: string; name: string; instructions: string; voice: string };
+export const agentRequest = z.discriminatedUnion('action', [
+ z.object({ action: z.literal('list') }).strict(),
+ z.object({ action: z.literal('save'), id: z.string().optional(), name: z.string(), instructions: z.string(), voice: z.string(), confirmation: z.string() }).strict(),
+ z.object({ action: z.literal('delete'), id: z.string(), confirmation: z.string() }).strict(),
+ z.object({ action: z.literal('draft'), id: z.string(), text: z.string().min(1), kind: z.enum(['post', 'reply']), confirmation: z.string() }).strict(),
+]);
+/** All interfaces use this service. Suggestions are never sent, scheduled or published. */
+export async function writingAgents(actor: AiActor, raw: unknown, deps: AiDeps = {}) {
+ const input = agentRequest.parse(raw);
+ await authorizeAi(actor, 'publishing/posts', input.action === 'list' ? 'read' : 'write');
+ const policy = agentPolicySchema.parse(await runtimeConfig('agents.policy'));
+ if (input.action === 'list') return { agents: await prisma.$queryRaw<Agent[]>`SELECT id, name, instructions, voice FROM rebuild_writing_agents WHERE "workspaceId" = ${actor.workspaceId} ORDER BY name, id LIMIT ${policy.maxAgents}` };
+ const expected = input.action === 'save' ? `SAVE ${input.name.trim()}` : `${input.action.toUpperCase()} ${input.id}`;
+ if (input.confirmation !== expected) throw new OperationError('invalid_request', 'Confirm this writing agent action.');
+ if (input.action === 'draft') {
+  const rows = await prisma.$queryRaw<Agent[]>`SELECT id, name, instructions, voice FROM rebuild_writing_agents WHERE id = ${input.id} AND "workspaceId" = ${actor.workspaceId}`;
+  if (!rows[0]) throw new OperationError('not_found', 'Writing agent unavailable.');
+  const a = rows[0];
+  const result = await runAssist(actor, { kind: 'improve', text: JSON.stringify({ task: input.kind, brief: a.instructions, voice: a.voice, material: input.text }) }, deps);
+  return { suggestion: result.text, reviewRequired: true };
+ }
+ return prisma.$transaction(async tx => {
+  await tx.$queryRaw`SELECT pg_advisory_xact_lock(hashtext(${`agents:${actor.workspaceId}`}))::text`;
+  await authorizeAi(actor, 'publishing/posts', 'write');
+  let id: string;
+  if (input.action === 'save') {
+   const data = z.object({ name: z.string().trim().min(1).max(policy.nameCharacters), instructions: z.string().trim().min(1).max(policy.instructionsCharacters), voice: z.string().trim().max(policy.voiceCharacters) }).parse(input);
+   id = input.id ?? randomUUID();
+   if (input.id) {
+    const changed = await tx.$executeRaw`UPDATE rebuild_writing_agents SET name = ${data.name}, instructions = ${data.instructions}, voice = ${data.voice}, "updatedAt" = now() WHERE id = ${id} AND "workspaceId" = ${actor.workspaceId}`;
+    if (!changed) throw new OperationError('not_found', 'Writing agent unavailable.');
+   } else {
+    const counts = await tx.$queryRaw<Array<{ count: bigint }>>`SELECT count(*)::bigint AS count FROM rebuild_writing_agents WHERE "workspaceId" = ${actor.workspaceId}`;
+    if (Number(counts[0].count) >= policy.maxAgents) throw new OperationError('conflict', 'Remove an unused writing agent before adding another.');
+    await tx.$executeRaw`INSERT INTO rebuild_writing_agents (id, "workspaceId", "createdById", name, instructions, voice) VALUES (${id}, ${actor.workspaceId}, ${actor.userId}, ${data.name}, ${data.instructions}, ${data.voice})`;
+   }
+  } else {
+   id = input.id;
+   const changed = await tx.$executeRaw`DELETE FROM rebuild_writing_agents WHERE id = ${id} AND "workspaceId" = ${actor.workspaceId}`;
+   if (!changed) throw new OperationError('not_found', 'Writing agent unavailable.');
+  }
+  await tx.$executeRaw`INSERT INTO activity_logs (id, "workspaceId", "actorId", action, detail, "createdAt") VALUES (${randomUUID()}, ${actor.workspaceId}, ${actor.userId}, ${`agents.${input.action}`}, ${JSON.stringify({ id })}::jsonb, now())`;
+  return { id, ok: true };
+ });
+}
