+      { ...row(`${level}-latest`, '2026-10-16', '20.75', level), impressions: 900, clicks: 99, reach: 600, cpc: 20.75 / 99, cpm: 20.75 * 1000 / 900, ctr: 11, cpp: 20.75 / 600, frequency: 1.5, actions: [{ action_type: 'link_click', value: '99' }] },
