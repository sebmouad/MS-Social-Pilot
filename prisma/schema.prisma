// MS Social Pilot — data model.
//
// PostgreSQL. Status fields are native enums and structured payloads are native
// Json, so the database rejects invalid values rather than trusting application
// code to have validated them.
//
// See docs/PROJECT_SCHEMA.md for the design this implements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  owner
  admin
  editor
  contributor
  /// Reads everything in its channels, changes nothing (owner approved, 2026-10-12).
  viewer
  /// The agency's customer: calendar, approvals, and what `clientAccess` opens. Never promoted.
  client
}

enum TargetType {
  page
  group
  /// An Instagram Business account, published through the Page it is linked to.
  instagram
  /// Other networks, each published through `src/lib/networks`.
  bluesky
  mastodon
  linkedin
  threads
  x
  pinterest
  telegram
  youtube
  tiktok
}

enum PostStatus {
  draft
  pending_approval
  rejected
  scheduled
  publishing
  published
  partially_failed
  failed
  cancelled
}

enum PostTargetStatus {
  pending
  processing
  published
  /// Handed to Facebook with a scheduled_publish_time: it exists remotely but
  /// is not live yet, and our scheduler must leave it alone.
  scheduled_remote
  failed
  cancelled
  skipped
}

enum PublishMode {
  /// Publish as soon as the request is handled.
  immediate
  /// Hold in our database; the worker publishes at scheduledAt.
  worker
  /// Hand the schedule to Facebook via scheduled_publish_time (Pages only).
  native
}

enum ApprovalStatus {
  not_required
  pending
  approved
  rejected
}

enum MediaKind {
  image
  video
}

enum StorageProvider {
  local
  s3
}

enum Locale {
  en
  fr
}

enum EmailStatus {
  sent
  failed
  skipped
}

enum AiGenerationKind {
  generate
  improve
  hashtags
  plan
  /// The plain-language summary at the top of a scheduled report.
  recap
  /// A post translated for a Page's audience (G11).
  translate
  /// The mood of a batch of new comments (H15).
  sentiment
  /// A description of a photo for screen readers (H5).
  altText
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  /// The subscriber's plan (Root › Plans). Null: no limits, as before plans existed.
  planId                String?
  plan                  Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Channels bought on top of the plan's own.
  extraChannels         Int       @default(0)
  email                 String    @unique
  name                  String
  passwordHash          String
  locale                Locale    @default(en)
  /// Which workspace to open on sign-in. Not a security boundary — membership
  /// is always re-checked — just a convenience.
  lastActiveWorkspaceId String?
  /// The person who installed this server, and the only one who may change its
  /// instance-wide configuration (Graph credentials, feature switches, setup).
  /// Deliberately not derived from workspace roles: anyone who registers gets
  /// a workspace of their own to own, so "owner somewhere" admits everybody.
  /// Set for the first account only, under a lock — see `registerUser`.
  isInstanceOwner       Boolean   @default(false)
  /// Set by root: the account cannot sign in and its sessions are gone.
  disabledAt            DateTime?
  /// Authenticator app (TOTP) secret, encrypted. Null until set up.
  totpSecret            String?
  /// A secret being set up, kept aside until a code proves it was scanned.
  totpPendingSecret     String?
  totpEnabledAt         DateTime?
  /// The last time step accepted, so a code cannot be used twice.
  totpLastStep          Int?
  /// Page metrics this person pinned as tiles on the analysis (`metric::period`).
  pinnedMetrics         String[]  @default([])
  /// Fingerprints of browsers this person has signed in from, so a sign-in
  /// from a new one can be emailed (`src/lib/sessions.ts`). Newest last, capped.
  knownDevices          String[]  @default([])
  /// The look picked in Settings → Account (`src/lib/themes.ts`).
  theme                 String    @default("facebook")
  /// When the address was proven (S3): a link opened, an invitation used, or
  /// root's own. Null only for a self-service sign-up that has not clicked yet.
  emailVerifiedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships          Membership[]
  sessions             Session[]
  posts                Post[]
  postVersions         PostVersion[]
  postNotes            PostNote[]
  calendarFeeds        CalendarFeed[]
  chartNotes           ChartNote[]
  submittedPosts       Post[]                @relation("PostSubmitter")
  reviewedPosts        Post[]                @relation("PostReviewer")
  sentInvitations      Invitation[]          @relation("InvitationSender")
  notificationSettings NotificationSetting[]
  notificationMutes    NotificationMute[]
  aiGenerations        AiGeneration[]
  settingChanges       AppSetting[]
  apiTokens            ApiToken[]
  savedViews           SavedView[]
  inboxNotes           InboxNote[]
  rootActions          RootActivity[]
  recoveryCodes        RecoveryCode[]
  trustedDevices       TrustedDevice[]
  passkeys             Passkey[]
  clientInvitations    ClientInvitation[]    @relation("ClientInvitationSender")
  emailTokens          EmailToken[]

  @@map("users")
}

/// A one-time link sent by email (S3): prove the address, or choose a new
/// password. Only the sha256 is kept; used or expired links do nothing.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  /// `verify` or `reset`.
  purpose   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  /// Set between the password and the second step: 'verify' or 'enroll'.
  /// Such a session signs nobody in; only the two-step screens read it.
  pending   String?
  /// The WebAuthn challenge being answered by a passkey, if any.
  challenge String?
  /// The browser it was opened from, for the list of signed-in devices.
  userAgent  String?
  /// Known only behind a trusted proxy (`TRUST_PROXY`).
  ip         String?
  /// Two-letter country, from Cloudflare's header when it is there.
  country    String?
  /// Bumped at most every few minutes while the session is used.
  lastSeenAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One client or brand. An agency has several; a single business has one.
model Workspace {
  id            String @id @default(cuid())
  name          String
  slug          String @unique
  timezone      String @default("UTC")
  defaultLocale Locale @default(en)
  /// First column of the calendar and first day of a reporting week: 0 Sunday … 6 Saturday.
  weekStartsOn  Int    @default(1)
  /// Business hours (NEXT_PHASES H11): inbox response times count only these.
  /// Days 0 Sunday … 6 Saturday; empty counts every hour.
  businessDays  Int[]  @default([])
  businessStart Int    @default(9)
  businessEnd   Int    @default(18)

  /// Turns the approval workflow on for this client.
  requiresApproval Boolean @default(false)

  /// Set by root: members cannot use the workspace (root still can).
  suspendedAt     DateTime?
  /// Modules root has switched off for this workspace (`src/lib/modules.ts` keys).
  disabledModules String[]  @default([])
  /// Set by root: API keys, MCP and outgoing webhooks, for the workspace owner only.
  developerFeatures Boolean @default(false)
  /// What members with the client role may open beyond calendar and approvals: analytics, inbox, library, connect.
  clientAccess      String[] @default(["analytics"])

  // Light branding, used on client-facing reports.
  logoUrl        String?
  accentColor    String?
  /// Report cover and footer, typed once and printed on every report.
  reportTitle    String?
  reportSubtitle String?
  reportFooter   String?

  // Link tagging defaults, applied at publish time.
  utmSource           String?
  utmMedium           String?
  utmCampaignTemplate String?
  shortenerEnabled    Boolean @default(false)

  /// Spam-risk guard (NEXT_PHASES G6): the same link or near-identical text
  /// should not reach several Pages of one network closer together than this.
  /// 0 turns the warning off.
  spamGapMinutes Int @default(20)
  /// Undo send (H10): "Publish now" waits this many seconds, with an Undo,
  /// before the worker publishes. 0 publishes during the request.
  undoSendSeconds Int @default(30)
  /// Best time per Page (G10): "suggest" shows good times on the queue screen;
  /// "apply" also lets a weekly job add them as the Page's own queue times.
  bestTimeMode   String    @default("suggest")
  /// When the weekly best-time job last looked at this workspace.
  bestTimesRunAt DateTime?
  /// Content mix (H1): the worker schedules labelled drafts into queue times
  /// to meet each Page's weekly mix. Off: the mix is only shown and warned on.
  mixAutoFill    Boolean   @default(false)

  /// Default target audience (H0) for Pages that set none of their own.
  audienceCountries String[] @default([])
  audienceLanguages String[] @default([])
  audienceTimezone  String?
  audienceCalendars String[] @default([])

  // AI caption defaults, fed into the prompt.
  aiEnabled    Boolean @default(true)
  aiTone       String?
  aiBrandVoice String?
  /// Negative-comment alert (H15): the worker reads the mood of new comments with AI.
  watchNegativeComments Boolean @default(false)
  /// Trending topics (H7): words that keep the list to the team's subjects; empty shows every topic.
  trendKeywords String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  socialAccounts       SocialAccount[]
  targets              Target[]
  posts                Post[]
  media                Media[]
  queueSlots           QueueSlot[]
  pageGroups           PageGroup[]
  labels               Label[]
  snippets             Snippet[]
  calendarFeeds   CalendarFeed[]
  pageGoals            PageGoal[]
  chartNotes           ChartNote[]
  postTemplates        PostTemplate[]
  savedReplies         SavedReply[]
  savedViews           SavedView[]
  inboxNotes           InboxNote[]
  bioPage              BioPage?
  captionTests         CaptionTest[]
  shareLinks           ShareLink[]
  reportTemplates      ReportTemplate[]
  reportSchedules      ReportSchedule[]
  apiTokens            ApiToken[]
  chatChannels         ChatChannel[]
  webhookEndpoints     WebhookEndpoint[]
  contentMixRules      ContentMixRule[]
  activityLogs         ActivityLog[]
  invitations          Invitation[]
  feedSources          FeedSource[]
  shortLinks           ShortLink[]
  aiGenerations        AiGeneration[]
  notificationSettings NotificationSetting[]
  emailLogs            EmailLog[]
  instagramAccounts    InstagramAccount[]
  adAccounts           AdAccount[]
  moderationRules      ModerationRule[]
  exports              WorkspaceExport[]
  keyDates             KeyDate[]
  seasonalModes        SeasonalMode[]
  moderationActions    ModerationAction[]

  @@map("workspaces")
}

model Membership {
  id              String        @id @default(cuid())
  userId          String
  workspaceId     String
  role            WorkspaceRole @default(contributor)
  /// False once an admin has limited this member to the Pages in `pages`.
  /// Owners and admins always see every Page, whatever this says.
  allPages        Boolean       @default(true)
  /// Modules root has switched off for this member, on top of the workspace's.
  disabledModules String[]      @default([])
  createdAt       DateTime      @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages     MemberPageAccess[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// A pending invitation to join a workspace. The token is stored hashed, like
/// sessions, so a database dump cannot be used to join someone's workspace.
model Invitation {
  id               String        @id @default(cuid())
  workspaceId      String
  email            String
  role             WorkspaceRole @default(contributor)
  tokenHash        String        @unique
  invitedById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id])

  // One live invitation per address per workspace; re-inviting updates this row.
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Facebook connections
// ---------------------------------------------------------------------------

/// A connected Facebook user. Holds the long-lived *user* access token, which
/// is what page tokens and group posting are derived from. Encrypted at rest.
model SocialAccount {
  id                  String    @id @default(cuid())
  workspaceId         String
  provider            String    @default("facebook")
  providerUserId      String
  name                String
  pictureUrl          String?
  accessToken         String
  /// Encrypted, for networks whose access tokens expire within hours.
  refreshToken        String?
  tokenExpiresAt      DateTime?
  scopes              String    @default("")
  /// Per-network detail: a Mastodon server and its app keys, a Bluesky PDS.
  meta                Json?
  invalidatedAt       DateTime?
  invalidReason       String?
  lastSyncedAt        DateTime?
  /// Set when an expiry warning has been emailed, so the daily job warns once
  /// per token rather than every day until it dies.
  expiryWarningSentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets           Target[]
  instagramAccounts InstagramAccount[]
  adAccounts        AdAccount[]

  @@unique([workspaceId, provider, providerUserId])
  @@index([workspaceId])
  @@map("social_accounts")
}

/// A destination: a Facebook Page or Group.
model Target {
  id              String     @id @default(cuid())
  workspaceId     String
  /// Nullable so disconnecting an account can drop the credentials without
  /// cascading away published-post history.
  socialAccountId String?
  type            TargetType
  providerId      String
  name            String
  pictureUrl      String?
  category        String?
  accessToken     String?
  enabled         Boolean    @default(true)
  canPublish      Boolean    @default(true)
  publishBlocker  String?
  lastSyncedAt    DateTime?
  /// When the worker first read this Page's insights and edges. Empty for a
  /// Page just connected: the `firstRead` job takes those first, within
  /// minutes, rather than leaving its screens empty until the next pass.
  firstReadAt     DateTime?

  /// How this Page sounds, for AI writing; the workspace's voice when empty.
  brandVoice  String?
  /// Per-Page link tagging, each overriding the workspace's when set.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  /// Target audience (H0). Empty lists and null follow the workspace's defaults.
  audienceCountries String[] @default([])
  /// BCP-47 tags, e.g. fr-FR, en-US.
  audienceLanguages String[] @default([])
  audienceTimezone  String?
  audienceCalendars String[] @default([])
  /// Watermark put on this Page's images when they are published (G13):
  /// { mediaId?, text?, position, opacity, size }. Null for none.
  watermark         Json?

  // Read straight off the Page object: no insights permission, no date range.
  fanCount          Int?
  followersCount    Int?
  talkingAboutCount Int?
  profileSyncedAt   DateTime?
  /// Last negative-comment alert for this Page (H15); one a day at most.
  negativeAlertAt   DateTime?

  /// Last time the worker saw a post scheduled ahead for this Page.
  queueFilledAt        DateTime?
  /// When members were told the Page has nothing scheduled any more; told
  /// again only after the queue has filled since.
  queueEmptyNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount      SocialAccount?       @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  postTargets        PostTarget[]
  groups             PageGroupTarget[]
  memberAccess       MemberPageAccess[]
  notificationMutes  NotificationMute[]
  queueSlots         QueueSlot[]
  contentMixRules    ContentMixRule[]
  insights           PageInsight[]
  availability       MetricAvailability[]
  reviews            PageReview[]
  conversations      Conversation[]
  externalPosts      ExternalPost[]
  goals              PageGoal[]
  chartNotes         ChartNote[]
  videos             PageVideo[]
  instagramAccounts  InstagramAccount[]
  /// Why publishing is blocked, as a code the interface can translate. The
  /// sentence in `publishBlocker` stays as the fallback.
  publishBlockerCode String?

  /// Set once the whole rating history has been walked back to its start. One
  /// fetch reaches five hundred, so a Page with more is read over several
  /// syncs and the average is partial until this is true.
  reviewsBackfilled Boolean @default(false)

  shortLinks      ShortLink[]
  @@unique([workspaceId, providerId])
  @@index([socialAccountId])
  @@map("targets")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Post {
  id                       String   @id @default(cuid())
  workspaceId              String
  authorId                 String
  message                  String   @default("")
  /// Posted as the Page under the post the moment it goes out: where a link,
  /// hashtags or a call to action go without crowding the post itself.
  firstComment             String?
  /// Minutes to wait after the post goes out before the first comment does.
  /// Zero posts it straight away.
  firstCommentDelayMinutes Int      @default(0)
  /// `post` (a feed post), `reel` or `story`. See `src/lib/facebook/publish.ts`.
  format                   String   @default("post")
  link                     String?
  /// Cached Open Graph metadata for `link`.
  linkPreview              Json?
  /// Every media id and storage key this post references, flattened out of
  /// `media` so "which posts use this file?" is an indexed lookup rather than a
  /// scan of every post's Json.
  mediaKeys                String[] @default([])
  /// Ordered attachments (PostMedia[]).
  media                    Json     @default("[]")

  status      PostStatus  @default(draft)
  publishMode PublishMode @default(worker)
  scheduledAt DateTime?
  timezone    String      @default("UTC")
  publishedAt DateTime?

  // --- Approval workflow ---
  approvalStatus ApprovalStatus @default(not_required)
  submittedById  String?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?

  // --- Evergreen recycling ---
  /// Alternate wordings, rotated between repeats. Facebook rejects identical
  /// repeated content with error 506, so recycling without variants fails.
  variants         Json      @default("[]")
  recycleEnabled   Boolean   @default(false)
  recycleEveryDays Int?
  recycleLimit     Int?
  recycleCount     Int       @default(0)
  recycleNextAt    DateTime?
  /// Set on a recycled copy, pointing at the post it was cloned from.
  originPostId     String?

  /// Set when this post was created from an RSS item.
  sourceFeedItemId String?

  /// Caption A/B test (NEXT_PHASES G9): the test this post is one caption of,
  /// and which one ("A", "B", …).
  captionTestId String?
  captionLabel  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User             @relation(fields: [authorId], references: [id])
  submitter       User?            @relation("PostSubmitter", fields: [submittedById], references: [id])
  reviewer        User?            @relation("PostReviewer", fields: [reviewedById], references: [id])
  targets         PostTarget[]
  shortLinks      ShortLink[]
  labels          PostLabel[]
  reviewDecisions ReviewDecision[]
  feedItem        FeedItem?        @relation(fields: [sourceFeedItemId], references: [id])
  captionTest     CaptionTest?     @relation(fields: [captionTestId], references: [id], onDelete: SetNull)
  versions        PostVersion[]
  notes           PostNote[]

  @@index([workspaceId, status])
  @@index([mediaKeys], type: Gin)
  @@index([scheduledAt])
  @@index([workspaceId, approvalStatus])
  @@index([recycleEnabled, recycleNextAt])
  @@index([workspaceId, scheduledAt])
  @@index([authorId])
  @@index([originPostId])
  @@index([sourceFeedItemId])
  @@index([captionTestId])
  @@map("posts")
}

/// A post as it stood after one save (NEXT_PHASES H9): what it said, where and
/// when it was going, and who saved it. Compared and restored from Compose.
model PostVersion {
  id           String    @id @default(cuid())
  postId       String
  authorId     String?
  createdAt    DateTime  @default(now())
  message      String
  firstComment String?
  link         String?
  media        Json      @default("[]")
  format       String
  targetIds    String[]  @default([])
  labelIds     String[]  @default([])
  scheduledAt  DateTime?
  timezone     String

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_versions")
}

/// A team-only note on a post (NEXT_PHASES H8). Never published; members it
/// @mentions are emailed.
/// A private note on an inbox item (comment or conversation), for the team only.
model InboxNote {
  id          String   @id @default(cuid())
  workspaceId String
  /// "comment" or "message", with the id of that row.
  kind        String
  itemId      String
  authorId    String?
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, itemId])
  @@map("inbox_notes")
}

/// A link-in-bio page: one public address with a few links, per workspace.
model BioPage {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  /// The public address: /bio/<slug>.
  slug        String   @unique
  title       String
  description String?
  avatarUrl   String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links     BioLink[]

  @@map("bio_pages")
}

model BioLink {
  id       String @id @default(cuid())
  pageId   String
  label    String
  url      String
  position Int    @default(0)
  clicks   Int    @default(0)

  page BioPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, position])
  @@map("bio_links")
}

model PostNote {
  id         String   @id @default(cuid())
  postId     String
  authorId   String?
  body       String
  mentionIds String[] @default([])
  createdAt  DateTime @default(now())

  post   Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_notes")
}

/// A member's private calendar subscription (NEXT_PHASES H19): an ICS address
/// for Google Calendar or Outlook, narrowed to some Pages or a group, and
/// always to what the member may still see when it is read.
/// A Page's monthly target for one figure (NEXT_PHASES H12): followers
/// gained, views, engagement or posts. The same target applies every month
/// until it is changed.
model PageGoal {
  id          String   @id @default(cuid())
  workspaceId String
  targetId    String
  /// followers | views | engagements | posts (src/lib/goals.ts).
  metric      String
  target      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric])
  @@index([workspaceId])
  @@map("page_goals")
}

/// An annotation on analytics timelines (NEXT_PHASES H13): "Campaign
/// started", "Page renamed". For one Page, or every Page when targetId is null.
model ChartNote {
  id          String   @id @default(cuid())
  workspaceId String
  targetId    String?
  /// The day it marks, yyyy-MM-dd on the workspace's calendar.
  day         String
  label       String
  /// A palette key (src/lib/palette.ts).
  color       String   @default("blue")
  authorId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  page      Target?   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, day])
  @@map("chart_notes")
}

model CalendarFeed {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  /// What the selection was called when it was made ("All Pages", a group).
  name        String
  /// sha256 of the token; the address is shown once.
  tokenHash   String    @unique
  /// Empty with no group: every Page the member may see.
  pageIds     String[]  @default([])
  groupId     String?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@map("calendar_feeds")
}

/// The unit of work the scheduler claims and publishes: one post, one
/// destination. This is what makes partial success expressible.
model PostTarget {
  id       String           @id @default(cuid())
  postId   String
  targetId String
  status   PostTargetStatus @default(pending)
  /// Text written for this destination alone; null publishes the post's own text.
  messageOverride String?

  remotePostId       String?
  remoteUrl          String?
  /// The first comment, once Facebook accepted it.
  firstCommentId     String?
  /// When it was last attempted. Set before the call, as the claim that stops
  /// two workers (or two clicks on Retry) from commenting twice.
  firstCommentAt     DateTime?
  /// Why Facebook refused it, until a retry succeeds.
  firstCommentError  String?
  nativeScheduledFor DateTime?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockedBy      String?

  errorCode    String?
  errorMessage String?
  publishedAt  DateTime?
  /// When it was taken down from Facebook from here, after being published.
  removedAt    DateTime?

  /// Last analytics snapshot (PostInsights).
  insights         Json?
  insightsSyncedAt DateTime?
  /// When Facebook said the post no longer exists — deleted or binned on
  /// Facebook. The syncs stop asking about it; what was read stays.
  remoteMissingAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  target   Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  comments PostComment[]

  @@unique([postId, targetId])
  @@index([status, nextAttemptAt])
  @@index([targetId])
  @@index([status, insightsSyncedAt])
  @@map("post_targets")
}

model Media {
  id              String          @id @default(cuid())
  workspaceId     String
  filename        String
  mimeType        String
  size            Int
  kind            MediaKind
  storageProvider StorageProvider @default(local)
  /// Path within the storage backend, or null for externally hosted media.
  storageKey      String?
  checksum        String?
  url             String
  width           Int?
  height          Int?
  /// A copy made at publish time (watermark, crop — G13); hidden from the library.
  derivedFromId   String?
  /// What was done to the source, as a short hash; one copy per variant.
  variant         String?
  createdAt       DateTime        @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  derivedFrom Media?    @relation("MediaVariants", fields: [derivedFromId], references: [id], onDelete: Cascade)
  variants    Media[]   @relation("MediaVariants")

  @@unique([derivedFromId, variant])
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@map("media")
}

/// Recurring publishing times, in workspace-local terms.
model QueueSlot {
  id          String   @id @default(cuid())
  workspaceId String
  /// The Page this time belongs to; null for a time every Page shares.
  targetId    String?
  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek   Int
  hour        Int
  minute      Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target    Target?   @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, targetId, dayOfWeek, hour, minute])
  @@index([workspaceId])
  @@index([targetId])
  @@map("queue_slots")
}

/// A named set of Pages — a client, a brand, a country — used to pick, filter
/// and report on several Pages at once. A Page can be in any number of them.
model PageGroup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// One of the palette keys in `src/lib/page-groups.ts`.
  color       String   @default("blue")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pages           PageGroupTarget[]
  contentMixRules ContentMixRule[]

  @@unique([workspaceId, name])
  @@map("page_groups")
}

model PageGroupTarget {
  groupId  String
  targetId String

  group  PageGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  target Target    @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([groupId, targetId])
  @@index([targetId])
  @@map("page_group_targets")
}

/// The Pages a member limited by `Membership.allPages = false` may work on.
model MemberPageAccess {
  membershipId String
  targetId     String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  target     Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@id([membershipId, targetId])
  @@index([targetId])
  @@map("member_page_access")
}

/// A tag on posts — campaign, client, theme — for filtering and reporting.
model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("blue")
  createdAt   DateTime @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts           PostLabel[]
  contentMixRules ContentMixRule[]
  postTemplates   PostTemplate[]

  @@unique([workspaceId, name])
  @@map("labels")
}

model PostLabel {
  postId  String
  labelId String

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([postId, labelId])
  @@index([labelId])
  @@map("post_labels")
}

// ---------------------------------------------------------------------------
// RSS auto-posting
// ---------------------------------------------------------------------------

model FeedSource {
  id              String      @id @default(cuid())
  workspaceId     String
  name            String
  url             String
  /// "rss" (RSS or Atom) or "wordpress" (the site's REST API, /wp-json/wp/v2/posts).
  kind            String      @default("rss")
  enabled         Boolean     @default(true)
  /// Supports {title}, {excerpt}, {link}, {hashtags} (and the older {{title}}, {{link}}, {{description}}).
  messageTemplate String      @default("{{title}}\n\n{{link}}")
  /// Target ids to publish new items to (string[]).
  targetIds       Json        @default("[]")
  publishMode     PublishMode @default(worker)
  /// When false, new items land in the approval queue instead of scheduling.
  autoApprove     Boolean     @default(true)
  /// Filled into {hashtags}.
  hashtags        String      @default("")
  /// 0: one post to every Page at once. Otherwise one post per Page, this many
  /// minutes apart, so a new article does not land everywhere in the same minute.
  spreadMinutes   Int         @default(0)

  // Conditional-request state, so polling is cheap and polite.
  lastPolledAt DateTime?
  lastEtag     String?
  lastModified String?
  /// Items published before this are ignored — stops a new subscription from
  /// dumping the feed's whole archive into the queue.
  ingestFrom   DateTime  @default(now())

  pollErrorCount Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     FeedItem[]

  @@index([workspaceId])
  @@index([enabled, lastPolledAt])
  @@map("feed_sources")
}

model FeedItem {
  id           String    @id @default(cuid())
  feedSourceId String
  /// Feed-provided guid, falling back to the canonical URL.
  guid         String
  url          String?
  title        String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())

  feedSource FeedSource @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)
  posts      Post[]

  // The de-duplication guard: a feed re-publishing its history cannot re-post.
  @@unique([feedSourceId, guid])
  @@index([feedSourceId])
  @@map("feed_items")
}

// ---------------------------------------------------------------------------
// Link shortening
// ---------------------------------------------------------------------------

model ShortLink {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String   @unique
  targetUrl   String
  postId      String?
  /// The Page the link went out on (G14). Null for links made before, which
  /// count for their post's first Page.
  targetId    String?
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  target    Target?     @relation(fields: [targetId], references: [id], onDelete: SetNull)
  clicks    LinkClick[]

  @@index([workspaceId])
  @@index([postId])
  @@index([targetId])
  @@map("short_links")
}

model LinkClick {
  id          String   @id @default(cuid())
  shortLinkId String
  /// Hashed, never the raw address.
  ipHash      String?
  userAgent   String?
  referer     String?
  country     String?
  createdAt   DateTime @default(now())

  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId, createdAt])
  // Answers "has this visitor been here lately", which is what keeps a refresh
  // from counting as a second click.
  @@index([shortLinkId, ipHash, createdAt])
  @@map("link_clicks")
}

// ---------------------------------------------------------------------------
// AI, notifications, audit
// ---------------------------------------------------------------------------

/// One AI caption call. Exists so spend is visible rather than a surprise.
model AiGeneration {
  id           String           @id @default(cuid())
  workspaceId  String
  userId       String
  kind         AiGenerationKind
  prompt       String
  output       String
  model        String
  inputTokens  Int              @default(0)
  outputTokens Int              @default(0)
  /// anthropic | openai | gemini. Null on rows written before providers were recorded.
  provider     String?
  /// US dollars from the price table at the time of the call. Null = price unknown, never 0.
  costUsd      Float?
  createdAt    DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  /// The monthly budget sums every workspace's spend since the 1st.
  @@index([createdAt])
  @@map("ai_generations")
}

/// Per user per workspace, so an agency owner is not emailed about every client.
model NotificationSetting {
  id          String @id @default(cuid())
  userId      String
  workspaceId String

  onPublishFailure   Boolean   @default(true)
  onTokenExpiry      Boolean   @default(true)
  onApprovalRequest  Boolean   @default(true)
  onApprovalDecision Boolean   @default(true)
  /// An hourly email of new comments and messages. Opt-in: no row means off.
  onNewInbox         Boolean   @default(false)
  /// A Page that had posts scheduled has none left.
  onQueueEmpty       Boolean   @default(true)
  /// Somebody else changed a post I wrote that was not out yet.
  onDraftUpdated     Boolean   @default(true)
  /// A comment matched a moderation rule set to alert.
  onModerationAlert  Boolean   @default(true)
  /// A teammate @mentioned me in a post's internal notes.
  onNoteMention      Boolean   @default(true)
  /// Up to when the inbox email has already counted (the next one starts here).
  inboxDigestAt      DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("notification_settings")
}

/// One Page a member does not want to hear about for one event. No row means
/// they hear about it, as far as their workspace-wide switch says.
model NotificationMute {
  id       String @id @default(cuid())
  userId   String
  targetId String
  /// `publishFailure` or `newInbox`.
  event    String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId, event])
  @@index([targetId, event])
  @@map("notification_mutes")
}

/// Needed to answer "was the failure alert actually sent?"
model EmailLog {
  id          String      @id @default(cuid())
  workspaceId String?
  to          String
  template    String
  subject     String
  providerId  String?
  status      EmailStatus
  error       String?
  createdAt   DateTime    @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("email_logs")
}

/// A single insights value for a destination, captured over time.
///
/// Graph only serves roughly two years of history and drops metrics between
/// versions, so anything we want to keep must be copied out. The unique key
/// makes re-fetching the same window idempotent.
model PageInsight {
  id        String   @id @default(cuid())
  targetId  String
  metric    String
  period    String
  /// End of the window this value covers.
  endTime   DateTime
  /// A number, or a breakdown map for metrics like page_fans_country.
  value     Json
  /// Null for breakdowns, where a single figure has no meaning.
  numeric   Float?
  fetchedAt DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric, period, endTime])
  @@index([targetId, metric, endTime])
  @@map("page_insights")
}

/// What Graph would actually serve, last time we asked.
///
/// Meta removes metrics without telling individual apps, so this is recorded
/// rather than assumed: the UI can then say "Meta no longer serves this"
/// instead of drawing an empty chart.
model MetricAvailability {
  id        String   @id @default(cuid())
  targetId  String
  metric    String
  period    String
  available Boolean
  reason    String?
  checkedAt DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric, period])
  @@index([targetId])
  @@map("metric_availability")
}

// ---------------------------------------------------------------------------
// Graph edges beyond /insights
// ---------------------------------------------------------------------------
//
// Insights answer "how many". These edges answer "who and what" — the comment
// text, the star rating, the message thread. They are separate tables rather
// than Json blobs because they are the things people search and read, not
// aggregate.

/// A comment left on a post this app published.
model PostComment {
  id             String    @id @default(cuid())
  postTargetId   String
  remoteId       String
  /// Set for replies; null for top-level comments.
  parentRemoteId String?
  message        String
  fromName       String?
  fromId         String?
  likeCount      Int       @default(0)
  replyCount     Int       @default(0)
  isHidden       Boolean   @default(false)
  createdTime    DateTime
  fetchedAt      DateTime  @default(now())
  /// When the sync first stored it; never moves (the inbox email counts by it).
  firstSeenAt    DateTime  @default(now())
  /// Marked done in the inbox; null while it waits on someone.
  resolvedAt     DateTime?
  /// The member this is assigned to; null while nobody has taken it. A plain id, like `sentById`.
  assigneeId     String?
  /// The member who wrote this reply from the app (H11); null otherwise.
  sentById       String?
  /// negative · neutral · positive, read by AI when the workspace watches comments (H15).
  sentiment      String?

  postTarget PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@unique([postTargetId, remoteId])
  @@index([postTargetId, createdTime])
  @@map("post_comments")
}

/// A star rating or recommendation left on a Page.
model PageReview {
  id                 String   @id @default(cuid())
  targetId           String
  remoteId           String
  reviewerName       String?
  rating             Int?
  /// Newer Pages expose a recommendation type instead of stars.
  recommendationType String?
  reviewText         String?
  createdTime        DateTime
  fetchedAt          DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("page_reviews")
}

/// A Page inbox thread.
model Conversation {
  id           String    @id @default(cuid())
  targetId     String
  remoteId     String
  snippet      String?
  unreadCount  Int       @default(0)
  messageCount Int       @default(0)
  /// Names of the people in the thread.
  participants Json?
  updatedTime  DateTime
  fetchedAt    DateTime  @default(now())
  /// Marked done in the inbox; cleared when the other person writes again.
  resolvedAt   DateTime?
  /// The member this is assigned to; null while nobody has taken it.
  assigneeId   String?

  target   Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@unique([targetId, remoteId])
  @@index([targetId, updatedTime])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  remoteId       String
  fromName       String?
  fromId         String?
  message        String?
  createdTime    DateTime
  /// When the sync first stored it; never moves (the inbox email counts by it).
  firstSeenAt    DateTime @default(now())
  /// The member who sent this message from the app (H11); null otherwise.
  sentById       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, remoteId])
  @@index([conversationId, createdTime])
  @@map("conversation_messages")
}

/// A post that appeared on a Page without going through this app.
///
/// Without these, every report understates the Page: someone posting from the
/// Facebook app directly is invisible to us otherwise.
model ExternalPost {
  id               String    @id @default(cuid())
  targetId         String
  remoteId         String
  message          String?
  permalink        String?
  statusType       String?
  /// Facebook's full_picture: the image the post shows in the feed. A CDN
  /// address that expires, refreshed on every sync.
  pictureUrl       String?
  createdTime      DateTime
  /// Whatever the post-level catalogue returned for it (PostInsights).
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime  @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("external_posts")
}

/// A video on a Page, with the video-level insight catalogue attached.
///
/// Separate from the post that carried it: a crossposted video has one video
/// object and several posts, and only the video object holds the combined
/// figures.
model PageVideo {
  id               String    @id @default(cuid())
  targetId         String
  remoteId         String
  title            String?
  description      String?
  permalink        String?
  thumbnailUrl     String?
  lengthSeconds    Float?
  createdTime      DateTime
  /// Metric name to number, or to a breakdown map.
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime  @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("page_videos")
}

// ---------------------------------------------------------------------------
// Instagram (analytics only — publishing is a separate piece of work)
// ---------------------------------------------------------------------------

/// An Instagram Business account reachable through a connected Facebook Page.
model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  socialAccountId   String?
  /// The Page this account is linked to; the Page token is what reads it.
  targetId          String?
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?
  followersCount    Int?
  followsCount      Int?
  mediaCount        Int?
  enabled           Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?     @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  target        Target?            @relation(fields: [targetId], references: [id], onDelete: SetNull)
  media         InstagramMedia[]
  insights      InstagramInsight[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

model InstagramMedia {
  id               String    @id @default(cuid())
  accountId        String
  remoteId         String
  caption          String?
  mediaType        String?
  mediaProductType String?
  mediaUrl         String?
  permalink        String?
  thumbnailUrl     String?
  timestamp        DateTime
  likeCount        Int?
  commentsCount    Int?
  /// Per-media insights, metric name to value.
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime  @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, remoteId])
  @@index([accountId, timestamp])
  @@map("instagram_media")
}

model InstagramInsight {
  id        String   @id @default(cuid())
  accountId String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metric, period, endTime])
  @@index([accountId, metric, endTime])
  @@map("instagram_insights")
}

// ---------------------------------------------------------------------------
// Advertising (Marketing API — spend against organic performance)
// ---------------------------------------------------------------------------

model AdAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  /// Facebook's account id, including the "act_" prefix.
  actId           String
  name            String
  currency        String?
  accountStatus   Int?
  enabled         Boolean   @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  insights      AdInsight[]

  @@unique([workspaceId, actId])
  @@index([workspaceId])
  @@map("ad_accounts")
}

/// One day of delivery for an ad account, campaign, ad set or ad.
model AdInsight {
  id          String   @id @default(cuid())
  adAccountId String
  /// "account", "campaign", "adset" or "ad".
  level       String
  /// The id of the object this row describes.
  objectId    String
  objectName  String?
  date        DateTime

  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  reach       Int      @default(0)
  /// Cost per click, cost per mille and click-through rate, as Facebook
  /// computes them — recomputing from the totals gives different numbers.
  cpc         Float?
  cpm         Float?
  cpp         Float?
  ctr         Float?
  frequency   Float?
  /// Actions and conversions, which vary by campaign objective.
  actions     Json?
  /// Every remaining field the request returned, so nothing is thrown away.
  fields      Json?
  fetchedAt   DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, level, objectId, date])
  @@index([adAccountId, date])
  @@map("ad_insights")
}

/// An instance-wide setting, overriding the environment default.
///
/// Settings live here rather than only in `.env` so an operator can change the
/// Graph version, a job interval or an API key without a redeploy. The value is
/// `Json` because the registry types each key (string, number, boolean, list);
/// storing everything as text would push parsing into every read.
model AppSetting {
  key         String   @id
  value       Json
  /// True when `value` holds a ciphertext rather than the value itself.
  encrypted   Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

/// The last time a scheduler worker was alive.
///
/// One row per worker process. Nothing publishes without a worker running, and
/// a fresh installation whose worker was never started looks exactly like one
/// that is working — posts sit at "scheduled" and nobody is told why. The setup
/// screen reads this to say so.
model WorkerHeartbeat {
  workerId String   @id
  /// Written explicitly by the worker rather than by `@updatedAt`, so a test
  /// and an operator can both put a heartbeat in the past on purpose.
  seenAt   DateTime @default(now())
  /// Which jobs this process is configured to run, for an operator reading it.
  jobs     String[]

  @@index([seenAt])
  @@map("worker_heartbeats")
}

/// When each background job last finished, so a restarted worker carries on
/// its schedule instead of running every sync at once — which, on a small
/// Meta app, spends the hour's call allowance in one go.
model WorkerJobRun {
  name        String    @id
  /// The last run that actually ran (not one deferred for the call budget).
  finishedAt  DateTime?
  /// The last attempt of any kind, and how it went, for the root status page.
  startedAt   DateTime?
  durationMs  Int?
  /// ok · idle (nothing to do) · waiting (deferred for the call budget) · failed
  outcome     String?
  summary     String?
  lastError   String?
  lastErrorAt DateTime?
  /// Failed runs in a row; reset by one that does not fail.
  failures    Int       @default(0)

  @@map("worker_job_runs")
}

/// What the worker last knew about the Meta app's call allowance — the app's
/// share used and each Page or account Facebook metered on its own — so a
/// restarted worker does not spend an allowance already gone, and root can see
/// it. One row, rewritten after every job.
model GraphUsage {
  key      String   @id
  snapshot Json
  savedAt  DateTime @default(now())

  @@map("graph_usage")
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  detail      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("activity_logs")
}

/// Text kept for reuse in the composer: a signature, a call to action, a set
/// of hashtags.
model Snippet {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("snippets")
}

/// A post structure kept for reuse (NEXT_PHASES H4): a category the team
/// names, text with `{placeholders}` filled when it is picked, hashtags, a
/// first comment and a label. Shared per workspace.
model PostTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  category     String   @default("")
  body         String
  hashtags     String   @default("")
  firstComment String   @default("")
  labelId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  label     Label?    @relation(fields: [labelId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@map("post_templates")
}

/// A reusable answer for comments and Messenger (NEXT_PHASES G8), with
/// `{first_name}` and `{page}` filled when it is picked. Shared per workspace.
/// A named combination of channels, filters and status on the calendar or the
/// post list, reopened in one click. Per person: `query` is the address's own
/// query string, so it is exactly what the screen already understands.
model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  /// "calendar" or "posts".
  screen      String
  query       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, screen])
  @@map("saved_views")
}

model SavedReply {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("saved_replies")
}

/// Caption A/B test (NEXT_PHASES G9): the same content posted with two to four
/// captions, on comparable Pages or at the same hour on following days. After
/// `hours` the worker compares engagement per view and names a winner, or says
/// there were not enough views to tell.
model CaptionTest {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// Hours after the last caption goes out before the results are read.
  hours       Int       @default(48)
  /// Views each caption needs before a winner is named.
  minViews    Int       @default(500)
  /// running | decided | inconclusive
  status      String    @default("running")
  /// Why it ended without a winner: not_enough_views | not_published | no_insights.
  reason      String?
  winnerLabel String?
  /// The winner's engagement rate over the runner-up's, in percent.
  lift        Float?
  /// Per caption: { label, views, engagements, rate }.
  results     Json?
  decidedAt   DateTime?
  /// When the learning was added to the Pages' voice.
  learnedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("caption_tests")
}

/// A link a client opens without an account: a review page where they approve,
/// reject or comment on posts, or a read-only calendar of what is planned.
/// Only the hash of the token is stored, like session tokens.
model ShareLink {
  id            String    @id @default(cuid())
  workspaceId   String
  /// `review` or `calendar`.
  kind          String
  tokenHash     String    @unique
  title         String
  description   String?
  /// The Pages it shows (ids as a JSON array). Empty means every Page.
  targetIds     Json      @default("[]")
  /// Days back and ahead a calendar link shows, counted from the day it is opened.
  daysBack      Int       @default(7)
  daysAhead     Int       @default(30)
  allowComments Boolean   @default(true)
  /// The client's answer approves or rejects the post, instead of only advising the team.
  decides       Boolean   @default(false)
  /// With `decides`: posts still unanswered this many hours before their time are approved anyway. Null = never.
  publishAnywayHours Int?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decisions ReviewDecision[]

  @@index([workspaceId])
  @@map("share_links")
}

/// What a client said about a post through a review link.
model ReviewDecision {
  id          String   @id @default(cuid())
  shareLinkId String
  postId      String
  /// `approved`, `rejected` or `comment`.
  decision    String
  comment     String?
  authorName  String
  createdAt   DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([shareLinkId])
  @@map("review_decisions")
}

/// A report set up once and used again: its sections and its period.
model ReportTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// ReportSection[] as JSON.
  sections    Json     @default("[]")
  /// A preset range key from `src/lib/date-range.ts`.
  rangeKey    String   @default("30d")
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedules ReportSchedule[]

  @@unique([workspaceId, name])
  @@map("report_templates")
}

/// A report emailed on a rhythm to people outside the app.
model ReportSchedule {
  id          String    @id @default(cuid())
  workspaceId String
  templateId  String?
  targetId    String
  /// `weekly` (Mondays) or `monthly` (the 1st).
  frequency   String
  recipients  String[]
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastError   String?
  /// Open the email with a short AI summary of what changed (needs AI on).
  aiRecap     Boolean   @default(false)
  /// Who set it up: the AI recap is counted against them.
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  ReportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([nextRunAt])
  @@map("report_schedules")
}

/// A key for the public API and the MCP endpoint: a person's access, with a
/// name, shown once and stored only as a hash.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  /// sha256 of the token; the token itself is never stored.
  tokenHash   String    @unique
  /// The first characters, so a list can tell keys apart.
  prefix      String
  /// `read` or `write` (write includes read).
  scope       String    @default("read")
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_tokens")
}

/// Where alerts go besides email: a Slack incoming webhook or a Telegram chat.
model ChatChannel {
  id          String    @id @default(cuid())
  workspaceId String
  /// `slack` or `telegram`.
  kind        String
  name        String
  /// Encrypted JSON: `{ url }` for Slack, `{ botToken, chatId }` for Telegram.
  secret      String
  /// Which alerts: publishFailure, approvalRequest, approvalDecision, published, reviewDecision.
  events      String[]
  enabled     Boolean   @default(true)
  lastError   String?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("chat_channels")
}

/// Outgoing webhook (NEXT_PHASES H18): events POSTed, signed, to a URL the
/// workspace's admins chose (Zapier, n8n, Make, their own server).
model WebhookEndpoint {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  url         String
  /// Encrypted signing secret; shown once when the endpoint is made.
  secret      String
  /// post.scheduled, post.published, post.failed, comment.received, page.disconnected, report.ready.
  events      String[]
  enabled     Boolean   @default(true)
  /// Set when an API key subscribed it (a Zapier-style REST hook).
  apiTokenId  String?
  lastError   String?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

/// One event for one endpoint, kept for the delivery log and retried with backoff.
model WebhookDelivery {
  id             String    @id @default(cuid())
  endpointId     String
  workspaceId    String
  event          String
  payload        Json
  /// pending, delivered, failed (gave up).
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@map("webhook_deliveries")
}

/// What root did to the installation (configuration, users, workspaces, root
/// transfer). Kept apart from workspace activity: it belongs to no workspace
/// and is shown only in the root section.
model RootActivity {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("root_activities")
}

/// Single-use codes for when the phone is lost. Only hashes are kept.
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

/// "Remember this device for 30 days": skips the second step on one browser.
model TrustedDevice {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trusted_devices")
}

/// A WebAuthn credential (passkey, security key) usable as the second step.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  name         String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// A run of the server's off-site backup or monthly restore test
/// (scripts/server/), written by the scripts with psql and shown in the root
/// section. Kinds: offsite | restore_test. Status: ok | failed.
model BackupRun {
  id         String   @id
  kind       String
  status     String
  detail     String?
  startedAt  DateTime
  finishedAt DateTime @default(now())

  @@index([kind, finishedAt])
  @@map("backup_runs")
}

/// One incident of something broken on the installation (worker stopped,
/// publishing failing, disk full…). One alert when it opens, one "resolved"
/// message when it clears; see src/lib/system-alerts.ts.
model SystemAlert {
  id         String    @id @default(cuid())
  key        String
  detail     Json?
  openedAt   DateTime  @default(now())
  resolvedAt DateTime?

  @@index([key, resolvedAt])
  @@index([openedAt])
  @@map("system_alerts")
}

/// Root inviting a client to create an account with a workspace of their own
/// (as opposed to `Invitation`, which joins an existing workspace). Token
/// stored hashed; the email it was sent to is the only one it admits.
model ClientInvitation {
  id               String    @id @default(cuid())
  email            String
  tokenHash        String    @unique
  /// Suggested name for the client's workspace; they can change it.
  workspaceName    String?
  invitedById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  createdAt        DateTime  @default(now())

  invitedBy User @relation("ClientInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("client_invitations")
}

/// Comment moderation rule (NEXT_PHASES G7): what to look for in new comments
/// on a workspace's Facebook Pages, and what the worker does when it finds it.
model ModerationRule {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  enabled     Boolean  @default(true)
  /// Pages it watches; empty means every Page of the workspace.
  targetIds   String[] @default([])
  /// `links`, `phones` or `keywords` (src/lib/moderation.ts).
  match       String
  keywords    String[] @default([])
  /// `hide`, `alert` or `reply`.
  action      String
  replyText   String?
  /// At most this many automatic actions in any 24 hours.
  dailyCap    Int      @default(20)
  /// A reply rule answers each person once, however often they comment.
  oncePerUser Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actions   ModerationAction[]

  @@index([workspaceId])
  @@map("moderation_rules")
}

/// What a moderation rule did, kept so it can be read and undone.
model ModerationAction {
  id              String    @id @default(cuid())
  workspaceId     String
  ruleId          String?
  /// The rule's name at the time, kept when the rule is deleted.
  ruleName        String
  targetId        String
  remoteCommentId String
  authorId        String?
  authorName      String?
  /// The comment's text at the time (first 500 characters).
  message         String
  action          String
  /// The Page's reply, for a reply rule: what an undo deletes.
  replyRemoteId   String?
  /// Why Facebook refused, when it did; nothing was changed then.
  error           String?
  undoneAt        DateTime?
  undoneById      String?
  createdAt       DateTime  @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule      ModerationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([ruleId, remoteCommentId])
  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
  @@map("moderation_actions")
}

/// Minutes each part of the installation was seen up, per UTC day (G15). The
/// web server counts one minute a minute for itself, and one for the worker
/// when its heartbeat is fresh; the root status page turns them into 90 days
/// of uptime.
model UptimeDay {
  day       String
  /// `app` or `worker`.
  component String
  minutes   Int    @default(0)

  @@id([day, component])
  @@map("uptime_days")
}

/// One kind of error seen by the server, the worker or a browser (G16), kept
/// in this database rather than sent anywhere. Grouped by fingerprint; the
/// text is scrubbed of tokens, secrets and email addresses before it is stored.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  /// `server`, `worker` or `browser`.
  source      String
  name        String
  message     String
  stack       String?
  /// The route or job it happened in, without its query string.
  location    String?
  /// The release (commit) it was last seen on.
  release     String
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Set by root; a new occurrence clears it.
  resolvedAt  DateTime?

  @@index([lastSeenAt])
  @@map("error_events")
}

/// A ZIP of everything a workspace holds (G17): posts, schedule, analytics,
/// comments and media. Built by the worker; the download expires.
model WorkspaceExport {
  id            String    @id @default(cuid())
  workspaceId   String
  requestedById String?
  /// queued · building · ready · failed · expired
  status        String    @default("queued")
  /// Path within the media root while the file exists.
  storageKey    String?
  bytes         Int?
  /// Media left out to stay under the ZIP size limit.
  skippedMedia  Int       @default(0)
  error         String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
  expiresAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("workspace_exports")
}

/// Public holidays of one country (H2), from the worldwide holidays dataset.
/// Shared by every workspace; fetched by the worker for the countries in use.
model PublicHoliday {
  country   String
  /// `yyyy-MM-dd`.
  date      String
  name      String
  localName String

  @@id([country, date, name])
  @@index([date])
  @@map("public_holidays")
}

/// Which country-years have been fetched, so each is asked for once.
model HolidayYear {
  country   String
  year      Int
  /// Holidays found; 0 when the dataset does not cover the country.
  count     Int
  fetchedAt DateTime @default(now())

  @@id([country, year])
  @@map("holiday_years")
}

/// A search trending today in one country (H7), from Google Trends' daily feed. Shared by every workspace.
model TrendingTopic {
  id        String    @id @default(cuid())
  country   String
  title     String
  /// "20,000+" as Google gives it.
  traffic   String?
  /// The first news article Google links to the search.
  newsTitle String?
  newsUrl   String?
  startedAt DateTime?
  fetchedAt DateTime  @default(now())

  @@unique([country, title])
  @@index([country, fetchedAt])
  @@map("trending_topics")
}

/// A date the team adds to its calendar (H2): a launch, a sale, an event.
model KeyDate {
  id          String   @id @default(cuid())
  workspaceId String
  /// `yyyy-MM-dd`; with `yearly`, only the month and day count.
  date        String
  title       String
  yearly      Boolean  @default(false)
  /// The Pages it is for; empty for every Page.
  targetIds   String[] @default([])
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, date])
  @@map("key_dates")
}

/// A seasonal posting mode (H2): between two dates, the queue of these Pages
/// pauses, moves its times, keeps fewer of them or adds more.
model SeasonalMode {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  /// `yyyy-MM-dd`, inclusive, in the workspace's time zone.
  startsOn     String
  endsOn       String
  /// The Pages it is for; empty for every Page.
  targetIds    String[] @default([])
  /// pause · shift · fewer · more
  rule         String
  /// For `shift`: minutes to move each queue time (negative is earlier).
  shiftMinutes Int      @default(0)
  /// For `more`: extra queue times each day, `HH:mm`.
  extraTimes   String[] @default([])
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("seasonal_modes")
}

/// Content mix (NEXT_PHASES H1): how many posts with a label a Page, or each
/// Page of a group, should have in any coming week. Rules set on a Page
/// replace its groups' rules for that Page.
model ContentMixRule {
  id          String    @id @default(cuid())
  workspaceId String
  /// Exactly one of `targetId` and `groupId` is set.
  targetId    String?
  groupId     String?
  labelId     String
  perWeek     Int
  /// When admins were told this label had run dry; cleared once it has drafts again.
  dryNotifiedAt DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target    Target?    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  group     PageGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  label     Label      @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("content_mix_rules")
}

/// A subscription tier, edited by root (Root › Plans). Limits count across
/// every workspace the subscriber owns; null means unlimited. Prices are shown,
/// not charged: no payment provider yet.
model Plan {
  id                String   @id @default(cuid())
  key               String   @unique
  name              String
  position          Int      @default(0)
  currency          String   @default("EUR")
  priceMonthly      Int      @default(0)
  priceYearly       Int      @default(0)
  extraChannelPrice Int      @default(0)
  channels          Int?
  members           Int?
  workspaces        Int?
  postsPerMonth     Int?
  aiCredits         Int?
  /// `clients` (client logins and approval links), `whiteLabel`, `api`.
  features          String[] @default([])
  /// New sign-ups start on this plan.
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users User[]

  @@map("plans")
}
