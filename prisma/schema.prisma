// MS Social Pilot — data model.
//
// PostgreSQL. Status fields are native enums and structured payloads are native
// Json, so the database rejects invalid values rather than trusting application
// code to have validated them.
//
// See docs/PROJECT_SCHEMA.md for the design this implements.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WorkspaceRole {
  owner
  admin
  editor
  contributor
}

enum TargetType {
  page
  group
  /// An Instagram Business account, published through the Page it is linked to.
  instagram
}

enum PostStatus {
  draft
  pending_approval
  rejected
  scheduled
  publishing
  published
  partially_failed
  failed
  cancelled
}

enum PostTargetStatus {
  pending
  processing
  published
  /// Handed to Facebook with a scheduled_publish_time: it exists remotely but
  /// is not live yet, and our scheduler must leave it alone.
  scheduled_remote
  failed
  cancelled
  skipped
}

enum PublishMode {
  /// Publish as soon as the request is handled.
  immediate
  /// Hold in our database; the worker publishes at scheduledAt.
  worker
  /// Hand the schedule to Facebook via scheduled_publish_time (Pages only).
  native
}

enum ApprovalStatus {
  not_required
  pending
  approved
  rejected
}

enum MediaKind {
  image
  video
}

enum StorageProvider {
  local
  s3
}

enum Locale {
  en
  fr
}

enum EmailStatus {
  sent
  failed
  skipped
}

enum AiGenerationKind {
  generate
  improve
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  locale       Locale   @default(en)
  /// Which workspace to open on sign-in. Not a security boundary — membership
  /// is always re-checked — just a convenience.
  lastActiveWorkspaceId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  sessions          Session[]
  posts             Post[]
  submittedPosts    Post[]         @relation("PostSubmitter")
  reviewedPosts     Post[]         @relation("PostReviewer")
  sentInvitations   Invitation[]   @relation("InvitationSender")
  notificationSettings NotificationSetting[]
  aiGenerations     AiGeneration[]
  settingChanges    AppSetting[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One client or brand. An agency has several; a single business has one.
model Workspace {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  timezone String @default("UTC")
  defaultLocale Locale @default(en)

  /// Turns the approval workflow on for this client.
  requiresApproval Boolean @default(false)

  // Light branding, used on client-facing reports.
  logoUrl     String?
  accentColor String?

  // Link tagging defaults, applied at publish time.
  utmSource           String?
  utmMedium           String?
  utmCampaignTemplate String?
  shortenerEnabled    Boolean @default(false)

  // AI caption defaults, fed into the prompt.
  aiEnabled    Boolean @default(true)
  aiTone       String?
  aiBrandVoice String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  socialAccounts       SocialAccount[]
  targets              Target[]
  posts                Post[]
  media                Media[]
  queueSlots           QueueSlot[]
  activityLogs         ActivityLog[]
  invitations          Invitation[]
  feedSources          FeedSource[]
  shortLinks           ShortLink[]
  aiGenerations        AiGeneration[]
  notificationSettings NotificationSetting[]
  emailLogs            EmailLog[]
  instagramAccounts    InstagramAccount[]
  adAccounts           AdAccount[]

  @@map("workspaces")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(contributor)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

/// A pending invitation to join a workspace. The token is stored hashed, like
/// sessions, so a database dump cannot be used to join someone's workspace.
model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(contributor)
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedByUserId String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationSender", fields: [invitedById], references: [id])

  // One live invitation per address per workspace; re-inviting updates this row.
  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Facebook connections
// ---------------------------------------------------------------------------

/// A connected Facebook user. Holds the long-lived *user* access token, which
/// is what page tokens and group posting are derived from. Encrypted at rest.
model SocialAccount {
  id             String    @id @default(cuid())
  workspaceId    String
  provider       String    @default("facebook")
  providerUserId String
  name           String
  pictureUrl     String?
  accessToken    String
  tokenExpiresAt DateTime?
  scopes         String    @default("")
  invalidatedAt  DateTime?
  invalidReason  String?
  lastSyncedAt   DateTime?
  /// Set when an expiry warning has been emailed, so the daily job warns once
  /// per token rather than every day until it dies.
  expiryWarningSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  targets           Target[]
  instagramAccounts InstagramAccount[]
  adAccounts        AdAccount[]

  @@unique([workspaceId, provider, providerUserId])
  @@index([workspaceId])
  @@map("social_accounts")
}

/// A destination: a Facebook Page or Group.
model Target {
  id          String @id @default(cuid())
  workspaceId String
  /// Nullable so disconnecting an account can drop the credentials without
  /// cascading away published-post history.
  socialAccountId String?
  type        TargetType
  providerId  String
  name        String
  pictureUrl  String?
  category    String?
  accessToken String?
  enabled     Boolean @default(true)
  canPublish  Boolean @default(true)
  publishBlocker String?
  lastSyncedAt   DateTime?

  // Read straight off the Page object: no insights permission, no date range.
  fanCount           Int?
  followersCount     Int?
  talkingAboutCount  Int?
  profileSyncedAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  postTargets   PostTarget[]
  insights      PageInsight[]
  availability  MetricAvailability[]
  reviews           PageReview[]
  conversations     Conversation[]
  externalPosts     ExternalPost[]
  videos            PageVideo[]
  instagramAccounts InstagramAccount[]

  @@unique([workspaceId, providerId])
  @@index([socialAccountId])
  @@map("targets")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Post {
  id          String  @id @default(cuid())
  workspaceId String
  authorId    String
  message     String  @default("")
  link        String?
  /// Cached Open Graph metadata for `link`.
  linkPreview Json?
  /// Every media id and storage key this post references, flattened out of
  /// `media` so "which posts use this file?" is an indexed lookup rather than a
  /// scan of every post's Json.
  mediaKeys   String[] @default([])
  /// Ordered attachments (PostMedia[]).
  media       Json    @default("[]")

  status      PostStatus  @default(draft)
  publishMode PublishMode @default(worker)
  scheduledAt DateTime?
  timezone    String      @default("UTC")
  publishedAt DateTime?

  // --- Approval workflow ---
  approvalStatus ApprovalStatus @default(not_required)
  submittedById  String?
  submittedAt    DateTime?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?

  // --- Evergreen recycling ---
  /// Alternate wordings, rotated between repeats. Facebook rejects identical
  /// repeated content with error 506, so recycling without variants fails.
  variants          Json    @default("[]")
  recycleEnabled    Boolean @default(false)
  recycleEveryDays  Int?
  recycleLimit      Int?
  recycleCount      Int     @default(0)
  recycleNextAt     DateTime?
  /// Set on a recycled copy, pointing at the post it was cloned from.
  originPostId      String?

  /// Set when this post was created from an RSS item.
  sourceFeedItemId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id])
  submitter User?        @relation("PostSubmitter", fields: [submittedById], references: [id])
  reviewer  User?        @relation("PostReviewer", fields: [reviewedById], references: [id])
  targets   PostTarget[]
  shortLinks ShortLink[]
  feedItem  FeedItem?    @relation(fields: [sourceFeedItemId], references: [id])

  @@index([workspaceId, status])
  @@index([mediaKeys], type: Gin)
  @@index([scheduledAt])
  @@index([workspaceId, approvalStatus])
  @@index([recycleEnabled, recycleNextAt])
  @@map("posts")
}

/// The unit of work the scheduler claims and publishes: one post, one
/// destination. This is what makes partial success expressible.
model PostTarget {
  id       String           @id @default(cuid())
  postId   String
  targetId String
  status   PostTargetStatus @default(pending)

  remotePostId       String?
  remoteUrl          String?
  nativeScheduledFor DateTime?

  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  lockedBy      String?

  errorCode    String?
  errorMessage String?
  publishedAt  DateTime?

  /// Last analytics snapshot (PostInsights).
  insights         Json?
  insightsSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post     Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  target   Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  comments PostComment[]

  @@unique([postId, targetId])
  @@index([status, nextAttemptAt])
  @@index([targetId])
  @@map("post_targets")
}

model Media {
  id          String          @id @default(cuid())
  workspaceId String
  filename    String
  mimeType    String
  size        Int
  kind        MediaKind
  storageProvider StorageProvider @default(local)
  /// Path within the storage backend, or null for externally hosted media.
  storageKey  String?
  checksum    String?
  url         String
  width       Int?
  height      Int?
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("media")
}

/// Recurring publishing times, in workspace-local terms.
model QueueSlot {
  id          String   @id @default(cuid())
  workspaceId String
  /// 0 = Sunday … 6 = Saturday.
  dayOfWeek   Int
  hour        Int
  minute      Int
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, dayOfWeek, hour, minute])
  @@index([workspaceId])
  @@map("queue_slots")
}

// ---------------------------------------------------------------------------
// RSS auto-posting
// ---------------------------------------------------------------------------

model FeedSource {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  url         String
  enabled     Boolean @default(true)
  /// Supports {{title}}, {{link}}, {{description}}.
  messageTemplate String @default("{{title}}\n\n{{link}}")
  /// Target ids to publish new items to (string[]).
  targetIds   Json    @default("[]")
  publishMode PublishMode @default(worker)
  /// When false, new items land in the approval queue instead of scheduling.
  autoApprove Boolean @default(true)

  // Conditional-request state, so polling is cheap and polite.
  lastPolledAt   DateTime?
  lastEtag       String?
  lastModified   String?
  /// Items published before this are ignored — stops a new subscription from
  /// dumping the feed's whole archive into the queue.
  ingestFrom     DateTime  @default(now())

  pollErrorCount Int     @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     FeedItem[]

  @@index([workspaceId])
  @@index([enabled, lastPolledAt])
  @@map("feed_sources")
}

model FeedItem {
  id           String   @id @default(cuid())
  feedSourceId String
  /// Feed-provided guid, falling back to the canonical URL.
  guid         String
  url          String?
  title        String?
  publishedAt  DateTime?
  createdAt    DateTime @default(now())

  feedSource FeedSource @relation(fields: [feedSourceId], references: [id], onDelete: Cascade)
  posts      Post[]

  // The de-duplication guard: a feed re-publishing its history cannot re-post.
  @@unique([feedSourceId, guid])
  @@index([feedSourceId])
  @@map("feed_items")
}

// ---------------------------------------------------------------------------
// Link shortening
// ---------------------------------------------------------------------------

model ShortLink {
  id          String   @id @default(cuid())
  workspaceId String
  slug        String   @unique
  targetUrl   String
  postId      String?
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  clicks    LinkClick[]

  @@index([workspaceId])
  @@index([postId])
  @@map("short_links")
}

model LinkClick {
  id          String   @id @default(cuid())
  shortLinkId String
  /// Hashed, never the raw address.
  ipHash      String?
  userAgent   String?
  referer     String?
  country     String?
  createdAt   DateTime @default(now())

  shortLink ShortLink @relation(fields: [shortLinkId], references: [id], onDelete: Cascade)

  @@index([shortLinkId, createdAt])
  // Answers "has this visitor been here lately", which is what keeps a refresh
  // from counting as a second click.
  @@index([shortLinkId, ipHash, createdAt])
  @@map("link_clicks")
}

// ---------------------------------------------------------------------------
// AI, notifications, audit
// ---------------------------------------------------------------------------

/// One AI caption call. Exists so spend is visible rather than a surprise.
model AiGeneration {
  id           String           @id @default(cuid())
  workspaceId  String
  userId       String
  kind         AiGenerationKind
  prompt       String
  output       String
  model        String
  inputTokens  Int              @default(0)
  outputTokens Int              @default(0)
  createdAt    DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("ai_generations")
}

/// Per user per workspace, so an agency owner is not emailed about every client.
model NotificationSetting {
  id          String  @id @default(cuid())
  userId      String
  workspaceId String

  onPublishFailure  Boolean @default(true)
  onTokenExpiry     Boolean @default(true)
  onApprovalRequest Boolean @default(true)
  onApprovalDecision Boolean @default(true)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("notification_settings")
}

/// Needed to answer "was the failure alert actually sent?"
model EmailLog {
  id          String      @id @default(cuid())
  workspaceId String?
  to          String
  template    String
  subject     String
  providerId  String?
  status      EmailStatus
  error       String?
  createdAt   DateTime    @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("email_logs")
}

/// A single insights value for a destination, captured over time.
///
/// Graph only serves roughly two years of history and drops metrics between
/// versions, so anything we want to keep must be copied out. The unique key
/// makes re-fetching the same window idempotent.
model PageInsight {
  id       String @id @default(cuid())
  targetId String
  metric   String
  period   String
  /// End of the window this value covers.
  endTime  DateTime
  /// A number, or a breakdown map for metrics like page_fans_country.
  value    Json
  /// Null for breakdowns, where a single figure has no meaning.
  numeric  Float?
  fetchedAt DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric, period, endTime])
  @@index([targetId, metric, endTime])
  @@map("page_insights")
}

/// What Graph would actually serve, last time we asked.
///
/// Meta removes metrics without telling individual apps, so this is recorded
/// rather than assumed: the UI can then say "Meta no longer serves this"
/// instead of drawing an empty chart.
model MetricAvailability {
  id        String   @id @default(cuid())
  targetId  String
  metric    String
  period    String
  available Boolean
  reason    String?
  checkedAt DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, metric, period])
  @@index([targetId])
  @@map("metric_availability")
}

// ---------------------------------------------------------------------------
// Graph edges beyond /insights
// ---------------------------------------------------------------------------
//
// Insights answer "how many". These edges answer "who and what" — the comment
// text, the star rating, the message thread. They are separate tables rather
// than Json blobs because they are the things people search and read, not
// aggregate.

/// A comment left on a post this app published.
model PostComment {
  id             String   @id @default(cuid())
  postTargetId   String
  remoteId       String
  /// Set for replies; null for top-level comments.
  parentRemoteId String?
  message        String
  fromName       String?
  fromId         String?
  likeCount      Int      @default(0)
  replyCount     Int      @default(0)
  isHidden       Boolean  @default(false)
  createdTime    DateTime
  fetchedAt      DateTime @default(now())

  postTarget PostTarget @relation(fields: [postTargetId], references: [id], onDelete: Cascade)

  @@unique([postTargetId, remoteId])
  @@index([postTargetId, createdTime])
  @@map("post_comments")
}

/// A star rating or recommendation left on a Page.
model PageReview {
  id           String   @id @default(cuid())
  targetId     String
  remoteId     String
  reviewerName String?
  rating       Int?
  /// Newer Pages expose a recommendation type instead of stars.
  recommendationType String?
  reviewText   String?
  createdTime  DateTime
  fetchedAt    DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("page_reviews")
}

/// A Page inbox thread.
model Conversation {
  id           String   @id @default(cuid())
  targetId     String
  remoteId     String
  snippet      String?
  unreadCount  Int      @default(0)
  messageCount Int      @default(0)
  /// Names of the people in the thread.
  participants Json?
  updatedTime  DateTime
  fetchedAt    DateTime @default(now())

  target   Target                @relation(fields: [targetId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@unique([targetId, remoteId])
  @@index([targetId, updatedTime])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  remoteId       String
  fromName       String?
  fromId         String?
  message        String?
  createdTime    DateTime

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, remoteId])
  @@index([conversationId, createdTime])
  @@map("conversation_messages")
}

/// A post that appeared on a Page without going through this app.
///
/// Without these, every report understates the Page: someone posting from the
/// Facebook app directly is invisible to us otherwise.
model ExternalPost {
  id          String   @id @default(cuid())
  targetId    String
  remoteId    String
  message     String?
  permalink   String?
  statusType  String?
  createdTime DateTime
  /// Whatever the post-level catalogue returned for it (PostInsights).
  insights    Json?
  insightsSyncedAt DateTime?
  fetchedAt   DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("external_posts")
}

/// A video on a Page, with the video-level insight catalogue attached.
///
/// Separate from the post that carried it: a crossposted video has one video
/// object and several posts, and only the video object holds the combined
/// figures.
model PageVideo {
  id          String   @id @default(cuid())
  targetId    String
  remoteId    String
  title       String?
  description String?
  permalink   String?
  thumbnailUrl String?
  lengthSeconds Float?
  createdTime DateTime
  /// Metric name to number, or to a breakdown map.
  insights    Json?
  insightsSyncedAt DateTime?
  fetchedAt   DateTime @default(now())

  target Target @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, remoteId])
  @@index([targetId, createdTime])
  @@map("page_videos")
}

// ---------------------------------------------------------------------------
// Instagram (analytics only — publishing is a separate piece of work)
// ---------------------------------------------------------------------------

/// An Instagram Business account reachable through a connected Facebook Page.
model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  socialAccountId   String?
  /// The Page this account is linked to; the Page token is what reads it.
  targetId          String?
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?
  followersCount    Int?
  followsCount      Int?
  mediaCount        Int?
  enabled           Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount?     @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  target        Target?            @relation(fields: [targetId], references: [id], onDelete: SetNull)
  media         InstagramMedia[]
  insights      InstagramInsight[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

model InstagramMedia {
  id            String   @id @default(cuid())
  accountId     String
  remoteId      String
  caption       String?
  mediaType     String?
  mediaProductType String?
  mediaUrl      String?
  permalink     String?
  thumbnailUrl  String?
  timestamp     DateTime
  likeCount     Int?
  commentsCount Int?
  /// Per-media insights, metric name to value.
  insights      Json?
  insightsSyncedAt DateTime?
  fetchedAt     DateTime @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, remoteId])
  @@index([accountId, timestamp])
  @@map("instagram_media")
}

model InstagramInsight {
  id        String   @id @default(cuid())
  accountId String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime @default(now())

  account InstagramAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, metric, period, endTime])
  @@index([accountId, metric, endTime])
  @@map("instagram_insights")
}

// ---------------------------------------------------------------------------
// Advertising (Marketing API — spend against organic performance)
// ---------------------------------------------------------------------------

model AdAccount {
  id              String    @id @default(cuid())
  workspaceId     String
  socialAccountId String?
  /// Facebook's account id, including the "act_" prefix.
  actId           String
  name            String
  currency        String?
  accountStatus   Int?
  enabled         Boolean   @default(true)
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  insights      AdInsight[]

  @@unique([workspaceId, actId])
  @@index([workspaceId])
  @@map("ad_accounts")
}

/// One day of delivery for an ad account, campaign, ad set or ad.
model AdInsight {
  id          String   @id @default(cuid())
  adAccountId String
  /// "account", "campaign", "adset" or "ad".
  level       String
  /// The id of the object this row describes.
  objectId    String
  objectName  String?
  date        DateTime

  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  reach       Int      @default(0)
  /// Cost per click, cost per mille and click-through rate, as Facebook
  /// computes them — recomputing from the totals gives different numbers.
  cpc         Float?
  cpm         Float?
  cpp         Float?
  ctr         Float?
  frequency   Float?
  /// Actions and conversions, which vary by campaign objective.
  actions     Json?
  /// Every remaining field the request returned, so nothing is thrown away.
  fields      Json?
  fetchedAt   DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, level, objectId, date])
  @@index([adAccountId, date])
  @@map("ad_insights")
}

/// An instance-wide setting, overriding the environment default.
///
/// Settings live here rather than only in `.env` so an operator can change the
/// Graph version, a job interval or an API key without a redeploy. The value is
/// `Json` because the registry types each key (string, number, boolean, list);
/// storing everything as text would push parsing into every read.
model AppSetting {
  key       String   @id
  value     Json
  /// True when `value` holds a ciphertext rather than the value itself.
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("app_settings")
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  detail      Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("activity_logs")
}
