+import { exportPostExplorer } from '@/modules/analytics/posts/server/posts';
+import { failure, paramsObject, reply, unauthorized, viewerActor } from '@/modules/analytics/http';
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: Request) {
+  const actor = await viewerActor('analytics/posts', false); if (!actor) return unauthorized();
+  try {
+    const result = await exportPostExplorer(actor, paramsObject(request.url));
+    return new Response(result.csv, { headers: {
+      'content-type': 'text/csv; charset=utf-8',
+      'content-disposition': 'attachment; filename="analytics-posts.csv"',
+      'cache-control': 'no-store',
+      'x-msp-export-format': 'analytics-posts-v1',
+      'x-msp-post-count': String(result.rowCount),
+      'x-msp-export-bytes': String(result.byteLength),
+    } });
+  } catch (error) { return failure(error, 'The posts export could not be prepared. Please try again.'); }
+}
