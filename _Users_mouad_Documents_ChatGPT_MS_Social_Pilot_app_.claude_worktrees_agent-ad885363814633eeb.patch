@@ -0,0 +1,45 @@
+import { z } from 'zod';
+
+const id = z.string().regex(/^[A-Za-z0-9_-]{1,200}$/);
+const day = z.string().regex(/^\d{4}-\d{2}-\d{2}$/).refine(value => new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value);
+/** `publishedAt`, the module's ranking measure (`rank`), or a stored measure key. */
+export const sortKey = z.string().regex(/^[A-Za-z][A-Za-z0-9_]{0,59}$/);
+const one = (value: unknown) => Array.isArray(value) ? (value.length === 1 ? value[0] : value) : value;
+const single = <T extends z.ZodTypeAny>(schema: T) => z.preprocess(one, schema);
+const ids = z.preprocess(value => value === undefined ? undefined : Array.isArray(value) ? value : [value], z.array(id).max(500).optional());
+const whole = (max: number) => z.union([z.number(), z.string().regex(/^[1-9]\d{0,3}$/).transform(Number)]).pipe(z.number().int().min(1).max(max));
+
+export const postExplorerSchema = z.object({
+  channel: ids,
+  start: single(day.optional()), end: single(day.optional()),
+  q: single(z.string().trim().max(100).optional()),
+  sort: single(sortKey.optional()), dir: single(z.enum(['asc', 'desc']).optional()),
+  page: single(whole(9999).optional()),
+  pageSize: single(whole(200).optional()),
+}).strict();
+export type PostExplorerInput = z.infer<typeof postExplorerSchema>;
+
+export type PostMeasureColumn = { key: string; label: string };
+export type ExplorerPost = {
+  postId: string; channelId: string; channelName: string; text: string;
+  publishedAt: string | null; url: string | null;
+  /** Stored measures by key; null is unknown, never zero. */
+  measures: Record<string, number | null>;
+  rank: number | null; measuredAt: string | null;
+};
+export type PostExplorerResult = {
+  ok: true;
+  period: { start: string; end: string; timeZone: string };
+  columns: PostMeasureColumn[]; rankLabel: string | null;
+  sort: { key: string; dir: 'asc' | 'desc' };
+  q: string; page: number; pageSize: number; total: number; nextPage: number | null;
+  posts: ExplorerPost[];
+  /** True when any channel reached the per-channel read limit, so the result may omit posts. */
+  incomplete: boolean;
+  /** Channels whose module stores no per-post measures; their posts are not listed (unknown, not zero). */
+  unsupportedChannels: Array<{ id: string; name: string }>;
+  /** Channels read for this result. */
+  channels: Array<{ id: string; name: string }>;
+  /** Every channel the viewer may choose. */
+  channelOptions: Array<{ id: string; name: string }>;
+};
