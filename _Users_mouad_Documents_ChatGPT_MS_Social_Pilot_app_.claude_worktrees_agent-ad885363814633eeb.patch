+import { readPostExplorer } from '@/modules/analytics/posts/server/posts';
+import { failure, paramsObject, reply, unauthorized, viewerActor } from '@/modules/analytics/http';
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: Request) {
+  const actor = await viewerActor('analytics/posts', false); if (!actor) return unauthorized();
