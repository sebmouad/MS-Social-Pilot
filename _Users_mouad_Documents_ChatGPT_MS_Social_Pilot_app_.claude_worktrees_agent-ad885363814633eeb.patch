+  entry({ key: 'analytics.posts.maxPostsPerChannel', group: 'Analytics · Post explorer', label: 'Posts read per channel', kind: 'number', description: 'Most published posts read from stored figures for one channel and period; a result that reaches it is marked incomplete.', defaultValue: 1000, schema: z.number().int().min(50).max(2000), consumption: 'active' }),
+  entry({ key: 'analytics.posts.exportRows', group: 'Analytics · Post explorer', label: 'Post explorer CSV row limit', kind: 'number', description: 'Most post rows in one post explorer CSV download; a larger selection is refused, not cut.', defaultValue: 2000, schema: z.number().int().min(50).max(20000), consumption: 'active' }),
