+import { OperationError } from '@/lib/operation-error';
+import type { Actor } from '../server/access';
+import { readPostExplorer } from './server/posts';
+
+const day = { type: 'string', description: 'Inclusive workspace-time-zone date, YYYY-MM-DD.' };
+export const analyticsPostToolDefinitions = [
+  {
+    name: 'get_analytics_posts',
+    description: 'Read a page of published posts with their stored per-post measures for channels you can access, one row per post per channel. Sort by publishedAt, rank or any returned measure key; search post text; continue with nextPage until null. Unknown figures are null, never zero; channels whose module stores no per-post figures are listed in unsupportedChannels.',
+    inputSchema: { type: 'object', properties: { channel: { type: 'array', items: { type: 'string', pattern: '^[A-Za-z0-9_-]{1,200}$' }, maxItems: 500 }, start: day, end: day, q: { type: 'string', maxLength: 100 }, sort: { type: 'string', pattern: '^[A-Za-z][A-Za-z0-9_]{0,59}$' }, dir: { type: 'string', enum: ['asc', 'desc'] }, page: { type: 'integer', minimum: 1, maximum: 9999 }, pageSize: { type: 'integer', minimum: 1, maximum: 200 } }, additionalProperties: false },
+  },
+] as const;
+export async function executeAnalyticsPostTool(actor: Actor, name: string, args: Record<string, unknown>) {
+  if (name === 'get_analytics_posts') return readPostExplorer(actor, args);
+  throw new OperationError('invalid_request', 'Unknown Analytics posts action.');
+}
diff --git a/rebuild/src/modules/analytics/posts/server/posts.ts b/rebuild/src/modules/analytics/posts/server/posts.ts
new file mode 100644
index 00000000..93584612
--- /dev/null
+++ b/rebuild/src/modules/analytics/posts/server/posts.ts
@@ -0,0 +1,137 @@
+import { OperationError } from '@/lib/operation-error';
+import { prisma } from '@/server/data';
+import { runtimeConfig } from '@/server/config/store';
+import { entitledPlatformIds, loadEntitlements } from '@/server/entitlements';
+import { selectedResourceConnectionWhere } from '@/server/platforms/resource-visibility';
+import { platformAnalytics } from '@/server/platforms/registry';
+import { authorize, bad, type Actor } from '../../server/access';
+import { usableChannelIds } from '../../reports/server/access';
+import { dayIn, shiftDay, validTimeZone, zonedToUtc } from '../../reports/schedule-time';
+import { postExplorerSchema, type ExplorerPost, type PostExplorerResult, type PostMeasureColumn } from '../contracts';
+
+const FEATURE = 'analytics/posts' as const;
+type Channel = { id: string; name: string; provider: string | null };
+
+async function channelsFor(actor: Actor, scope: string[] | null): Promise<string[]> {
+  const entitlements = await loadEntitlements(actor.userId, actor.workspaceId, { allowInstallationInspection: false });
+  const providers = entitlements ? (await selectedResourceConnectionWhere(actor.workspaceId, entitledPlatformIds(entitlements))).provider.in : [];
+  const ids = await usableChannelIds(prisma, actor.workspaceId, providers, scope);
+  return scope === null ? ids : ids.filter(id => scope.includes(id));
+}
+
+async function channelRows(workspaceId: string, ids: string[]): Promise<Channel[]> {
+  if (!ids.length) return [];
+  return prisma.$queryRaw<Channel[]>`SELECT t.id, t.name, a.provider FROM targets t LEFT JOIN social_accounts a ON a.id = t."socialAccountId" AND a."workspaceId" = t."workspaceId" WHERE t."workspaceId" = ${workspaceId} AND t.id = ANY(${ids}::text[]) ORDER BY t.name ASC`;
+}
+
+async function workspaceTimeZone(workspaceId: string): Promise<string> {
+  const rows = await prisma.$queryRaw<Array<{ timezone: string | null }>>`SELECT timezone FROM workspaces WHERE id = ${workspaceId}`;
+  const zone = rows[0]?.timezone;
+  return zone && validTimeZone(zone) ? zone : 'UTC';
+}
+
+async function bounds() {
+  const [pageSize, perChannel, exportRows, defaultDays, maxDays] = await Promise.all([
+    runtimeConfig('analytics.posts.pageSize'), runtimeConfig('analytics.posts.maxPostsPerChannel'), runtimeConfig('analytics.posts.exportRows'),
+    runtimeConfig('analytics.defaultRangeDays'), runtimeConfig('analytics.maxRangeDays'),
+  ]).then(values => values.map(Number));
+  const ok = (value: number | undefined, min: number, max: number): value is number => Number.isSafeInteger(value) && (value as number) >= min && (value as number) <= max;
+  if (!ok(pageSize, 5, 100) || !ok(perChannel, 50, 2000) || !ok(exportRows, 50, 20000) || !ok(defaultDays, 1, 3650) || !ok(maxDays, 1, 3650)) {
+    throw new OperationError('unavailable', 'Posts are temporarily unavailable.');
+  }
+  return { pageSize, perChannel, exportRows, defaultDays, maxDays };
+}
+
+type Collected = Omit<PostExplorerResult, 'page' | 'pageSize' | 'nextPage' | 'posts'> & { all: ExplorerPost[]; limits: Awaited<ReturnType<typeof bounds>> };
+
+const compare = (key: string, dir: 'asc' | 'desc') => (a: ExplorerPost, b: ExplorerPost): number => {
+  const pick = (post: ExplorerPost): number | null => key === 'publishedAt' ? (post.publishedAt ? Date.parse(post.publishedAt) : null) : key === 'rank' ? post.rank : (post.measures[key] ?? null);
+  const left = pick(a); const right = pick(b);
+  // Unknown is last whichever direction: a post without a figure is neither best nor worst.
+  if (left === null || right === null) return left === right ? a.postId.localeCompare(b.postId) : left === null ? 1 : -1;
+  return (dir === 'desc' ? right - left : left - right) || a.postId.localeCompare(b.postId);
+};
+
+async function collect(actor: Actor, rawInput: unknown, now: Date): Promise<Collected> {
+  const parsed = postExplorerSchema.safeParse(rawInput ?? {}); if (!parsed.success) throw bad('Choose valid dates, channels and sort options.');
+  const input = parsed.data;
+  const auth = await authorize(actor, FEATURE, 'read');
+  const limits = await bounds();
+  const timeZone = await workspaceTimeZone(actor.workspaceId);
+  const today = dayIn(now, timeZone);
+  const end = input.end ?? today;
+  const start = input.start ?? shiftDay(end, -(limits.defaultDays - 1));
+  if (start > end) throw bad('The start date must not be after the end date.');
+  const span = Math.round((Date.parse(`${end}T00:00:00Z`) - Date.parse(`${start}T00:00:00Z`)) / 86_400_000) + 1;
+  if (span > limits.maxDays) throw bad(`Choose a period of at most ${limits.maxDays} days.`);
+  const from = zonedToUtc(start, '00:00', timeZone); const to = zonedToUtc(shiftDay(end, 1), '00:00', timeZone);
+
+  const available = await channelsFor(actor, auth.scope);
+  const requested = input.channel?.length ? [...new Set(input.channel)] : null;
+  if (requested && requested.some(id => !available.includes(id))) throw new OperationError('not_found', 'A selected channel is unavailable in the current workspace.');
+  const ids = requested ?? available;
+  if (actor.maxResultItems !== undefined && ids.length > actor.maxResultItems) throw new OperationError('invalid_request', 'The posts result exceeds the current MCP limit. Choose fewer channels.');
+  const everyChannel = await channelRows(actor.workspaceId, available);
+  const channels = everyChannel.filter(channel => ids.includes(channel.id));
+
+  const all: ExplorerPost[] = []; const columns = new Map<string, string>(); const unsupportedChannels: Array<{ id: string; name: string }> = [];
+  let rankLabel: string | null = null; let incomplete = false;
+  for (const channel of channels) {
+    const analytics = channel.provider ? await platformAnalytics(channel.provider) : null;
+    if (!analytics?.postPerformance) { unsupportedChannels.push({ id: channel.id, name: channel.name }); continue; }
+    const rows = await analytics.postPerformance({ workspaceId: actor.workspaceId, targetId: channel.id, from, to, limit: limits.perChannel });
+    if (rows.length >= limits.perChannel) incomplete = true;
+    for (const row of rows) {
+      rankLabel ??= row.rankLabel;
+      const measures: Record<string, number | null> = {};
+      for (const measure of row.measures) { measures[measure.key] = measure.value; if (!columns.has(measure.key)) columns.set(measure.key, measure.label); }
+      all.push({ postId: row.postId, channelId: channel.id, channelName: channel.name, text: row.text, publishedAt: row.publishedAt ? row.publishedAt.toISOString() : null, url: row.url, measures, rank: row.rankValue, measuredAt: row.measuredAt ? row.measuredAt.toISOString() : null });
+    }
+  }
+
+  const q = (input.q ?? '').toLowerCase();
+  const filtered = q ? all.filter(post => post.text.toLowerCase().includes(q)) : all;
+  const key = input.sort ?? 'publishedAt'; const dir = input.dir ?? 'desc';
+  if (key !== 'publishedAt' && key !== 'rank' && !columns.has(key)) {
+    // A measure no loaded post carries cannot be sorted on; an empty selection accepts any well-formed key.
+    if (all.length) throw bad('Choose a measure that these posts have.');
+  }
+  filtered.sort(compare(key, dir));
+  const cols: PostMeasureColumn[] = [...columns].map(([k, label]) => ({ key: k, label }));
+  return {
+    ok: true, period: { start, end, timeZone }, columns: cols, rankLabel, sort: { key, dir }, q: input.q ?? '', total: filtered.length,
+    incomplete, unsupportedChannels, channels: channels.map(c => ({ id: c.id, name: c.name })), channelOptions: everyChannel.map(c => ({ id: c.id, name: c.name })), all: filtered, limits,
+  };
+}
+
+/** One page of the post explorer for the channels the actor may see. Measures a channel does not store are null. */
+export async function readPostExplorer(actor: Actor, input: unknown = {}, now = new Date()): Promise<PostExplorerResult> {
+  const { all, limits, ...rest } = await collect(actor, input, now);
+  const parsed = postExplorerSchema.parse(input ?? {});
+  const cap = Math.min(limits.pageSize, actor.maxResultItems ?? limits.pageSize);
+  const pageSize = Math.max(1, Math.min(parsed.pageSize ?? limits.pageSize, cap));
+  const lastPage = Math.max(1, Math.ceil(rest.total / pageSize));
+  const page = Math.min(parsed.page ?? 1, lastPage);
+  const posts = all.slice((page - 1) * pageSize, page * pageSize);
+  return { ...rest, page, pageSize, nextPage: page < lastPage ? page + 1 : null, posts };
+}
+
+/** Spreadsheet programs may ignore leading whitespace before a formula marker. */
+export function csvCell(value: string): string {
+  const safe = /^[\s﻿]*[=+\-@]/.test(value) ? `'${value}` : value;
+  return `"${safe.replaceAll('"', '""')}"`;
+}
+
+/** Every post matching the selection as CSV (not just one page); refused, never cut, above the Root row limit. */
+export async function exportPostExplorer(actor: Actor, input: unknown = {}, now = new Date()): Promise<{ csv: string; rowCount: number; byteLength: number; maxRows: number }> {
+  const stripped = input && typeof input === 'object' ? Object.fromEntries(Object.entries(input as Record<string, unknown>).filter(([key]) => key !== 'page' && key !== 'pageSize')) : input;
+  const { all, columns, rankLabel, limits, incomplete } = await collect(actor, stripped, now);
+  if (all.length > limits.exportRows) throw new OperationError('invalid_request', `This selection has more than ${limits.exportRows} posts. Narrow the channels, period or search.`);
+  if (incomplete) throw new OperationError('invalid_request', 'Some channels have more posts than can be read at once. Narrow the period so the export is complete.');
+  const header = ['Channel', 'Published (UTC)', 'Post', 'Link', ...columns.map(column => column.label), ...(rankLabel ? [rankLabel] : [])];
+  const cell = (value: number | null) => value === null ? '' : String(value);
+  const lines = [header.map(csvCell).join(',')];
+  for (const post of all) lines.push([post.channelName, post.publishedAt ?? '', post.text, post.url ?? '', ...columns.map(column => cell(post.measures[column.key] ?? null)), ...(rankLabel ? [cell(post.rank)] : [])].map(csvCell).join(','));
+  const csv = `${lines.join('\r\n')}\r\n`;
+  return { csv, rowCount: all.length, byteLength: Buffer.byteLength(csv), maxRows: limits.exportRows };
+}
