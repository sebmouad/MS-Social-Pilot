+'use client';
+import { useRef, useState } from 'react';
+import { Button } from '@/components/Button';
+import { useConfirm } from '@/components/useConfirm';
+import { FieldError, useFormValidation } from '@/components/FormValidation';
+import { watermarkOptions, type WatermarkState, type WatermarkOptions } from './contracts';
+import { watermarkCopy } from './copy';
+import styles from './watermark.module.css';
+
+export function WatermarkManager({ initial, locale, maxLogoBytes, canApply = true }: { initial: WatermarkState; locale: 'en' | 'fr'; maxLogoBytes: number; canApply?: boolean }) {
+  const c = watermarkCopy[locale];
+  const validation = useFormValidation();
+  const [saved, setSaved] = useState(initial !== null);
+  const [position, setPosition] = useState<WatermarkOptions['position']>(initial?.position ?? 'southeast');
+  const [opacity, setOpacity] = useState(String(initial?.opacity ?? 0.5));
+  const [scale, setScale] = useState(String(initial?.scale ?? 0.2));
+  const [imageId, setImageId] = useState('');
+  const [message, setMessage] = useState(''); const [failed, setFailed] = useState(false);
+  const [busy, setBusy] = useState(false); const lock = useRef(false);
+  const [result, setResult] = useState<{ reference: string; url: string } | null>(null);
+  const logo = useRef<HTMLInputElement>(null); const source = useRef<HTMLInputElement>(null); const feedback = useRef<HTMLParagraphElement>(null);
+  const [confirm, dialog] = useConfirm({ title: c.confirm, cancel: c.cancel, confirm: c.continue, danger: false });
+  async function post(input: unknown) {
+    const response = await fetch('/settings/watermark/operations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(input) });
+    const data = await response.json(); if (!response.ok || data.ok !== true) throw new Error(); return data;
+  }
+  async function change(action: 'save' | 'remove' | 'apply') {
+    if (lock.current) return;
+    lock.current = true;
+    setMessage(''); setFailed(false);
+    try {
+      const options = watermarkOptions.safeParse({ position, opacity: opacity.trim() ? Number(opacity) : NaN, scale: scale.trim() ? Number(scale) : NaN });
+      const file = logo.current?.files?.[0];
+      if (action === 'save' && (!options.success || !saved && !file || file && (file.size > maxLogoBytes || !['image/png', 'image/jpeg'].includes(file.type)))) { setFailed(true); setMessage(c.validation); return; }
+      const image = source.current?.files?.[0];
+      if (action === 'apply' && (!saved || !image && !/^[0-9a-f-]{36}$/i.test(imageId))) { setFailed(true); setMessage(c.validation); return; }
+      const confirmation = action === 'save' ? 'SAVE WATERMARK' : action === 'remove' ? 'REMOVE WATERMARK' : 'APPLY WATERMARK';
+      let chosenId = imageId;
+      let uploaded = false;
+      await confirm(action === 'save' ? c.saveQuestion : action === 'remove' ? c.removeQuestion : c.applyQuestion, {
+        exactConfirmation: confirmation, confirmationLabel: c.confirm, pendingLabel: c.busy, failureLabel: c.failure,
+        onConfirm: async () => {
+          setBusy(true);
+          try {
+            if (action === 'save' && options.success) {
+              const logoBase64 = file ? await new Promise<string>((resolve, reject) => {
+                const reader = new FileReader(); reader.onerror = reject;
+                reader.onload = () => resolve(String(reader.result).split(',')[1]!); reader.readAsDataURL(file);
+              }) : undefined;
+              await post({ action, ...options.data, logoBase64, confirmation: 'SAVE WATERMARK' });
+              setSaved(true); if (logo.current) logo.current.value = ''; setMessage(c.success);
+            } else if (action === 'remove') {
+              await post({ action, confirmation: 'REMOVE WATERMARK' }); setSaved(false); setMessage(c.removed);
+            } else {
+              setResult(null);
+              if (image && !uploaded) {
+                const body = new FormData(); body.set('imageFile', image);
+                const upload = await fetch('/api/media', { method: 'POST', body });
+                const stored = await upload.json(); if (!upload.ok || !stored.id) throw new Error();
+                chosenId = stored.id; uploaded = true; setImageId(chosenId); if (source.current) source.current.value = '';
+              }
+              const receipt = await post({ action: 'apply', imageId: chosenId, confirmation: 'APPLY WATERMARK' });
+              if (!receipt.image?.reference || !receipt.image?.url) throw new Error();
+              setResult(receipt.image); setMessage(c.result);
+            }
+            return null;
+          } catch { return c.failure; }
+          finally { setBusy(false); }
+        },
+      });
+    } catch { setFailed(true); setMessage(c.failure); }
+    finally { lock.current = false; setBusy(false); requestAnimationFrame(() => feedback.current?.focus()); }
+  }
+  return <div className={styles.stack} aria-busy={busy}>{dialog}
+    <p id="watermark-feedback" ref={feedback} tabIndex={-1} role={failed ? 'alert' : 'status'}>{busy ? c.busy : message}</p>
+    <p>{saved ? c.saved : c.empty}</p>
+    <form noValidate className={styles.stack} onSubmit={event => {
+      event.preventDefault();
+      const errors: Record<string, string> = {};
+      const file = logo.current?.files?.[0];
+      if (!saved && !file || file && (file.size > maxLogoBytes || !['image/png', 'image/jpeg'].includes(file.type))) errors.logo = c.validation;
+      if (!opacity.trim() || !Number.isFinite(Number(opacity)) || Number(opacity) < 0 || Number(opacity) > 1) errors.opacity = c.validation;
+      if (!scale.trim() || !Number.isFinite(Number(scale)) || Number(scale) < 0.01 || Number(scale) > 1) errors.scale = c.validation;
+      if (validation.validate(event.currentTarget, errors)) void change('save');
+    }}>
+      <label className="ui-field">{c.logo}<input className="ui-input" name="logo" {...validation.fieldProps('logo')} ref={logo} type="file" accept="image/png,image/jpeg" disabled={busy} /><FieldError {...validation.errorProps('logo')} /></label>
+      <label className="ui-field">{c.position}<select className="ui-input" value={position} disabled={busy} onChange={event => setPosition(event.target.value as WatermarkOptions['position'])}>{Object.entries(c.positions).map(([key, label]) => <option value={key} key={key}>{label}</option>)}</select></label>
+      <label className="ui-field">{c.opacity}<input className="ui-input" name="opacity" {...validation.fieldProps('opacity')} type="number" min="0" max="1" step="0.01" required value={opacity} disabled={busy} onChange={event => setOpacity(event.target.value)} /><FieldError {...validation.errorProps('opacity')} /></label>
+      <label className="ui-field">{c.scale}<input className="ui-input" name="scale" {...validation.fieldProps('scale', 'watermark-scale-hint')} type="number" min="0.01" max="1" step="0.01" required value={scale} disabled={busy} onChange={event => setScale(event.target.value)} /><FieldError {...validation.errorProps('scale')} /></label>
+      <p id="watermark-scale-hint">{c.scaleHint}</p>
+      <div className={styles.actions}><Button type="submit" variant="primary" disabled={busy}>{c.save}</Button>{saved && <Button variant="danger" disabled={busy} onClick={() => void change('remove')}>{c.remove}</Button>}</div>
+    </form>
+    {saved && canApply && <form noValidate className={styles.stack} onSubmit={event => {
+      event.preventDefault();
+      const errors: Record<string, string> = source.current?.files?.[0] || /^[0-9a-f-]{36}$/i.test(imageId) ? {} : { imageId: c.validation };
+      if (validation.validate(event.currentTarget, errors)) void change('apply');
+    }}>
+      <h2>{c.apply}</h2><p>{c.choose}</p>
+      <label className="ui-field">{c.source}<input className="ui-input" ref={source} type="file" accept="image/png,image/jpeg" disabled={busy} /></label>
+      <label className="ui-field">{c.imageId}<input className="ui-input" name="imageId" {...validation.fieldProps('imageId')} value={imageId} disabled={busy} onChange={event => setImageId(event.target.value)} /><FieldError {...validation.errorProps('imageId')} /></label>
+      <Button type="submit" disabled={busy}>{c.apply}</Button>
+    </form>}
+    {result && <section><h2>{c.result}</h2><img className={styles.preview} src={result.url} alt={c.result} /><label className="ui-field">{c.reference}<input className="ui-input" readOnly value={result.reference} /></label><a href="/publishing/media">{c.result}</a></section>}
+  </div>;
+}
