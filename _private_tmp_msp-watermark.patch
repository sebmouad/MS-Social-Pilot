+import { headers } from 'next/headers';
+import { PageFrame } from '@/server/PageFrame';
+import { requireViewer } from '@/server/context';
+import { runtimeConfig } from '@/server/config/store';
+import { canUseFeature } from '@/server/entitlements';
+import { canAccessFeature } from '@/server/permissions';
+import { SettingsPage, SettingsPanel } from '@/modules/settings/ui/_components';
+import { readWatermark } from './service';
+import { watermarkCopy } from './copy';
+import { WatermarkManager } from './WatermarkManager';
+import type { WatermarkState } from './contracts';
+
+export default async function WatermarkScreen() {
+  const viewer = await requireViewer({ feature: 'settings/workspace' });
+  const locale = /^\s*fr\b/i.test((await headers()).get('accept-language') ?? '') ? 'fr' : 'en';
+  const c = watermarkCopy[locale];
+  let initial: WatermarkState = null; let available = true;
+  try { initial = await readWatermark({ userId: viewer.user.id, workspaceId: viewer.workspaceId }); } catch { available = false; }
+  return <PageFrame module="settings"><SettingsPage active="settings/workspace" title={c.title} description={c.description}>
+    <a href="/settings/workspace">{c.back}</a>
+    <SettingsPanel title={c.title}>{available ? <WatermarkManager initial={initial} locale={locale} maxLogoBytes={Number(await runtimeConfig('settings.watermarkMaxLogoBytes'))} canApply={canUseFeature(viewer.entitlements, 'publishing/posts') && canUseFeature(viewer.entitlements, 'publishing/media') && canAccessFeature(viewer.permissions, 'publishing/posts', 'write') && canAccessFeature(viewer.permissions, 'publishing/media', 'read')} /> : <p role="alert">{c.unavailable} <a href="/settings/watermark">{c.retry}</a></p>}</SettingsPanel>
+  </SettingsPage></PageFrame>;
+}
