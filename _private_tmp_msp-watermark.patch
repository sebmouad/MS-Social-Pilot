+import { describe, expect, it } from 'vitest';
+import sharp from 'sharp';
+import { watermarkImage } from '@/modules/publishing/server/media/watermark';
+
+const raster = (width: number, height: number, background: string) => sharp({ create: { width, height, channels: 4, background } }).png().toBuffer();
+const pixel = async (bytes: Buffer, left: number, top: number) => [...await sharp(bytes).extract({ left, top, width: 1, height: 1 }).removeAlpha().raw().toBuffer()];
+describe('shared image watermark pipeline', () => {
+  it.each([
+    ['northwest', 0, 0], ['northeast', 19, 0], ['center', 10, 5], ['southwest', 0, 9], ['southeast', 19, 9],
+  ] as const)('places a scaled logo at %s without changing input bytes', async (position, x, y) => {
+    const source = await raster(20, 10, 'white'); const original = Buffer.from(source);
+    const logo = await raster(4, 2, 'black'); const originalLogo = Buffer.from(logo);
+    const output = await watermarkImage(source, logo, { position, opacity: 1, scale: 0.2 }, 10000);
+    expect(await pixel(output, x, y)).toEqual([0, 0, 0]);
+    expect(source).toEqual(original); expect(logo).toEqual(originalLogo);
+    expect(await pixel(source, x, y)).toEqual([255, 255, 255]);
+    expect(await sharp(output).metadata()).toMatchObject({ format: 'png', width: 20, height: 10 });
+  });
+  it('multiplies existing logo transparency by opacity', async () => {
+    const source = await raster(10, 10, 'white'); const logo = await raster(2, 2, '#00000080');
+    const output = await watermarkImage(source, logo, { position: 'northwest', opacity: 0.5, scale: 0.2 }, 10000);
+    const p = await pixel(output, 0, 0); expect(p[0]).toBeGreaterThanOrEqual(190); expect(p[0]).toBeLessThanOrEqual(192);
+    expect(await pixel(output, 9, 9)).toEqual([255, 255, 255]);
+  });
+  it('supports explicit zero opacity and tiny source images', async () => {
+    const output = await watermarkImage(await raster(1, 1, 'white'), await raster(2, 2, 'black'), { position: 'center', opacity: 0, scale: 0.01 }, 10000);
+    expect(await pixel(output, 0, 0)).toEqual([255, 255, 255]);
+  });
+  it('orients JPEGs before scaling/compositing and strips metadata', async () => {
+    const source = await sharp(await raster(20, 10, 'white')).jpeg().withMetadata({ orientation: 6 }).toBuffer();
+    const output = await watermarkImage(source, await raster(4, 2, 'black'), { position: 'southeast', opacity: 1, scale: 0.5 }, 10000);
+    const metadata = await sharp(output).metadata(); expect(metadata).toMatchObject({ width: 10, height: 20 }); expect(metadata.orientation).toBeUndefined();
+  });
+  it('refuses corrupt input, animated/non-raster formats and oversized pixels', async () => {
+    const logo = await raster(2, 2, 'black');
+    const options = { position: 'center', opacity: 1, scale: 1 } as const;
+    for (const source of [Buffer.from('invalid'), await sharp(logo).gif().toBuffer(), Buffer.from('<svg width="2" height="2"></svg>')]) await expect(watermarkImage(source, logo, options, 10000)).rejects.toBeDefined();
+    await expect(watermarkImage(await raster(20, 20, 'white'), logo, options, 100)).rejects.toBeDefined();
+  });
+});
