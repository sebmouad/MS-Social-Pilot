+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import sharp from 'sharp';
+const m = vi.hoisted(() => ({
+  db: { user: { findUnique: vi.fn() }, membership: { findUnique: vi.fn() }, workspaceDataPurge: { findUnique: vi.fn() }, $queryRaw: vi.fn(), $executeRaw: vi.fn(), $transaction: vi.fn() },
+  config: vi.fn(), entitlements: vi.fn(), permissions: vi.fn(), use: vi.fn(), access: vi.fn(), read: vi.fn(), upload: vi.fn(), remove: vi.fn(),
+}));
+vi.mock('@/server/data', () => ({ prisma: m.db }));
+vi.mock('@/server/config/store', () => ({ runtimeConfig: m.config }));
+vi.mock('@/server/entitlements', () => ({ loadEntitlements: m.entitlements, canUseFeature: m.use }));
+vi.mock('@/server/permissions/loader', () => ({ loadPermissions: m.permissions }));
+vi.mock('@/server/permissions', () => ({ canAccessFeature: m.access }));
