+import { changeWatermark, readWatermark } from '@/modules/settings/watermark/service';
+const actor = { userId: 'u1', workspaceId: 'w1' };
+const id = '11111111-1111-4111-8111-111111111111';
+const options = { position: 'southeast', opacity: 0.5, scale: 0.2 } as const;
+const apply = { action: 'apply', imageId: id, confirmation: 'APPLY WATERMARK' };
