+  vi.resetAllMocks();
+  png = await sharp({ create: { width: 10, height: 10, channels: 4, background: 'white' } }).png().toBuffer();
+  m.db.user.findUnique.mockResolvedValue({ disabledAt: null }); m.db.membership.findUnique.mockResolvedValue({ role: 'owner' });
+  m.entitlements.mockResolvedValue({ workspaceId: 'w1' }); m.permissions.mockResolvedValue({ pageScope: { all: true } }); m.use.mockReturnValue(true); m.access.mockReturnValue(true);
+  m.config.mockImplementation(async key => key === 'settings.watermarkMaxLogoBytes' || key === 'publishing.maxImageUploadBytes' ? 2097152 : 10000);
+  m.db.workspaceDataPurge.findUnique.mockResolvedValue(null); m.db.$executeRaw.mockResolvedValue(1);
+  m.db.$transaction.mockImplementation(async callback => callback(m.db));
+  m.db.$queryRaw.mockImplementation(async (strings: TemplateStringsArray) => {
+    const sql = strings.join('?');
+    if (sql.includes('FROM workspaces')) return [{ suspendedAt: null }];
+    if (sql.includes('FROM memberships')) return [{ id: 'm1' }];
+    if (sql.includes('FROM rebuild_workspace_watermarks')) return [{ ...options, logo: png }];
+    return [];
+  });
+  m.read.mockResolvedValue({ bytes: png }); m.upload.mockResolvedValue({ id: 'new-id', mimeType: 'image/png', fileName: 'watermarked.png' }); m.remove.mockResolvedValue('deleted');
+});
+describe('watermark shared service', () => {
+  it('reads settings without returning logo bytes and returns null for missing configuration', async () => {
+    expect(await readWatermark(actor)).toEqual(options);
+    m.db.$queryRaw.mockResolvedValueOnce([{ suspendedAt: null }]).mockResolvedValueOnce([{ id: 'm1' }]).mockResolvedValueOnce([]);
+    expect(await readWatermark(actor)).toBeNull();
+  });
+  it('normalizes an uploaded logo, persists settings and audits without applying it', async () => {
+    await expect(changeWatermark(actor, { action: 'save', ...options, logoBase64: png.toString('base64'), confirmation: 'SAVE WATERMARK' })).resolves.toEqual({ ok: true });
+    expect(query(m.db.$executeRaw.mock.calls[0]!)).toContain('ON CONFLICT');
+    expect(m.db.$executeRaw.mock.calls[0]).toContain('w1');
+    expect(query(m.db.$executeRaw.mock.calls[1]!)).toContain('INSERT INTO activity_logs');
+    expect(m.upload).not.toHaveBeenCalled(); expect(m.read).not.toHaveBeenCalled();
+  });
+  it('retains the logo when changing options and supports zero opacity', async () => {
+    await changeWatermark(actor, { action: 'save', ...options, opacity: 0, confirmation: 'SAVE WATERMARK' });
+    expect(m.db.$executeRaw.mock.calls[0]).toContainEqual(png); expect(m.db.$executeRaw.mock.calls[0]).toContain(0);
+  });
+  it('makes a separate copy from an image in the current workspace', async () => {
+    expect(await changeWatermark(actor, apply)).toMatchObject({ ok: true, image: { id: 'new-id', reference: 'media:new-id', url: '/api/media/new-id' } });
+    expect(m.read).toHaveBeenCalledWith('w1', id);
+    expect(m.upload).toHaveBeenCalledWith(actor, expect.any(File));
+    expect(m.remove).not.toHaveBeenCalled();
+    expect(m.access).toHaveBeenCalledWith(expect.anything(), 'publishing/posts', 'write');
+    expect(m.access).toHaveBeenCalledWith(expect.anything(), 'publishing/media', 'read');
+  });
+  it('allows an unscoped editor to apply but never configure', async () => {
+    m.db.membership.findUnique.mockResolvedValue({ role: 'editor' });
+    await expect(changeWatermark(actor, apply)).resolves.toMatchObject({ ok: true });
+    await expect(changeWatermark(actor, { action: 'remove', confirmation: 'REMOVE WATERMARK' })).rejects.toMatchObject({ code: 'forbidden' });
+  });
+  it.each(['disabled', 'membership', 'workspace', 'scope', 'key', 'independentKey', 'entitlement', 'permission', 'suspended', 'purging', 'recheck'])('refuses %s before reading an image or changing data', async reason => {
+    if (reason === 'disabled') m.db.user.findUnique.mockResolvedValue({ disabledAt: new Date() });
+    if (reason === 'membership') m.db.membership.findUnique.mockResolvedValue(null);
+    if (reason === 'workspace') m.entitlements.mockResolvedValue({ workspaceId: 'other' });
+    if (reason === 'scope') m.permissions.mockResolvedValue({ pageScope: { all: false, ids: ['a'] } });
+    if (reason === 'entitlement') m.use.mockReturnValue(false);
+    if (reason === 'permission') m.access.mockReturnValue(false);
+    if (reason === 'suspended') m.db.$queryRaw.mockResolvedValue([{ suspendedAt: new Date() }]);
+    if (reason === 'purging') m.db.workspaceDataPurge.findUnique.mockResolvedValue({ status: 'running' });
+    if (reason === 'recheck') m.db.membership.findUnique.mockResolvedValueOnce({ role: 'owner' }).mockResolvedValueOnce(null);
+    await expect(changeWatermark(reason === 'key' ? { ...actor, allowedChannelIds: [] } : reason === 'independentKey' ? { ...actor, resourceRestricted: true } : actor, apply)).rejects.toBeDefined();
+    expect(m.read).not.toHaveBeenCalled(); expect(m.upload).not.toHaveBeenCalled(); expect(m.db.$executeRaw).not.toHaveBeenCalled();
+  });
+  it('validates exact confirmation, numeric bounds and strict fields before transaction', async () => {
+    for (const value of [{ ...apply, confirmation: 'wrong' }, { ...apply, workspaceId: 'other' }, { action: 'save', ...options, scale: 0, confirmation: 'SAVE WATERMARK' }, { ...apply, imageId: '../../secret' }]) await expect(changeWatermark(actor, value)).rejects.toMatchObject({ code: 'invalid_request' });
+    expect(m.db.$transaction).not.toHaveBeenCalled();
+  });
+  it('rejects invalid, non-raster and oversized logos', async () => {
+    for (const logoBase64 of ['!!!!', Buffer.from('<svg></svg>').toString('base64'), Buffer.alloc(2097153).toString('base64')]) await expect(changeWatermark(actor, { action: 'save', ...options, logoBase64, confirmation: 'SAVE WATERMARK' })).rejects.toMatchObject({ code: 'invalid_request' });
+    expect(m.db.$executeRaw).not.toHaveBeenCalled();
+  });
+  it('rejects missing configuration, cross-workspace/missing image and corrupt source safely', async () => {
+    m.read.mockRejectedValueOnce(new Error('private path'));
+    await expect(changeWatermark(actor, apply)).rejects.toMatchObject({ code: 'not_found' });
+    m.read.mockResolvedValueOnce({ bytes: Buffer.from('corrupt') });
+    await expect(changeWatermark(actor, apply)).rejects.toMatchObject({ code: 'invalid_request' });
+    m.db.$queryRaw.mockResolvedValueOnce([{ suspendedAt: null }]).mockResolvedValueOnce([{ id: 'm1' }]).mockResolvedValueOnce([]);
+    await expect(changeWatermark(actor, apply)).rejects.toMatchObject({ code: 'not_found' });
+    expect(m.upload).not.toHaveBeenCalled();
+  });
+  it('removes only current workspace settings and keeps all media', async () => {
