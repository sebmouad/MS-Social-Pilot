// Compatibility view for the fresh app. This schema maps selected legacy
// tables and columns; some services write through these mappings. It is not
// a migration schema and must not be pushed to the existing database.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  owner
  admin
  editor
  contributor
  viewer
  client
}

enum TargetType {
  page
  group
  instagram
  bluesky
  mastodon
  linkedin
  threads
  x
  pinterest
  telegram
  youtube
  tiktok
}

enum PostStatus {
  draft
  pending_approval
  rejected
  scheduled
  publishing
  published
  partially_failed
  failed
  cancelled
}

enum PostTargetStatus {
  pending
  processing
  published
  scheduled_remote
  failed
  cancelled
  skipped
}

model User {
  id           String       @id
  email        String       @unique
  name         String
  passwordHash String
  disabledAt   DateTime?
  isInstanceOwner Boolean @default(false)
  totpSecret String?
  totpPendingSecret String?
  totpEnabledAt DateTime?
  totpLastStep Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  passkeys     Passkey[]
  recoveryCodes RecoveryCode[]
  memberships  Membership[]
  posts        Post[]
  sessions     Session[]
  mcpApiKeys   McpApiKey[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  pending   String?
  challenge String?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Passkey {
  id           String   @id
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String[]
  name         String
  lastUsedAt   DateTime?
  createdAt    DateTime
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("passkeys")
}

model RecoveryCode {
  id        String    @id
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("recovery_codes")
}

model AppSetting {
  key       String   @id
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime

  @@map("app_settings")
}

model Workspace {
  id             String          @id
  name           String
  slug           String          @unique
  timezone       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  memberships    Membership[]
  targets        Target[]
  posts          Post[]
  socialAccounts SocialAccount[]
  adAccounts     AdAccount[]
  instagramAccounts InstagramAccount[]
  mcpApiKeys     McpApiKey[]
  dataPurge      WorkspaceDataPurge?

  inboxDeletions RebuildInboxDeletion[]
  postDeletions  RebuildPostDeletion[]

  @@map("workspaces")
}

model WorkspaceDataPurge {
  workspaceId   String   @id
  status        String   @default("requested")
  requestedById String
  apiKeyId      String?
  mediaRoot     String
  counts        Json?
  error         String?
  requestedAt   DateTime @default(now())
  dbDeletedAt   DateTime?
  completedAt   DateTime?
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status, updatedAt])
  @@map("workspace_data_purges")
}

model McpApiKey {
  id          String    @id
  workspaceId String
  createdById String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  readFeatures String[] @default([])
  writeFeatures String[] @default([])
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([expiresAt])
  @@map("mcp_api_keys")
}

model Membership {
  id          String        @id
  userId      String
  workspaceId String
  role        WorkspaceRole
  user        User          @relation(fields: [userId], references: [id])
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model SocialAccount {
  id             String      @id
  workspaceId    String
  provider       String
  providerUserId String
  name           String
  pictureUrl     String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String @default("")
  invalidatedAt  DateTime?
  invalidReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  workspace      Workspace   @relation(fields: [workspaceId], references: [id])
  targets        Target[]
  adAccounts     AdAccount[]

  @@unique([workspaceId, provider, providerUserId])
  @@index([workspaceId])
  @@map("social_accounts")
}

model Target {
  id              String         @id
  workspaceId     String
  socialAccountId String?
  type            TargetType
  providerId      String
  name            String
  pictureUrl      String?
  accessToken     String?
  enabled         Boolean
  canPublish      Boolean
  followersCount Int?
  profileSyncedAt DateTime?
  createdAt       DateTime
  updatedAt       DateTime @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  postTargets     PostTarget[]
  insights        PageInsight[]
  conversations   Conversation[]

  @@unique([workspaceId, providerId])
  @@index([socialAccountId])
  @@map("targets")
}

/// Stored Page metrics captured by the legacy analytics sync.
model PageInsight {
  id        String   @id
  targetId  String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime
  target    Target   @relation(fields: [targetId], references: [id])

  @@unique([targetId, metric, period, endTime])
  @@index([targetId, metric, endTime])
  @@map("page_insights")
}

/// Read-only compatibility mapping to existing Instagram account snapshots.
model InstagramAccount {
  id                String   @id
  workspaceId       String
  socialAccountId   String?
  targetId          String?
  igUserId          String
  username          String
  name              String?
  profilePictureUrl String?
  followersCount    Int?
  followsCount      Int?
  mediaCount        Int?
  enabled           Boolean
  lastSyncedAt      DateTime?
  createdAt         DateTime
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
  insights          InstagramInsight[]
  media             InstagramMedia[]

  @@unique([workspaceId, igUserId])
  @@index([workspaceId])
  @@map("instagram_accounts")
}

/// Stored Instagram account metrics captured by the existing Meta sync.
model InstagramInsight {
  id        String   @id
  accountId String
  metric    String
  period    String
  endTime   DateTime
  value     Json
  numeric   Float?
  fetchedAt DateTime
  account   InstagramAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, metric, period, endTime])
  @@index([accountId, metric, endTime])
  @@map("instagram_insights")
}

/// Stored post-level Instagram metrics and media metadata.
model InstagramMedia {
  id               String   @id
  accountId        String
  remoteId         String
  caption          String?
  mediaType        String?
  mediaProductType String?
  mediaUrl         String?
  permalink        String?
  thumbnailUrl     String?
  timestamp        DateTime
  likeCount        Int?
  commentsCount    Int?
  insights         Json?
  insightsSyncedAt DateTime?
  fetchedAt        DateTime
  account          InstagramAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, remoteId])
  @@index([accountId, timestamp])
  @@map("instagram_media")
}

model Post {
  id          String       @id
  workspaceId String
  authorId    String
  message     String
  firstComment String?
  link        String?
  media       Json         @default("[]")
  status      PostStatus
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime
  updatedAt   DateTime
  workspace   Workspace    @relation(fields: [workspaceId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])
  targets     PostTarget[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@map("posts")
}

model PostTarget {
  id           String           @id
  postId       String
  targetId     String
  status       PostTargetStatus
  remotePostId String?
  remoteUrl    String?
  firstCommentId String?
  firstCommentAt DateTime?
  firstCommentError String?
  publishedAt  DateTime?
  updatedAt    DateTime         @updatedAt
  post         Post             @relation(fields: [postId], references: [id])
  target       Target           @relation(fields: [targetId], references: [id])
  comments     PostComment[]

  @@unique([postId, targetId])
  @@index([targetId])
  @@map("post_targets")
}

/// Inbox records mapped to the existing legacy tables; provider writes are performed by the server action layer.
model PostComment {
  id             String   @id
  postTargetId   String
  remoteId       String
  parentRemoteId String?
  message        String
  fromName       String?
  fromId         String?
  likeCount      Int      @default(0)
  replyCount     Int      @default(0)
  isHidden       Boolean  @default(false)
  createdTime    DateTime
  fetchedAt      DateTime @default(now())
  firstSeenAt    DateTime @default(now())
  resolvedAt     DateTime?
  assigneeId     String?
  sentById       String?
  sentiment      String?
  postTarget     PostTarget @relation(fields: [postTargetId], references: [id])

  @@unique([postTargetId, remoteId])
  @@index([postTargetId, createdTime])
  @@map("post_comments")
}

model Conversation {
  id           String   @id
  targetId     String
  remoteId     String
  snippet      String?
  unreadCount  Int      @default(0)
  messageCount Int      @default(0)
  participants Json?
  updatedTime  DateTime
  fetchedAt    DateTime @default(now())
  resolvedAt   DateTime?
  assigneeId   String?
  target       Target   @relation(fields: [targetId], references: [id])
  messages     ConversationMessage[]

  @@unique([targetId, remoteId])
  @@index([targetId, updatedTime])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id
  conversationId String
  remoteId       String
  fromName       String?
  fromId         String?
  message        String?
  createdTime    DateTime
  firstSeenAt    DateTime @default(now())
  sentById       String?
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, remoteId])
  @@index([conversationId, createdTime])
  @@map("conversation_messages")
}

model AdAccount {
  id              String         @id
  workspaceId     String
  socialAccountId String?
  actId           String
  name            String
  currency        String?
  accountStatus   Int?
  enabled         Boolean
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id])
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  insights        AdInsight[]

  @@unique([workspaceId, actId])
  @@index([workspaceId])
  @@map("ad_accounts")
}

/// Stored daily delivery metrics for an ad account, campaign, ad set or ad.
model AdInsight {
  id          String   @id
  adAccountId String
  level       String
  objectId    String
  objectName  String?
  date        DateTime
  spend       Float
  impressions Int
  clicks      Int
  reach       Int
  cpc         Float?
  cpm         Float?
  cpp         Float?
  ctr         Float?
  frequency   Float?
  actions     Json?
  fields      Json?
  fetchedAt   DateTime
  adAccount   AdAccount @relation(fields: [adAccountId], references: [id])

  @@unique([adAccountId, level, objectId, date])
  @@index([adAccountId, date])
  @@map("ad_insights")
}

/// Atomic cross-process lock for one scheduled rebuild job.
model RebuildJobLease {
  name           String   @id
  owner          String
  token          String
  leaseExpiresAt DateTime
  updatedAt      DateTime @default(now())

  @@index([leaseExpiresAt])
  @@map("rebuild_job_leases")
}

/// Append-only operational history for Root job health and incident review.
model RebuildSyncRun {
  id         String    @id
  job        String
  owner      String
  startedAt  DateTime
  finishedAt DateTime?
  outcome    String
  attempts   Int       @default(0)
  summary    String?
  error      String?

  @@index([job, startedAt])
  @@index([finishedAt])
  @@map("rebuild_sync_runs")
}

/// Durable Inbox deletion recovery and content-free tombstones.
model RebuildInboxDeletion {
  id                  String    @id
  workspaceId         String
  targetId            String
  provider            String
  remoteId            String
  localItemId         String
  localAliases        String[]  @default([])
  suppressedRemoteIds String[]  @default([])
  actorId             String
  state               String
  reason              String?
  createdAt           DateTime  @default(now()) @db.Timestamp(3)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamp(3)
  remoteConfirmedAt   DateTime? @db.Timestamp(3)
  completedAt         DateTime? @db.Timestamp(3)
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, targetId, remoteId])
  @@index([workspaceId, targetId, updatedAt])
  @@map("rebuild_inbox_deletions")
}

/// Durable, content-free recovery journal and tombstones for remote post deletion.
model RebuildPostDeletion {
  id                 String    @id
  workspaceId        String
  targetId           String
  provider           String
  remoteId           String
  actorId            String
  localPostIds       String[]  @default([])
  localPostTargetIds String[]  @default([])
  state              String
  reason             String?
  createdAt          DateTime  @default(now()) @db.Timestamp(3)
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamp(3)
  remoteConfirmedAt  DateTime? @db.Timestamp(3)
  completedAt        DateTime? @db.Timestamp(3)
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, targetId, updatedAt])
  @@index([localPostIds], type: Gin)
  @@map("rebuild_post_deletions")
}
