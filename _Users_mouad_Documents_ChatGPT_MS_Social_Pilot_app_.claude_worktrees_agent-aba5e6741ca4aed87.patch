+-- Versioned workspace operations settings (rebuild). Additive only.
+--
+-- Most operations settings already live in legacy columns and tables
+-- (workspaces.requiresApproval / undoSendSeconds / utm* / audience* / aiBrandVoice,
+-- targets.brandVoice / audience*, queue_slots, moderation_rules, moderation_actions).
+-- This table adds what they lack: a per-section version for stale-write
+-- rejection, who/when last saved, and the values that have no legacy column
+-- (posting-hours window, minimum spacing between posts to one channel).
+CREATE TABLE "workspace_setting_sections" (
+  "workspaceId" TEXT NOT NULL,
+  "section" TEXT NOT NULL,
+  "version" INTEGER NOT NULL DEFAULT 1,
+  "values" JSONB NOT NULL DEFAULT '{}',
+  "updatedById" TEXT,
+  "updatedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  CONSTRAINT "workspace_setting_sections_pkey" PRIMARY KEY ("workspaceId", "section"),
+  CONSTRAINT "workspace_setting_sections_section_check" CHECK ("section" IN ('publishing', 'links', 'audience', 'voice', 'moderation')),
+  CONSTRAINT "workspace_setting_sections_version_check" CHECK ("version" >= 1)
+);
+
+CREATE INDEX "workspace_setting_sections_updatedById_idx" ON "workspace_setting_sections"("updatedById");
+
+ALTER TABLE "workspace_setting_sections" ADD CONSTRAINT "workspace_setting_sections_workspaceId_fkey"
+  FOREIGN KEY ("workspaceId") REFERENCES "workspaces"("id") ON DELETE CASCADE ON UPDATE CASCADE;
+ALTER TABLE "workspace_setting_sections" ADD CONSTRAINT "workspace_setting_sections_updatedById_fkey"
+  FOREIGN KEY ("updatedById") REFERENCES "users"("id") ON DELETE SET NULL ON UPDATE CASCADE;
+
+-- Same write gate as every other workspace-owned table while a data erasure runs
+-- (the function exists once 20261024100000_workspace_data_purges is applied).
+DO $$
+BEGIN
+  IF to_regproc('rebuild_reject_purging_workspace_write()') IS NOT NULL THEN
+    EXECUTE 'CREATE TRIGGER rebuild_workspace_purge_write_gate BEFORE INSERT OR UPDATE ON public."workspace_setting_sections" FOR EACH ROW EXECUTE FUNCTION rebuild_reject_purging_workspace_write()';
+  END IF;
+END $$;
