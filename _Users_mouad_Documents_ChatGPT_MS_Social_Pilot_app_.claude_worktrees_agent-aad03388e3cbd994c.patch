+
+export type LegendItem = { id: string; label: string; slot: number; active: boolean; detail?: string; reference?: boolean };
+
+/** Toggle buttons that double as the chart key: the swatch repeats the line's dash pattern and marker. */
+export function ChartLegend({ items, onToggle, label }: { items: LegendItem[]; onToggle?: (id: string) => void; label: string }) {
+  return <ul className="ui-chart-legend" aria-label={label}>
+    {items.map(item => {
+      const style = seriesStyle(item.slot);
+      const swatch = <svg width="30" height="12" aria-hidden="true"><line x1="1" x2="29" y1="6" y2="6" stroke={item.reference ? "var(--ink-faint)" : style.color} strokeWidth="2.4" strokeDasharray={item.reference ? "3 3" : style.dash} />{!item.reference && <Marker shape={style.shape} x={15} y={6} color={style.color} size={3.6} />}</svg>;
+      return <li key={item.id}>{onToggle
+        ? <button type="button" className="ui-chart-legend__item" aria-pressed={item.active} onClick={() => onToggle(item.id)}>{swatch}<span>{item.label}</span>{item.detail && <small>{item.detail}</small>}</button>
+        : <span className="ui-chart-legend__item">{swatch}<span>{item.label}</span>{item.detail && <small>{item.detail}</small>}</span>}</li>;
+    })}
+  </ul>;
+}
+
+/** A small decorative trend line. The numbers beside it carry the meaning. */
+export function Sparkline({ values, slot = 0 }: { values: Array<number | null>; slot?: number }) {
+  const width = 120; const height = 32; const pad = 3;
+  const extent = extentOf([values], false);
+  const span = extent.max - extent.min || 1;
+  const x = (index: number) => pad + (values.length <= 1 ? (width - pad * 2) / 2 : (index / (values.length - 1)) * (width - pad * 2));
+  const y = (value: number) => height - pad - ((value - extent.min) / span) * (height - pad * 2);
+  const last = values.reduce<number>((found, value, index) => (value === null ? found : index), -1);
+  const style = seriesStyle(slot);
+  return <svg className="ui-sparkline" viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false">
+    <path d={linePath(values, x, y)} fill="none" stroke={style.color} strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" vectorEffect="non-scaling-stroke" />
+    {last >= 0 && <circle cx={x(last)} cy={y(values[last]!)} r="2.6" fill={style.color} />}
+  </svg>;
+}
