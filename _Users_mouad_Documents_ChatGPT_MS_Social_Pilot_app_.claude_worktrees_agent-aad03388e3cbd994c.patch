diff --git a/rebuild/src/app/analytics/AnalyticsNotes.tsx b/rebuild/src/app/analytics/AnalyticsNotes.tsx
new file mode 100644
index 00000000..07de858f
--- /dev/null
+++ b/rebuild/src/app/analytics/AnalyticsNotes.tsx
@@ -0,0 +1,41 @@
+import { formatDateTime, formatDay, formatNumber } from '@/lib/analytics/format';
+import type { AnalyticsOverview } from '@/lib/analytics/types';
+
+/** Breakdowns, retired measures and technical details. Raw stored names appear only inside the technical disclosure. */
+export function AnalyticsNotes({ overview }: { overview: AnalyticsOverview }) {
+  const technical = [
+    ...overview.series.map(item => ({ id: item.id, name: item.name, detail: item.technical })),
+    ...overview.breakdowns.map(item => ({ id: item.id, name: item.name, detail: item.technical })),
+  ];
+  return <>
+    {overview.breakdowns.length > 0 && <section className="panel" aria-labelledby="analytics-breakdowns">
+      <div className="analytics-panel-title"><div><h2 id="analytics-breakdowns">Breakdowns</h2><p className="small-note">Where audiences and activity come from, added across the selected channels.</p></div></div>
+      <div className="analytics-breakdowns">
+        {overview.breakdowns.map(item => <details className="analytics-breakdown" key={item.id}>
+          <summary><span>{item.name}</span><small>{item.rows.length} categories{item.coverage < item.available ? ` · data for ${item.coverage} of ${item.available} channels` : ''}</small></summary>
+          <p className="small-note">{item.definition}{item.asOf ? ` Latest data ${formatDay(item.asOf, true)}.` : ''}</p>
+          <div className="report-list">{item.rows.map(row => <div className="report-row" key={row.label}><span>{row.label}</span><strong>{formatNumber(row.value)}</strong></div>)}</div>
+        </details>)}
+      </div>
+    </section>}
+    {overview.retired.length > 0 && <section className="panel" aria-labelledby="analytics-retired">
+      <div className="analytics-panel-title"><div><h2 id="analytics-retired">No longer available</h2><p className="small-note">These measures were stored earlier but the platform has stopped providing them. They are not charted.</p></div></div>
+      <ul className="analytics-retired">
+        {overview.retired.map(item => <li key={item.id}>
+          <strong>{item.name}</strong><span className="badge">Unavailable</span>
+          <p>{item.source ?? 'The platform'} retired this measure on {formatDay(item.retiredOn, true)}.{item.replacedByName ? ` Use ${item.replacedByName} instead.` : ' There is no direct replacement.'} {item.definition}</p>
+        </li>)}
+      </ul>
+    </section>}
+    {technical.length > 0 && <details className="panel analytics-technical">
+      <summary>Technical details</summary>
+      <p className="small-note">For support and developers. Names are as stored; times are shown in UTC.</p>
+      <div className="report-list">
+        {technical.map(item => <div className="report-row" key={item.id}>
+          <span>{item.name}<small> {item.detail.source ?? 'Source unknown'} · {item.detail.period} period · {item.detail.points} stored values</small></span>
+          <strong><code>{item.detail.storedName}</code>{item.detail.lastDay ? ` · latest ${formatDay(item.detail.lastDay, true)}` : ''}{item.detail.lastSynced ? ` · synced ${formatDateTime(item.detail.lastSynced)}` : ''}</strong>
+        </div>)}
+      </div>
+    </details>}
+  </>;
+}
diff --git a/rebuild/src/app/analytics/AnalyticsOverview.tsx b/rebuild/src/app/analytics/AnalyticsOverview.tsx
new file mode 100644
index 00000000..70ba7d7c
--- /dev/null
+++ b/rebuild/src/app/analytics/AnalyticsOverview.tsx
@@ -0,0 +1,132 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { ChartLegend, DataTable, LineChart, Sparkline, type ChartLine, type TableColumn } from "@/components";
+import { describeChange, formatDay, formatTotal, formatValue } from "@/lib/analytics/format";
+import type { AnalyticsOverview as Overview, ChannelValues, OverviewSeries } from "@/lib/analytics/types";
+
+const MAX_CHARTED = 3;
+const DEFAULT_VISIBLE_CHANNELS = 6;
+
+function Segmented<T extends string>({ label, value, options, onChange }: { label: string; value: T; options: Array<{ value: T; label: string }>; onChange: (value: T) => void }) {
+  return <div className="ui-segmented" role="group" aria-label={label}>{options.map(option => <button type="button" key={option.value} aria-pressed={value === option.value} onClick={() => onChange(option.value)}>{option.label}</button>)}</div>;
+}
+
+function ChangeText({ series, periodLabel }: { series: OverviewSeries; periodLabel: string }) {
+  const change = describeChange(series.change);
+  const tone = series.change?.favourable === true ? "is-good" : series.change?.favourable === false ? "is-bad" : "";
+  return <p className={`analytics-kpi__change ${tone}`}>
+    {series.change && <span aria-hidden="true">{change.arrow} </span>}
+    <span>{change.text}</span>
+    <span className="ui-visually-hidden">. {change.words}</span>
+    {series.change && <small> vs {periodLabel}</small>}
+  </p>;
+}
+
+function KeyNumber({ series, slot, selected, onToggle, periodLabel }: { series: OverviewSeries; slot: number | null; selected: boolean; onToggle: () => void; periodLabel: string }) {
+  const partial = series.coverage < series.available;
+  return <li>
+    <button type="button" className="analytics-kpi" aria-pressed={selected} onClick={onToggle}>
+      <span className="analytics-kpi__name">{series.name}</span>
+      <span className="analytics-kpi__value">{formatTotal(series.total, series.format, series.upTo, { compact: true })}</span>
+      <ChangeText series={series} periodLabel={periodLabel} />
+      <Sparkline values={series.values} slot={slot ?? 5} />
+      <span className="analytics-kpi__definition">{series.definition}{series.upTo ? " People can be counted more than once, so this is a ceiling." : ""}{series.approximate ? " Estimated from daily figures." : ""}</span>
+      {partial && <span className="analytics-kpi__coverage">Data for {series.coverage} of {series.available} {series.entityLabel === "ad account" ? "ad accounts" : "channels"}</span>}
+      <span className="analytics-kpi__state">{selected ? "✓ Shown in chart" : "Show in chart"}</span>
+    </button>
+  </li>;
+}
+
+export function AnalyticsOverview({ overview }: { overview: Overview }) {
+  const { series, days, previousDays } = overview;
+  const featured = useMemo(() => { const head = series.filter(item => item.headline); return head.length ? head : series.slice(0, 6); }, [series]);
+  const others = useMemo(() => series.filter(item => !featured.includes(item)), [series, featured]);
+  const [selected, setSelected] = useState<string[]>(() => featured.slice(0, 1).map(item => item.id));
+  const [view, setView] = useState<"chart" | "table">("chart");
+  const [compareWithPrevious, setCompareWithPrevious] = useState(false);
+  const [showOthers, setShowOthers] = useState(false);
+  const [comparisonIndex, setComparisonIndex] = useState<number | null>(null);
+  const [comparisonView, setComparisonView] = useState<"lines" | "bars" | "table">("lines");
+  const [hidden, setHidden] = useState<Record<string, boolean | undefined>>({});
+
+  const byId = useMemo(() => new Map(series.map(item => [item.id, item])), [series]);
+  const periodLabel = `the previous ${days.length} ${days.length === 1 ? "day" : "days"}`;
+  if (!series.length) return null;
+
+  const toggle = (id: string) => setSelected(current => current.includes(id) ? (current.length > 1 ? current.filter(item => item !== id) : current) : [...current, id].slice(-MAX_CHARTED));
+  const charted = selected.map(id => byId.get(id)).filter((item): item is OverviewSeries => Boolean(item));
+  const sameScale = new Set(charted.map(item => `${item.format.unit}:${item.format.currency ?? ""}`)).size <= 1;
+  const single = charted.length === 1 ? charted[0]! : null;
+  const lines: ChartLine[] = charted.map((item, index) => ({ id: item.id, label: item.upTo ? `${item.name} (up to)` : item.name, values: item.values, slot: index }));
+  if (single && compareWithPrevious) lines.push({ id: "previous", label: "Previous period", values: single.previousValues, slot: 0, reference: true });
+  const formatLine = (value: number, id: string) => formatValue(value, id === "previous" ? single!.format : byId.get(id)!.format);
+
+  const comparable = series.filter(item => item.channels.length > 0);
+  const chosen = comparisonIndex === null ? undefined : comparable[comparisonIndex];
+  const comparison = chosen ?? comparable.find(item => selected.includes(item.id)) ?? comparable[0];
+  const channelOrder = comparison ? comparison.channels : [];
+  const isVisible = (channel: ChannelValues, index: number) => hidden[`${comparison!.id}:${channel.id}`] ?? index < DEFAULT_VISIBLE_CHANNELS;
+  const channelLines: ChartLine[] = comparison ? channelOrder.flatMap((channel, index) => isVisible(channel, index) ? [{ id: channel.id, label: channel.name, values: channel.values, slot: index }] : []) : [];
+
+  const tableColumns: Array<TableColumn<number>> = [
+    { key: "day", label: "Date", render: index => formatDay(days[index]!, true) },
+    ...charted.map<TableColumn<number>>(item => ({ key: item.id, label: item.name, align: "end", render: index => formatValue(item.values[index], item.format) })),
+    ...(single && compareWithPrevious ? [{ key: "previous", label: `Previous period (${formatDay(previousDays[0]!)} – ${formatDay(previousDays.at(-1)!)})`, align: "end" as const, render: (index: number) => formatValue(single.previousValues[index], single.format) }] : []),
+  ];
+
+  const channelColumns: Array<TableColumn<ChannelValues>> = comparison ? [
+    { key: "name", label: comparison.entityLabel === "ad account" ? "Ad account" : "Channel", render: row => row.name },
+    { key: "total", label: comparison.upTo ? "Up to" : "Total", align: "end", render: row => formatValue(row.total, comparison.format) },
+    { key: "previous", label: "Previous period", align: "end", render: row => formatValue(row.previousTotal, comparison.format) },
+    { key: "change", label: "Change", align: "end", render: row => row.total !== null && row.previousTotal ? `${row.total >= row.previousTotal ? "+" : "−"}${Math.abs((row.total - row.previousTotal) / Math.abs(row.previousTotal) * 100).toLocaleString("en-US", { maximumFractionDigits: 1 })}%` : "—" },
+  ] : [];
+  const largest = Math.max(1, ...channelOrder.map(channel => Math.abs(channel.total ?? 0)));
+
+  return <>
+    <section className="panel" aria-labelledby="analytics-key-numbers">
+      <div className="analytics-panel-title"><div><h2 id="analytics-key-numbers">Key numbers</h2><p className="small-note">Compared with {periodLabel} ({formatDay(previousDays[0]!)} – {formatDay(previousDays.at(-1)!)}). Choose up to {MAX_CHARTED} to show in the chart.</p></div><span className="badge">{series.length} {series.length === 1 ? "measure" : "measures"}</span></div>
+      <ul className="analytics-kpis" aria-label="Key numbers">
+        {featured.map(item => <KeyNumber key={item.id} series={item} slot={selected.includes(item.id) ? selected.indexOf(item.id) : null} selected={selected.includes(item.id)} onToggle={() => toggle(item.id)} periodLabel={periodLabel} />)}
+      </ul>
+      {others.length > 0 && <div className="analytics-more">
+        <button type="button" className="analytics-more__toggle" aria-expanded={showOthers} onClick={() => setShowOthers(value => !value)}>{showOthers ? "Hide other measures" : `Show ${others.length} other ${others.length === 1 ? "measure" : "measures"}`}</button>
