+"use client";
+
+import { useEffect, useId, useMemo, useRef, useState, type KeyboardEvent, type PointerEvent as ReactPointerEvent } from "react";
+import { extentOf, labelIndexes, linePath, nearestIndex, niceScale } from "@/lib/analytics/chart-math";
+
+/** Colour, dash and marker shape for the nth series, so no meaning rests on colour alone. */
+const DASHES = ["", "7 4", "2 3", "10 3 2 3", "1 5", "14 4"] as const;
+const SHAPES = ["circle", "square", "triangle", "diamond", "cross", "circle-open"] as const;
+export const CHART_SLOTS = DASHES.length;
+
+export function seriesStyle(slot: number) {
+  const index = ((slot % CHART_SLOTS) + CHART_SLOTS) % CHART_SLOTS;
+  return { color: `var(--chart-${index + 1})`, dash: DASHES[index]!, shape: SHAPES[index]! };
+}
+
+type Shape = (typeof SHAPES)[number];
+
+export function Marker({ shape, x, y, color, size = 4.5 }: { shape: Shape; x: number; y: number; color: string; size?: number }) {
+  const common = { fill: color, stroke: "var(--surface)", strokeWidth: 1.5 };
+  switch (shape) {
+    case "square": return <rect x={x - size} y={y - size} width={size * 2} height={size * 2} {...common} />;
+    case "triangle": return <polygon points={`${x},${y - size - 1} ${x + size + 1},${y + size} ${x - size - 1},${y + size}`} {...common} />;
+    case "diamond": return <polygon points={`${x},${y - size - 1} ${x + size + 1},${y} ${x},${y + size + 1} ${x - size - 1},${y}`} {...common} />;
+    case "cross": return <path d={`M${x - size} ${y - size}L${x + size} ${y + size}M${x + size} ${y - size}L${x - size} ${y + size}`} stroke={color} strokeWidth={2.4} fill="none" />;
+    case "circle-open": return <circle cx={x} cy={y} r={size} fill="var(--surface)" stroke={color} strokeWidth={2.2} />;
+    default: return <circle cx={x} cy={y} r={size} {...common} />;
+  }
+}
+
+export type ChartLine = {
+  id: string;
+  label: string;
+  values: Array<number | null>;
+  /** Index into the colour, dash and marker set. */
+  slot: number;
+  /** A muted comparison line drawn behind the others (for example the previous period). */
+  reference?: boolean;
+};
+
+type LineChartProps = {
+  /** Calendar days (YYYY-MM-DD), one per value. */
+  days: string[];
+  lines: ChartLine[];
+  /** Writes a value for the tooltip and the text summary. */
+  formatValue: (value: number, lineId: string) => string;
+  /** Writes a short axis value. */
+  formatAxis: (value: number) => string;
+  formatDay: (day: string) => string;
+  /** Accessible name of the chart. */
+  label: string;
+  /** Scale every line to its own range (lines of different units); the axis then shows no numbers. */
+  separateScales?: boolean;
+  /** Start the axis at zero (default). Turn off for running totals such as followers, where zero hides the movement. */
+  includeZero?: boolean;
+  height?: number;
+};
+
+function useWidth() {
+  const ref = useRef<HTMLDivElement | null>(null);
+  const [width, setWidth] = useState(720);
+  useEffect(() => {
+    const node = ref.current;
+    if (!node) return;
+    const update = () => setWidth(Math.max(240, Math.round(node.getBoundingClientRect().width)));
+    update();
+    if (typeof ResizeObserver === "undefined") return;
+    const observer = new ResizeObserver(update);
+    observer.observe(node);
+    return () => observer.disconnect();
+  }, []);
+  return [ref, width] as const;
+}
+
+export function LineChart({ days, lines, formatValue, formatAxis, formatDay, label, separateScales = false, includeZero = true, height }: LineChartProps) {
+  const [hostRef, width] = useWidth();
+  const [active, setActive] = useState<number | null>(null);
+  const hintId = useId();
+  const compact = width < 480;
+  const chartHeight = height ?? (compact ? 220 : 300);
+  const margin = { top: 14, right: compact ? 12 : 20, bottom: 30, left: separateScales ? 12 : compact ? 44 : 56 };
+  const plotWidth = Math.max(40, width - margin.left - margin.right);
+  const plotHeight = chartHeight - margin.top - margin.bottom;
+
+  const scale = useMemo(() => {
+    const extent = extentOf(lines.map(line => line.values), includeZero);
+    return niceScale(extent.min, extent.max, compact ? 3 : 4);
+  }, [lines, compact, includeZero]);
+  const own = useMemo(() => new Map(lines.map(line => { const extent = extentOf([line.values], includeZero); return [line.id, niceScale(extent.min, extent.max, 4)] as const; })), [lines, includeZero]);
+
+  const x = (index: number) => margin.left + (days.length <= 1 ? plotWidth / 2 : (index / (days.length - 1)) * plotWidth);
+  const yFor = (line: ChartLine) => {
+    const s = separateScales ? own.get(line.id)! : scale;
+    return (value: number) => margin.top + plotHeight - ((value - s.min) / (s.max - s.min || 1)) * plotHeight;
+  };
+  const xLabels = labelIndexes(days.length, compact ? 4 : 7);
+  const showMarkers = days.length <= 45;
+
+  const summary = lines.filter(line => !line.reference).map(line => {
+    const points = line.values.flatMap((value, index) => value === null ? [] : [{ value, index }]);
+    if (!points.length) return `${line.label}: no values`;
+    const high = points.reduce((best, point) => (point.value > best.value ? point : best));
+    return `${line.label}: from ${formatValue(points[0]!.value, line.id)} on ${formatDay(days[points[0]!.index]!)} to ${formatValue(points.at(-1)!.value, line.id)} on ${formatDay(days[points.at(-1)!.index]!)}, highest ${formatValue(high.value, line.id)} on ${formatDay(days[high.index]!)}`;
+  }).join(". ");
+
+  const move = (event: ReactPointerEvent<SVGRectElement>) => {
+    const box = event.currentTarget.ownerSVGElement!.getBoundingClientRect();
+    setActive(nearestIndex(event.clientX - box.left, margin.left, plotWidth, days.length));
+  };
+  const onKey = (event: KeyboardEvent<HTMLDivElement>) => {
+    if (!days.length) return;
+    const last = days.length - 1;
+    const next = event.key === "ArrowRight" ? Math.min(last, (active ?? -1) + 1) : event.key === "ArrowLeft" ? Math.max(0, (active ?? last + 1) - 1) : event.key === "Home" ? 0 : event.key === "End" ? last : null;
+    if (event.key === "Escape") { setActive(null); return; }
+    if (next === null) return;
+    event.preventDefault();
+    setActive(next);
+  };
+
+  const readout = active === null ? "" : `${formatDay(days[active]!)}: ${lines.map(line => `${line.label} ${line.values[active] === null || line.values[active] === undefined ? "no value" : formatValue(line.values[active]!, line.id)}`).join(", ")}`;
+  const tooltipLeft = active === null ? 0 : Math.min(Math.max(x(active), 90), width - 90);
+
+  return <div className="ui-chart" ref={hostRef}>
+    <div className="ui-chart__frame" role="group" aria-label={label} aria-describedby={hintId} tabIndex={0} onKeyDown={onKey} onBlur={() => setActive(null)}>
+      <svg width={width} height={chartHeight} viewBox={`0 0 ${width} ${chartHeight}`} role="img" aria-label={`${label}. ${summary}`} onPointerLeave={() => setActive(null)}>
+        {(separateScales ? [0, 1, 2, 3, 4] : scale.ticks).map((tick, index, all) => {
+          const position = separateScales ? margin.top + plotHeight - (index / (all.length - 1)) * plotHeight : margin.top + plotHeight - ((tick - scale.min) / (scale.max - scale.min || 1)) * plotHeight;
+          return <g key={`${tick}-${index}`}>
+            <line className="ui-chart__grid" x1={margin.left} x2={margin.left + plotWidth} y1={position} y2={position} />
