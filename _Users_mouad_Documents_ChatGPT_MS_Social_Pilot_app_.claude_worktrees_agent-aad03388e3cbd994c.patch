+import { TopPosts } from '../src/app/analytics/TopPosts';
+
+describe('chart maths', () => {
+  it('chooses round axis bounds', () => {
+    expect(niceScale(0, 97, 4)).toMatchObject({ min: 0, max: 100, ticks: [0, 20, 40, 60, 80, 100] });
+    expect(niceScale(18793, 19662, 4).ticks[0]).toBeLessThanOrEqual(18793);
+    expect(niceScale(5, 5).max).toBeGreaterThan(5);
+    expect(niceScale(0, 0).ticks.length).toBeGreaterThan(1);
+  });
+  it('picks readable x labels and breaks lines at gaps', () => {
+    expect(labelIndexes(3, 7)).toEqual([0, 1, 2]);
+    expect(labelIndexes(30, 4)).toEqual([0, 10, 19, 29]);
+    expect(linePath([1, null, 3, 4], i => i * 10, v => v)).toBe('M0.0 1.0M20.0 3.0L30.0 4.0');
+    expect(nearestIndex(55, 50, 100, 11)).toBe(1);
+    expect(nearestIndex(-20, 50, 100, 11)).toBe(0);
+    expect(extentOf([[null, 4], [2]], false)).toEqual({ min: 2, max: 4 });
+    expect(extentOf([[3, 4]])).toEqual({ min: 0, max: 4 });
+  });
+});
+
+describe('value formatting', () => {
+  it('writes each unit the way a customer reads it', () => {
+    expect(formatValue(1234567, { unit: 'count', currency: null })).toBe('1,234,567');
+    expect(formatValue(1234567, { unit: 'count', currency: null }, { compact: true })).toBe('1.2M');
+    expect(formatValue(1.684, { unit: 'rate', style: 'percent', currency: null })).toBe('1.68%');
+    expect(formatValue(1.4, { unit: 'rate', style: 'multiple', currency: null })).toBe('1.4×');
+    expect(formatValue(12.5, { unit: 'currency', currency: 'EUR' })).toBe('€12.50');
+    expect(formatValue(12.5, { unit: 'currency', currency: null })).toBe('12.50');
+    expect(formatValue(5400, { unit: 'duration', currency: null })).toBe('1 h 30 min');
