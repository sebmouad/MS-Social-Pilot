+            {!line.reference && showMarkers && line.values.map((value, index) => value === null ? null : <Marker key={index} shape={style.shape} x={x(index)} y={toY(value)} color={style.color} size={days.length > 20 ? 2.6 : 3.6} />)}
+          </g>;
+        })}
+        {active !== null && <g>
+          <line className="ui-chart__guide" x1={x(active)} x2={x(active)} y1={margin.top} y2={margin.top + plotHeight} />
+          {lines.filter(line => !line.reference).map(line => { const value = line.values[active]; return value === null || value === undefined ? null : <Marker key={line.id} shape={seriesStyle(line.slot).shape} x={x(active)} y={yFor(line)(value)} color={seriesStyle(line.slot).color} size={5.5} />; })}
+        </g>}
