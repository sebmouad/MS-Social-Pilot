+        <strong>{formatDay(days[active]!)}</strong>
+        {lines.map(line => <span key={line.id}><svg width="22" height="10" aria-hidden="true"><line x1="1" x2="21" y1="5" y2="5" stroke={line.reference ? "var(--ink-faint)" : seriesStyle(line.slot).color} strokeWidth="2.4" strokeDasharray={line.reference ? "3 3" : seriesStyle(line.slot).dash} /></svg>{line.label}: <b>{line.values[active] === null || line.values[active] === undefined ? "—" : formatValue(line.values[active]!, line.id)}</b></span>)}
+      </div>}
