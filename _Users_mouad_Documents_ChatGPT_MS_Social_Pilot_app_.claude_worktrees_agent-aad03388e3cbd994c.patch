+import { prisma } from '@/server/data';
+import type { TopPost } from '@/lib/analytics/types';
+
+export type TopPostInput = {
+  id: string;
+  text: string | null;
+  channelName: string;
+  publishedAt: Date;
+  url: string | null;
+  comments: number | null;
+  likes: number | null;
+};
+
+const EXCERPT_LENGTH = 140;
+
+/** Only web links are offered to customers. */
+export function safeWebUrl(value: string | null | undefined): string | null {
+  if (!value) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === 'https:' || url.protocol === 'http:' ? url.toString() : null;
+  } catch { return null; }
+}
+
+export function postExcerpt(text: string | null | undefined): string {
+  const clean = (text ?? '').replace(/\s+/g, ' ').trim();
+  if (!clean) return 'Post without text';
+  return clean.length > EXCERPT_LENGTH ? `${clean.slice(0, EXCERPT_LENGTH - 1).trimEnd()}…` : clean;
+}
+
+/**
+ * Orders posts by the reactions stored for them (comments plus likes), newest
+ * first among equals, and keeps the best `limit`. Posts nobody reacted to stay
+ * in the list so that a quiet period still shows what was published.
+ */
+export function rankTopPosts(rows: TopPostInput[], limit: number): TopPost[] {
+  return rows
+    .map<TopPost>(row => ({
+      id: row.id,
+      excerpt: postExcerpt(row.text),
+      channelName: row.channelName,
+      publishedAt: row.publishedAt.toISOString(),
+      url: safeWebUrl(row.url),
+      comments: row.comments,
+      likes: row.likes,
+      interactions: (row.comments ?? 0) + (row.likes ?? 0),
+    }))
+    .sort((a, b) => b.interactions - a.interactions || b.publishedAt.localeCompare(a.publishedAt) || a.id.localeCompare(b.id))
+    .slice(0, Math.max(0, limit));
+}
+
+type Range = { from: Date; to: Date };
+type SelectedChannel = { id: string; type: string; name: string; providerId?: string };
+
+/** Published posts for the selected channels in the range, with the reactions stored for them. */
+export async function loadTopPosts(workspaceId: string, channels: SelectedChannel[], range: Range, limit = 50): Promise<TopPost[]> {
+  if (!channels.length) return [];
+  const names = new Map(channels.map(channel => [channel.id, channel.name]));
+  const instagram = channels.filter(channel => channel.type === 'instagram' && channel.providerId);
+  const [published, media] = await Promise.all([
+    prisma.postTarget.findMany({
+      where: {
+        targetId: { in: channels.map(channel => channel.id) }, status: 'published', target: { workspaceId }, post: { workspaceId },
+        OR: [{ publishedAt: { gte: range.from, lte: range.to } }, { publishedAt: null, post: { publishedAt: { gte: range.from, lte: range.to } } }],
+      },
+      orderBy: { publishedAt: 'desc' }, take: 500,
+      select: { id: true, targetId: true, remoteUrl: true, publishedAt: true, post: { select: { message: true, publishedAt: true } }, _count: { select: { comments: true } } },
+    }),
+    instagram.length ? prisma.instagramMedia.findMany({
+      where: { account: { workspaceId, enabled: true, igUserId: { in: instagram.map(channel => channel.providerId!) } }, timestamp: { gte: range.from, lte: range.to } },
+      orderBy: { timestamp: 'desc' }, take: 500,
+      select: { id: true, caption: true, permalink: true, timestamp: true, likeCount: true, commentsCount: true, account: { select: { igUserId: true } } },
+    }) : Promise.resolve([]),
+  ]);
+  const inputs: TopPostInput[] = [
+    ...published.flatMap(item => {
+      const publishedAt = item.publishedAt ?? item.post.publishedAt;
+      return publishedAt ? [{ id: `post:${item.id}`, text: item.post.message, channelName: names.get(item.targetId) ?? 'Channel', publishedAt, url: item.remoteUrl, comments: item._count.comments, likes: null }] : [];
+    }),
+    ...media.map(item => ({
+      id: `media:${item.id}`, text: item.caption, channelName: instagram.find(channel => channel.providerId === item.account.igUserId)?.name ?? 'Channel',
+      publishedAt: item.timestamp, url: item.permalink, comments: item.commentsCount, likes: item.likeCount,
+    })),
+  ];
+  return rankTopPosts(inputs, limit);
+}
