diff --git a/rebuild/src/app/analytics/TopPosts.tsx b/rebuild/src/app/analytics/TopPosts.tsx
new file mode 100644
index 00000000..58bd45c2
--- /dev/null
+++ b/rebuild/src/app/analytics/TopPosts.tsx
@@ -0,0 +1,41 @@
+"use client";
+
+import { useMemo, useState } from "react";
+import { DataTable, type TableColumn } from "@/components";
+import { formatDateTime, formatNumber } from "@/lib/analytics/format";
+import type { TopPost } from "@/lib/analytics/types";
+
+type SortKey = "interactions" | "comments" | "likes" | "publishedAt" | "channelName";
+const INITIAL_ROWS = 10;
+
+export function TopPosts({ posts }: { posts: TopPost[] }) {
+  const [sort, setSort] = useState<{ key: SortKey; direction: "ascending" | "descending" }>({ key: "interactions", direction: "descending" });
+  const [showAll, setShowAll] = useState(false);
+  const hasLikes = posts.some(post => post.likes !== null);
+
+  const sorted = useMemo(() => {
+    const factor = sort.direction === "ascending" ? 1 : -1;
+    return [...posts].sort((a, b) => {
+      const left = a[sort.key]; const right = b[sort.key];
+      const compared = typeof left === "string" || typeof right === "string" ? String(left ?? "").localeCompare(String(right ?? "")) : (left ?? -1) - (right ?? -1);
+      return compared * factor || a.id.localeCompare(b.id);
+    });
+  }, [posts, sort]);
+  const rows = showAll ? sorted : sorted.slice(0, INITIAL_ROWS);
+
+  const change = (key: string) => setSort(current => ({ key: key as SortKey, direction: current.key === key && current.direction === "descending" ? "ascending" : "descending" }));
+  const columns: Array<TableColumn<TopPost>> = [
+    { key: "excerpt", label: "Post", render: post => <span className="analytics-post"><span>{post.excerpt}</span>{post.url && <a className="text-link" href={post.url} target="_blank" rel="noopener noreferrer">View post<span className="ui-visually-hidden"> (opens in a new tab)</span></a>}</span> },
+    { key: "channelName", label: "Channel", sortable: true, render: post => post.channelName },
+    { key: "publishedAt", label: "Published", sortable: true, render: post => formatDateTime(post.publishedAt) },
+    { key: "comments", label: "Comments", sortable: true, align: "end", render: post => post.comments === null ? "—" : formatNumber(post.comments) },
+    ...(hasLikes ? [{ key: "likes", label: "Likes", sortable: true, align: "end" as const, render: (post: TopPost) => post.likes === null ? "—" : formatNumber(post.likes) }] : []),
+    { key: "interactions", label: "Interactions", sortable: true, align: "end", render: post => formatNumber(post.interactions) },
+  ];
+
+  return <section className="panel" aria-labelledby="analytics-top-posts">
+    <div className="analytics-panel-title"><div><h2 id="analytics-top-posts">Top posts</h2><p className="small-note">Posts published in this period on the selected channels. Interactions add up the comments{hasLikes ? " and likes" : ""} stored for each post.</p></div><span className="badge">{posts.length} {posts.length === 1 ? "post" : "posts"}</span></div>
+    <DataTable caption="Top posts for the selected channels and dates" columns={columns} rows={rows} rowKey={post => post.id} sort={{ key: sort.key, direction: sort.direction, onChange: change }} emptyMessage="No posts were published on the selected channels in this period." />
+    {posts.length > INITIAL_ROWS && <button type="button" className="analytics-more__toggle" aria-expanded={showAll} onClick={() => setShowAll(value => !value)}>{showAll ? "Show fewer posts" : `Show all ${posts.length} posts`}</button>}
+  </section>;
+}
