+import type { AnalyticsOverview, TopPost } from '@/lib/analytics/types';
+import { findMetric } from '@/platforms';
+import { buildAudience } from './aggregate';
+import { analyticsRange, loadAnalytics } from './data';
+import { buildOverview } from './overview';
+import { loadTopPosts } from './posts';
+import { addDays, dayStartInstant, previousRange, type DayRange } from './time';
+
+export type AnalyticsQuery = {
+  start?: string;
+  end?: string;
+  filter?: string;
+  channel?: string[];
+  adFilter?: string;
+  adAccount?: string[];
+};
+
+/** One loaded view of Analytics: the page and the CSV export both come from this, so they cannot disagree. */
+export async function loadAnalyticsView(options: { workspaceId: string; allowedTargetIds?: readonly string[]; timeZone: string; query: AnalyticsQuery; now?: Date }) {
+  const { workspaceId, allowedTargetIds, timeZone, query } = options;
+  const range = analyticsRange(query.start, query.end, options.now ?? new Date(), timeZone);
+  const days = range.days as DayRange;
+  const zone = range.timeZone ?? 'UTC';
+  // One query window covers the range and the equal-length period before it, with a day of slack on each side
+  // so date-only advertising days are never cut off by the time zone; the overview filters by calendar day.
+  const window = { from: new Date(dayStartInstant(previousRange(days).start, zone).getTime() - 86_400_000), to: new Date(range.to.getTime() + 86_400_000) };
+  const available = await loadAnalytics(workspaceId, [], window, allowedTargetIds);
+  const requested = new Set(query.channel ?? []);
+  const selectedIds = available.targets.filter(target => query.filter !== '1' || requested.has(target.id)).map(target => target.id);
+  const data = await loadAnalytics(workspaceId, selectedIds, window, allowedTargetIds, query.adFilter === '1' ? query.adAccount ?? [] : undefined);
+  const channels = data.selectedTargets.map(target => ({ id: target.id, type: target.type, name: target.name, providerId: target.providerId }));
+  const overview: AnalyticsOverview = buildOverview({
+    range: days, timeZone: zone, channels, pageRows: data.pageRows, instagramRows: data.instagramRows, adRows: data.adRows, adAccountCount: data.adAccountCount,
+  });
+  const audience = buildAudience(data.audienceRows, data.selectedInstagramAudience, channels);
+  const pageLikes = findMetric('channel', 'page_fans').definition.name;
+  const audienceEntries = audience.entries.map(entry => ({ ...entry, label: entry.metric === 'page_fans' ? pageLikes : 'Followers' }));
+  const topPosts: TopPost[] = await loadTopPosts(workspaceId, channels, range);
+  return { range, days, timeZone: zone, data, channels, overview, audience: { ...audience, entries: audienceEntries }, topPosts };
+}
+
+export type AnalyticsView = Awaited<ReturnType<typeof loadAnalyticsView>>;
+
+/** Quick ranges for the sidebar, ending today in the workspace time zone. */
+export function presetRange(daysBack: number, today: string): DayRange {
+  return { start: addDays(today, -(daysBack - 1)), end: today };
+}
